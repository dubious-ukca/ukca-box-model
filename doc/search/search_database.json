el ( 1 , 1 , 1 ), fmt_real ) call print_field ( '  bl_tke' , env % bl_tke ( 1 , 1 , 1 ), fmt_real ) call umPrint ( '' , src = routine_name ) ! Print offline chemistry namelist variables call umPrint ( 'Offline Chemistry Environment:' , src = routine_name ) call print_field ( '  h2o2_offline' , env % h2o2_offline ( 1 , 1 , 1 ), fmt_real ) call print_field ( '  ho2_offline' , env % ho2_offline ( 1 , 1 , 1 ), fmt_real ) call print_field ( '  no3_offline' , env % no3_offline ( 1 , 1 , 1 ), fmt_real ) call print_field ( '  o3_offline' , env % o3_offline ( 1 , 1 , 1 ), fmt_real ) call print_field ( '  oh_offline' , env % oh_offline ( 1 , 1 , 1 ), fmt_real ) call umPrint ( '' , src = routine_name ) endsubroutine print_box_environment subroutine print_field_real ( label , value , fmt ) !! Print a labelled real value, with missing data shown as NaN !> The label to print before the value character ( len =* ), intent ( in ) :: label !> The format to print the label and value with character ( len =* ), intent ( in ) :: fmt !> The value to print real , intent ( in ) :: value write ( umMessage , fmt ) label , real_or_nan ( value ) call umPrint ( umMessage , src = mod_name ) endsubroutine print_field_real subroutine print_field_int ( label , value , fmt ) !! Print a labelled integer value, with missing data shown as NaN !> The label to print before the value character ( len =* ), intent ( in ) :: label !> The format to print the label and value with character ( len =* ), intent ( in ) :: fmt !> The value to print integer , intent ( in ) :: value write ( umMessage , fmt ) label , int_or_nan ( value ) call umPrint ( umMessage , src = mod_name ) endsubroutine print_field_int subroutine print_field_logical ( label , value , fmt ) !! Print a labelled logical value !> The label to print before the value character ( len =* ), intent ( in ) :: label !> The format to print the label and value with character ( len =* ), intent ( in ) :: fmt !> The value to print logical , intent ( in ) :: value write ( umMessage , fmt ) label , value call umPrint ( umMessage , src = mod_name ) endsubroutine print_field_logical subroutine print_ukca_environment !! Print the environment fields UKCA requires, as held inside UKCA, and !! warn about any required field that has not been set. use ukca_api_mod , only : ukca_get_environment_varlist , & ukca_maxlen_fieldname , & ukca_maxlen_message , ukca_maxlen_procname use ukca_environment_fields_mod , only : environ_field_ptrs , & environ_field_info use box_err_codes_mod , only : box_errcode_env_count , box_errcode_env_type !> Names of the environment fields UKCA requires character ( len = ukca_maxlen_fieldname ), pointer :: varnames_ptrs (:) !> Error code for error reporting integer :: err_code !> Error message for error reporting character ( len = ukca_maxlen_message ) :: error_message !> Routine name for error reporting character ( len = ukca_maxlen_procname ) :: error_routine !> The label printed before each field's value character ( len = 256 ) :: print_label !> Loop index over the fields integer :: i !> Loop index over the last dimension of a 4D field integer :: j !> Column at which values start, after the field label integer , parameter :: label_width = 45 !> Formats for integer, real, scientific and logical values character ( len = 80 ) :: fmt_int , fmt_real , fmt_sci , fmt_log ! Create format strings with dynamic field widths fmt_int = '(A, T' // int_to_string ( label_width ) // ', F0.0)' fmt_real = '(A, T' // int_to_string ( label_width ) // ', G0.5)' fmt_sci = '(A, T' // int_to_string ( label_width ) // ', ES11.4)' fmt_log = '(A, T' // int_to_string ( label_width ) // ', L1)' call ukca_get_environment_varlist ( varnames_ptrs , err_code , & error_message , error_routine ) if ( err_code /= 0 ) then call ereport ( error_routine , err_code , error_message ) endif error_routine = mod_name // \":print_ukca_environment\" if ( size ( varnames_ptrs ) /= size ( environ_field_ptrs )) then write ( error_message , \"(A)\" ) \"Mismatch between number of environment \" // & \"variables and field pointers\" err_code = box_errcode_env_count call ereport ( error_routine , err_code , error_message ) endif if ( size ( varnames_ptrs ) /= size ( environ_field_info )) then write ( error_message , \"(A)\" ) \"Mismatch between number of environment \" // & \"variables and field info entries\" err_code = box_errcode_env_count call ereport ( error_routine , err_code , error_message ) endif call umPrint ( 'UKCA Environment:' , src = error_routine ) ! loop over the variable names, print their values do i = 1 , size ( varnames_ptrs ) select case ( environ_field_info ( i )% group ) ! scalar real case ( 1 ) if ( associated ( environ_field_ptrs ( i )% value_0d_real )) then print_label = \"  \" // trim ( varnames_ptrs ( i )) call print_field ( print_label , & environ_field_ptrs ( i )% value_0d_real , fmt_real ) else call report_unassociated_variable ( varnames_ptrs ( i )) endif ! 2D integer case ( 2 ) if ( associated ( environ_field_ptrs ( i )% value_2d_integer )) then print_label = \"  \" // trim ( varnames_ptrs ( i )) // \"(1,1)\" call print_field ( print_label , & environ_field_ptrs ( i )% value_2d_integer ( & 1 , 1 ), fmt_int ) else call report_unassociated_variable ( varnames_ptrs ( i )) endif ! 2D real case ( 3 , 12 , 14 ) if ( associated ( environ_field_ptrs ( i )% value_2d_real )) then print_label = \"  \" // trim ( varnames_ptrs ( i )) // \"(1,1)\" call print_field ( print_label , & environ_field_ptrs ( i )% value_2d_real ( 1 , 1 ), fmt_real ) else call report_unassociated_variable ( varnames_ptrs ( i )) endif ! 2D logical case ( 4 , 13 ) if ( associated ( environ_field_ptrs ( i )% value_2d_logical )) then print_label = \"  \" // trim ( varnames_ptrs ( i )) // \"(1,1)\" call print_field ( print_label , & environ_field_ptrs ( i )% value_2d_logical ( & 1 , 1 ), fmt_log ) else call report_unassociated_variable ( varnames_ptrs ( i )) endif ! 3D real case ( 5 , 6 , 7 , 8 , 9 , 10 ) if ( associated ( environ_field_ptrs ( i )% value_3d_real )) then print_label = \"  \" // trim ( varnames_ptrs ( i )) // \"(1,1,1)\" call print_field ( print_label , & environ_field_ptrs ( i )% value_3d_real ( & 1 , 1 , 1 ), fmt_real ) else call report_unassociated_variable ( varnames_ptrs ( i )) endif ! 1D real case ( 11 ) if ( associated ( environ_field_ptrs ( i )% value_1d_real )) then print_label = \"  \" // trim ( varnames_ptrs ( i )) // \"(1)\" call print_field ( print_label , & environ_field_ptrs ( i )% value_1d_real ( 1 ), fmt_real ) else call report_unassociated_variable ( varnames_ptrs ( i )) endif ! 4D real case ( 15 ) if ( associated ( environ_field_ptrs ( i )% value_4d_real )) then ! one line per value of the last dimension, e.g. per photolysis rate do j = 1 , size ( environ_field_ptrs ( i )% value_4d_real , 4 ) print_label = \"  \" // trim ( varnames_ptrs ( i )) // \"(1,1,1,\" // & int_to_string ( j ) // \")\" call print_field ( print_label , & environ_field_ptrs ( i )% value_4d_real ( 1 , 1 , 1 , j ), & fmt_real ) enddo else call report_unassociated_variable ( varnames_ptrs ( i )) endif case default write ( error_message , \"(2A)\" ) \"Unknown environment variable group \" // & \"for variable \" , trim ( varnames_ptrs ( i )) err_code = box_errcode_env_type call ereport ( error_routine , err_code , error_message ) endselect enddo contains subroutine report_unassociated_variable ( varname ) !! Print and warn that a required environment field is not set use box_err_codes_mod , only : box_errcode_env_not_assoc !> Name of the field that is not set character ( len =* ), intent ( in ) :: varname !> Warning message character ( len = ukca_maxlen_message ) :: msg write ( msg , \"(3A)\" ) trim ( varname ), \" is not associated\" , & \" yet is required for the box model run.\" err_code = - box_errcode_env_not_assoc call ereport ( error_routine , err_code , msg ) endsubroutine report_unassociated_variable endsubroutine print_ukca_environment subroutine set_box_environment ( env ) !! Set the internal ukca environment using the box environment data !! structure. The internal ukca environment will be what the ukca model !! uses when solving chemistry. use ukca_api_mod , only : ukca_set_environment use box_debug_mod , only : is_debug_level !> the box environment, containing both fields from the input namelist !> and derived fields. type ( box_environment_type ), intent ( in ) :: env interface set_field procedure set_field_0d_real procedure set_field_1d_real procedure set_field_2d_real procedure set_field_2d_int procedure set_field_2d_log procedure set_field_3d_real procedure set_field_4d_real endinterface set_field ! set scalar fields call set_field ( \"sin_declination\" , env % sin_declination ) call set_field ( \"equation_of_time\" , env % equation_of_time ) call set_field ( \"atmospheric_ch4\" , env % atmospheric_ch4 ) call set_field ( \"atmospheric_co2\" , env % atmospheric_co2 ) call set_field ( \"atmospheric_h2\" , env % atmospheric_h2 ) call set_field ( \"atmospheric_n2\" , env % atmospheric_n2 ) call set_field ( \"atmospheric_o2\" , env % atmospheric_o2 ) call set_field ( \"atmospheric_n2o\" , env % atmospheric_n2o ) call set_field ( \"atmospheric_cfc11\" , env % atmospheric_cfc11 ) call set_field ( \"atmospheric_cfc12\" , env % atmospheric_cfc12 ) call set_field ( \"atmospheric_cfc113\" , env % atmospheric_cfc113 ) call set_field ( \"atmospheric_hcfc22\" , env % atmospheric_hcfc22 ) call set_field ( \"atmospheric_hfc125\" , env % atmospheric_hfc125 ) call set_field ( \"atmospheric_hfc134a\" , env % atmospheric_hfc134a ) call set_field ( \"atmospheric_mebr\" , env % atmospheric_mebr ) call set_field ( \"atmospheric_mecl\" , env % atmospheric_mecl ) call set_field ( \"atmospheric_ch2br2\" , env % atmospheric_ch2br2 ) call set_field ( \"atmospheric_chbr3\" , env % atmospheric_chbr3 ) call set_field ( \"atmospheric_cfc114\" , env % atmospheric_cfc114 ) call set_field ( \"atmospheric_cfc115\" , env % atmospheric_cfc115 ) call set_field ( \"atmosp