cloud_lwp\" , env % conv_cloud_lwp ) call set_field ( \"tstar\" , env % tstar ) call set_field ( \"zbl\" , env % zbl ) call set_field ( \"rough_length\" , env % rough_length ) call set_field ( \"seaice_frac\" , env % seaice_frac ) call set_field ( \"frac_types\" , env % frac_types ) call set_field ( \"laift_lp\" , env % laift_lp ) call set_field ( \"canhtft_lp\" , env % canhtft_lp ) call set_field ( \"tstar_tile\" , env % tstar_tile ) call set_field ( \"z0tile_lp\" , env % z0tile_lp ) call set_field ( \"pstar\" , env % pstar ) call set_field ( \"surf_albedo\" , env % surf_albedo ) call set_field ( \"zhsc\" , env % zhsc ) call set_field ( \"u_scalar_10m\" , env % u_scalar_10m ) call set_field ( \"surf_hf\" , env % surf_hf ) call set_field ( \"u_s\" , env % u_s ) call set_field ( \"ch4_wetl_emiss\" , env % ch4_wetl_emiss ) call set_field ( \"dms_sea_conc\" , env % dms_sea_conc ) call set_field ( \"chloro_sea\" , env % chloro_sea ) call set_field ( \"dust_flux_div1\" , env % dust_flux_div1 ) call set_field ( \"dust_flux_div2\" , env % dust_flux_div2 ) call set_field ( \"dust_flux_div3\" , env % dust_flux_div3 ) call set_field ( \"dust_flux_div4\" , env % dust_flux_div4 ) call set_field ( \"dust_flux_div5\" , env % dust_flux_div5 ) call set_field ( \"dust_flux_div6\" , env % dust_flux_div6 ) call set_field ( \"surf_wetness\" , env % surf_wetness ) call set_field ( \"grid_surf_area\" , env % grid_surf_area ) call set_field ( \"ext_cg_flash\" , env % ext_cg_flash ) call set_field ( \"ext_ic_flash\" , env % ext_ic_flash ) ! set 2D integer fields call set_field ( \"kent\" , env % kent ) call set_field ( \"kent_dsc\" , env % kent_dsc ) call set_field ( \"conv_cloud_base\" , env % conv_cloud_base ) call set_field ( \"conv_cloud_top\" , env % conv_cloud_top ) call set_field ( \"lscat_zhang\" , env % lscat_zhang ) ! set 2D logical fields call set_field ( \"land_sea_mask\" , env % land_sea_mask ) call set_field ( \"l_tile_active\" , env % l_tile_active ) ! set 3D real fields call set_field ( \"u_rho_levels\" , env % u_rho_levels ) call set_field ( \"v_rho_levels\" , env % v_rho_levels ) call set_field ( \"geopH_on_theta_mlevs\" , env % geopH_on_theta_mlevs ) call set_field ( \"theta\" , env % theta ) call set_field ( \"q\" , env % q ) call set_field ( \"qcf\" , env % qcf ) call set_field ( \"conv_cloud_amount\" , env % conv_cloud_amount ) call set_field ( \"rho_r2\" , env % rho_r2 ) call set_field ( \"qcl\" , env % qcl ) call set_field ( \"exner_rho_levels\" , env % exner_rho_levels ) call set_field ( \"area_cloud_fraction\" , env % area_cloud_fraction ) call set_field ( \"cloud_frac\" , env % cloud_frac ) call set_field ( \"cloud_liq_frac\" , env % cloud_liq_frac ) call set_field ( \"exner_theta_levels\" , env % exner_theta_levels ) ! ! TODO - not sure what to do with fields that can be set via API ! call set_field(\"p_layer_boundaries\", env%p_layer_boundaries) call set_field ( \"p_theta_levels\" , env % p_theta_levels ) call set_field ( \"rhokh_rdz\" , env % rhokh_rdz ) call set_field ( \"dtrdz\" , env % dtrdz ) call set_field ( \"we_lim\" , env % we_lim ) call set_field ( \"t_frac\" , env % t_frac ) call set_field ( \"zrzi\" , env % zrzi ) call set_field ( \"we_lim_dsc\" , env % we_lim_dsc ) call set_field ( \"t_frac_dsc\" , env % t_frac_dsc ) call set_field ( \"zrzi_dsc\" , env % zrzi_dsc ) call set_field ( \"stcon\" , env % stcon ) call set_field ( \"ls_rain3d\" , env % ls_rain3d ) call set_field ( \"ls_snow3d\" , env % ls_snow3d ) call set_field ( \"autoconv\" , env % autoconv ) call set_field ( \"accretion\" , env % accretion ) call set_field ( \"pv_on_theta_mlevs\" , env % pv_on_theta_mlevs ) call set_field ( \"conv_rain3d\" , env % conv_rain3d ) call set_field ( \"conv_snow3d\" , env % conv_snow3d ) call set_field ( \"so4_sa_clim\" , env % so4_sa_clim ) call set_field ( \"so4_aitken\" , env % so4_aitken ) call set_field ( \"so4_accum\" , env % so4_accum ) call set_field ( \"soot_fresh\" , env % soot_fresh ) call set_field ( \"soot_aged\" , env % soot_aged ) call set_field ( \"ocff_fresh\" , env % ocff_fresh ) call set_field ( \"ocff_aged\" , env % ocff_aged ) call set_field ( \"biogenic\" , env % biogenic ) call set_field ( \"dust_div1\" , env % dust_div1 ) call set_field ( \"dust_div2\" , env % dust_div2 ) call set_field ( \"dust_div3\" , env % dust_div3 ) call set_field ( \"dust_div4\" , env % dust_div4 ) call set_field ( \"dust_div5\" , env % dust_div5 ) call set_field ( \"dust_div6\" , env % dust_div6 ) call set_field ( \"sea_salt_film\" , env % sea_salt_film ) call set_field ( \"sea_salt_jet\" , env % sea_salt_jet ) call set_field ( \"CO2\" , env % co2_interactive ) call set_field ( \"rim_cry\" , env % rim_cry ) call set_field ( \"rim_agg\" , env % rim_agg ) call set_field ( \"vertvel\" , env % vertvel ) call set_field ( \"bl_tke\" , env % bl_tke ) call set_field ( \"interf_z\" , env % interf_z ) call set_field ( \"grid_area_fullht\" , env % grid_area_fullht ) call set_field ( \"grid_volume\" , env % grid_volume ) call set_field ( \"grid_airmass\" , env % grid_airmass ) call set_field ( \"rel_humid_frac\" , env % rel_humid_frac ) call set_field ( \"rel_humid_frac_clr\" , env % rel_humid_frac_clr ) call set_field ( \"qsvp\" , env % qsvp ) call set_field ( \"H2O2\" , env % h2o2_offline ) call set_field ( \"HO2\" , env % ho2_offline ) call set_field ( \"NO3\" , env % no3_offline ) call set_field ( \"O3\" , env % o3_offline ) call set_field ( \"OH\" , env % oh_offline ) call set_field ( \"p_rho_levels\" , env % p_rho_levels ) ! set 4D real fields call set_field ( \"photol_rates\" , env % photol_rates ) contains subroutine set_field_0d_real ( field_name , field_value ) !! Set a real scalar field in the UKCA environment !> Name of the UKCA environment field character ( len =* ), intent ( in ) :: field_name !> Value to set the field to real , intent ( in ) :: field_value !> Error code returned by ukca_set_environment integer :: ecode !> Error message returned by ukca_set_environment character ( len = 256 ) :: errmsg ecode = 0 if ( is_debug_level ( 1 )) then call umPrint ( \"DEBUG: Setting \" // trim ( field_name ) // \" to \" // & real_to_string ( real_or_nan ( field_value )), & src = \"set_box_environment\" ) endif call ukca_set_environment ( field_name , field_value , ecode , & error_message = errmsg ) call handle_set_error ( field_name , ecode , errmsg ) endsubroutine set_field_0d_real subroutine set_field_1d_real ( field_name , field_value ) !! Set a 1D real field in the UKCA environment !> Name of the UKCA environment field character ( len =* ), intent ( in ) :: field_name !> Value to set the field to real , allocatable , intent ( in ) :: field_value (:) !> Error code returned by ukca_set_environment integer :: ecode !> Error message returned by ukca_set_environment character ( len = 256 ) :: errmsg ecode = 0 if ( is_debug_level ( 1 )) then call umPrint ( \"DEBUG: Setting \" // trim ( field_name ) // \" to \" // & real_to_string ( real_or_nan ( field_value ( 1 ))), & src = \"set_box_environment\" ) endif call ukca_set_environment ( field_name , field_value , ecode , & error_message = errmsg ) call handle_set_error ( field_name , ecode , errmsg ) endsubroutine set_field_1d_real subroutine set_field_2d_real ( field_name , field_value ) !! Set a 2D real field in the UKCA environment !> Name of the UKCA environment field character ( len =* ), intent ( in ) :: field_name !> Value to set the field to real , allocatable , intent ( in ) :: field_value (:, :) !> Error code returned by ukca_set_environment integer :: ecode !> Error message returned by ukca_set_environment character ( len = 256 ) :: errmsg ecode = 0 if ( is_debug_level ( 1 )) then call umPrint ( \"DEBUG: Setting \" // trim ( field_name ) // \" to \" // & real_to_string ( real_or_nan ( field_value ( 1 , 1 ))), & src = \"set_box_environment\" ) endif call ukca_set_environment ( field_name , field_value , ecode , & error_message = errmsg ) call handle_set_error ( field_name , ecode , errmsg ) endsubroutine set_field_2d_real subroutine set_field_2d_int ( field_name , field_value ) !! Set a 2D integer field in the UKCA environment !> Name of the UKCA environment field character ( len =* ), intent ( in ) :: field_name !> Value to set the field to integer , allocatable , intent ( in ) :: field_value (:, :) !> Error code returned by ukca_set_environment integer :: ecode !> Error message returned by ukca_set_environment character ( len = 256 ) :: errmsg ecode = 0 if ( is_debug_level ( 1 )) then call umPrint ( \"DEBUG: Setting \" // trim ( field_name ) // \" to \" // & real_to_string ( int_or_nan ( field_value ( 1 , 1 ))), & src = \"set_box_environment\" ) endif call ukca_set_environment ( field_name , field_value , ecode , & error_message = errmsg ) call handle_set_error ( field_name , ecode , errmsg ) endsubroutine set_field_2d_int subroutine set_field_2d_log ( field_name , field_value ) !! Set a 2D logical field in the UKCA environment !> Name of the UKCA environment field character ( len =* ), intent ( in ) :: field_name !> Value to set the field to logical , allocatable , intent ( in ) :: field_value (:, :) !> Error code returned by ukca_set_environment integer :: ecode !> Error message returned by ukca_set_environment character ( len = 256 ) :: errmsg ecode = 0 if ( is_debug_level ( 1 )) then call umPrint ( \"DEBUG: Setting \" // & trim ( field_name ) // \" to \" // & log_to_string ( field_value ( 1 , & 1 )), src = \"set_box_environment\" ) endif call ukca_set_environment ( field_name , field_value , ecode , & error_message = errmsg ) call handle_set_error ( field_name , ecode , errmsg ) endsubroutine set_field_2d_log subroutine set_field_3d_real ( field_name , field_value ) !! Set a 3D real field in the UKCA environment !> Name of the UKCA environment field character ( len =* ), intent ( in ) :: field_name !> Value to set the field to real , allocatable , intent ( in ) :: field_value (:, :, :) !> Error code returned by ukca_set_environment integer :: ecode !> Error message returned by ukca_set_environment character ( len = 256 ) :: errmsg ecode = 0 if ( is_debug_level ( 1 )) then call umPrint ( \"DEBUG: Setting \" // trim ( field_name ) // \" to \" // & real_to_string ( real_or_nan ( field_value ( 1 , 1 , 1 ))), & src = \"set_box_environment\" ) endif call ukca_set_environment ( field_name , field_value , ecode , & error_message = errmsg ) call handle_set_error ( field_name , ecode , errmsg ) endsubroutine set_field_3d_real subroutine set_field_4d_real ( field_name , field_value ) !! Set a 4D real field in the UKCA environment !> Name of the UKCA environment field character ( len =* ), intent ( in ) :: field_name !> Value to set the field to real , allocatable , intent ( in ) :: field_value (:, :, :, :) !> Error code returned by ukca_set_environment integer :: ecode !> Error message returned by ukca_set_environment character ( len = 256 ) :: errmsg ecode = 0 if ( is_debug_level ( 1 )) then call umPrint ( \"DEBUG: Setting \" // trim ( field_name ) // \" to \" // & real_to_string ( real_or_nan ( field_value ( 1 , 1 , 1 , 1 ))), & src = \"set_box_environment\" ) endif call ukca_set_environment ( field_name , field_value , ecode , & error_message = errmsg ) call handle_set_error ( field_name , ecode , errmsg ) endsubroutine set_field_4d_real subroutine handle_set_error ( field_name , ecode , errmsg ) !! Stop with an error if setting a UKCA environment field failed !> Name of the UKCA environment field character ( len =* ), intent ( in ) :: field_name !> Error code returned by ukca_set_environment integer , intent ( in ) :: ecode !> Error message returned by ukca_set_environment character ( len =* ), intent ( in ) :: errmsg !> Copy of ecode, as ereport may change its error code argument integer :: report_code !> Message for error reporting character ( len = ukca_maxlen_message ) :: err_msg if ( ecode /= 0 ) then report_code = ecode write ( err_msg , \"(4A)\" ) \"Error setting \" , trim ( field_name ), & \" in ukca environment: \" , trim ( errmsg ) call ereport ( 'set_box_environment' , report_code , err_msg ) endif endsubroutine handle_set_error endsubroutine set_box_environment subroutine derive_env_variables ( env ) !! Derive environment variables from the input box environment fields, and !! store the results in the same environment type. !! Example derived field: altitude is derived from the surface pressure and !! a theta level pressure, using the hypsometric equation. use box_const_mod , only : sclht , earth_radius , row_length , rows , & model_levels , earth_pref , kappa , & const_pi_over_180 , c_virtual , earth_r use box_err_codes_mod , only : box_errcode_non_phys_calc , & box_errcode_env_namelist use box_debug_mod , only : is_debug_level !> the box model environment from which fields will be derived and set in type ( box_environment_type ), intent ( inout ) :: env !> altitude real :: alt !> height of theta levels real , allocatable :: r_theta_levels (:, :, :) !> height of rho levels real , allocatable :: r_rho_levels (:, :, :) !> pressure at rho levels real , allocatable :: p_rho_levels (:, :, :) !> eta of theta levels real , allocatable :: eta_theta_levels (:) !> dimensionless_exner_function [CF] at theta levels {UM:00406} real , allocatable :: exner_theta_levels (:, :, :) !> dimensionless exner function at rho levels real , allocatable :: exner_rho_levels (:, :, :) !> air_potential_temperature [CF] (K) {UM:00004} real , allocatable :: theta (:, :, :) !> denomTv = ( 1 + ( Rv/Rd - 1 ) q ) T real :: theta_v !> density real , allocatable :: rho (:, :, :) !> density, r2 real , allocatable :: rho_r2 (:, :, :) !> surface area real , allocatable :: surf_area (:, :) !> dummy ratio for checking real :: ratio !> error reporting message character ( len = 256 ) :: err_msg !> error code integer :: err_code !> minimum debug level for printing messages integer , parameter :: minimum_debug = 1 ! allocate arrays of derived fields allocate ( r_theta_levels ( row_length , rows , 0 : model_levels )) allocate ( eta_theta_levels ( 0 : model_levels )) allocate ( r_rho_levels ( row_length , rows , 1 : model_levels )) allocate ( exner_theta_levels ( row_length , rows , model_levels )) ! UKCA expects exner_rho_levels on model_levels + 1 levels allocate ( exner_rho_levels ( row_length , rows , model_levels + 1 )) allocate ( theta ( row_length , rows , model_levels )) allocate ( rho ( row_length , rows , model_levels )) allocate ( rho_r2 ( row_length , rows , model_levels )) allocate ( surf_area ( row_length , rows )) allocate ( p_rho_levels ( row_length , rows , model_levels )) ! print out p_theta_levels and pstar for debugging if ( is_debug_level ( minimum_debug )) then call umPrint ( \"DEBUG: p_theta_levels(1,1,1): \" // & real_to_string ( env % p_theta_levels ( 1 , 1 , 1 )), & src = \"derive_env_variables\" ) call umPrint ( \"DEBUG: pstar(1,1): \" // & real_to_string ( env % pstar ( 1 , 1 )), src = \"derive_env_variables\" ) endif ! both pressures are needed, and if both were missing (rmdi) their ratio ! would be 1 and pass the check below if ( is_missing ( env % pstar ( 1 , 1 )) . or . & is_missing ( env % p_theta_levels ( 1 , 1 , 1 ))) then write ( err_msg , \"(A)\" ) \"pstar and p_theta_levels must both be set in \" // & \"the environment namelist, to derive the altitude and other fields.\" err_code = box_errcode_env_namelist call ereport ( 'derive_env_variables' , err_code , err_msg ) endif ratio = env % p_theta_levels ( 1 , 1 , 1 ) / env % pstar ( 1 , 1 ) if ( ratio <= 0. ) then write ( err_msg , \"(A)\" ) \"Surface pressure and a theta pressure has \" // & \"resulted in a non-positive ratio, which is non-physical.\" err_code = box_errcode_non_phys_calc call ereport ( 'derive_env_variables' , err_code , err_msg ) endif ! derive altitude alt = - sclht * log ( env % p_theta_levels ( 1 , 1 , 1 ) / env % pstar ( 1 , 1 )) if ( is_debug_level ( minimum_debug )) then call umPrint ( \"DEBUG: alt: \" // real_to_string ( alt ), & src = \"derive_env_variables\" ) endif r_theta_levels ( 1 , 1 , 1 ) = alt + earth_radius ! TODO - check if this is correct r_theta_levels ( 1 , 1 , 0 ) = earth_radius ! hack, for box model theta and rho level are the same r_rho_levels = r_theta_levels ( 1 , 1 , 1 ) p_rho_levels ( 1 , 1 , :) = env % p_theta_levels ( 1 , 1 , 1 ) ! add to env type env % r_rho_levels = r_rho_levels env % r_theta_levels = r_theta_levels env % p_rho_levels = p_rho_levels ! eta eta_theta_levels ( 0 ) = 0. eta_theta_levels ( 1 ) = 1. ! add eta levels to env env % eta_theta_levels = eta_theta_levels ! exner function exner_theta_levels ( 1 , 1 , 1 ) = ( env % p_theta_levels ( 1 , 1 , 1 ) / & earth_pref ) ** kappa exner_rho_levels = exner_theta_levels ( 1 , 1 , 1 ) env % exner_theta_levels = exner_theta_levels env % exner_rho_levels = exner_rho_levels ! Calculate theta from T, p and exner: theta ( 1 , 1 , 1 ) = env % t_theta_levels ( 1 , 1 , 1 ) / exner_theta_levels ( 1 , 1 , 1 ) if ( is_debug_level ( minimum_debug )) then call umPrint ( \"DEBUG: theta(1,1,1): \" // real_to_string ( theta ( 1 , 1 , 1 )), & src = \"derive_env_variables\" ) endif env % theta = theta ! density calc - see calc_rho in um theta_v = theta ( 1 , 1 , & 1 ) * ( 1.0 + c_virtual * & ( env % q ( 1 , 1 , 1 ) + env % qcl ( 1 , & 1 , 1 ) + env % qcf ( 1 , 1 , 1 ))) rho = p_rho_levels ( 1 , 1 , & 1 ) / ( earth_r * theta_v * exner_rho_levels ( 1 , 1 , 1 )) ! debug - print shape of rho and r_rho_levels if ( is_debug_level ( minimum_debug )) then call umPrint ( \"DEBUG: rho shape: \" // & int_to_string ( size ( rho , 1 )) // \", \" // & int_to_string ( size ( rho , 2 )) // \", \" // & int_to_string ( size ( rho , 3 )), src = \"derive_env_variables\" ) call umPrint ( \"DEBUG: r_rho_levels shape: \" // & int_to_string ( size ( r_rho_levels , 1 )) // \", \" // & int_to_string ( size ( r_rho_levels , 2 )) // \", \" // & int_to_string ( size ( r_rho_levels , 3 )), & src = \"derive_env_variables\" ) endif !rho_r2(1,1,:) = rho * r_rho_levels(1,1,:) * r_rho_levels(1,1,:) ! trig function of latitude env % true_latitude = env % latitude * const_pi_over_180 env % true_longitude = env % longitude * const_pi_over_180 env % sin_latitude = sin ( env % true_latitude ) env % cos_latitude = cos ( env % true_latitude ) ! BIT-FOR-BIT: the old (UM) box model computes SIN/COS (box_ukca_mod), ! which differs from TAN in the last bits. Revert to TAN once ! equivalence is proven. See the bit-for-bit register in the notes. env % tan_latitude = sin ( env % true_latitude ) / cos ( env % true_latitude ) ! tile surface temperatures default to the gridbox surface temperature, ! as in the old box model if ( all ( is_missing ( env % tstar_tile ))) then env % tstar_tile = env % tstar ( 1 , 1 ) endif ! TODO - need to add a check to see if we have inputs to actual derive all ! the variables in this subroutine ! TODO - surf area calc endsubroutine derive_env_variables subroutine update_env_from_tracers ( env_entry , tracer_ukca , tracer_name ) !! Subroutine for updating a box environment entry with the !! a current value from the tracer array. use box_tracer_mod , only : find_species_index use box_err_codes_mod , only : box_errcode_tracer_not_found !> The box environment field to update real , intent ( inout ) :: env_entry (:, :, :) !> The UKCA tracer array real , intent ( in ) :: tracer_ukca (:, :, :, :) !> Name of the tracer to copy into the environment field character ( len =* ), intent ( in ) :: tracer_name !> Routine name for logging character ( len =* ), parameter :: routine_name = \"update_env_from_tracers\" !> Whether the tracer was found in the tracer list logical :: found !> Index of the tracer in the tracer array integer :: tracer_index !> Error code for error reporting integer :: err_code !> Message for error reporting character ( len = ukca_maxlen_message ) :: err_msg call find_species_index ( tracer_name , tracer_index , found ) if ( found ) then env_entry (:, :, :) = tracer_ukca (:, :, :, tracer_index ) else err_code = box_errcode_tracer_not_found write ( err_msg , \"(2A)\" ) trim ( tracer_name ), \" not found in tracer \" // & \"variable list. Unable to update box environment with ukca_step value.\" call ereport ( mod_name // \":\" // routine_name , err_code , err_msg ) endif endsubroutine update_env_from_tracers subroutine update_tracer_from_env ( tracer_ukca , env_entry , tracer_name ) !! Copy a box environment entry into the matching tracer, so that the !! environment stays the master copy of that field (e.g. q into H2O, as !! the UM does). Does nothing if the species is not a tracer in this !! chemistry scheme. use box_tracer_mod , only : find_species_index !> The UKCA tracer array real , intent ( inout ) :: tracer_ukca (:, :, :, :) !> The box environment entry to copy into the tracer real , intent ( in ) :: env_entry (:, :, :) !> Name of the tracer to update character ( len =* ), intent ( in ) :: tracer_name !> Whether the tracer was found in the tracer list logical :: found !> Index of the tracer in the tracer array integer :: tracer_index call find_species_index ( tracer_name , tracer_index , found ) if ( found ) then tracer_ukca (:, :, :, tracer_index ) = env_entry (:, :, :) endif endsubroutine update_tracer_from_env elemental function is_missing ( value ) result ( missing ) !! Check whether a real value is the missing data value (rmdi) !> The value to check real , intent ( in ) :: value !> True if the value is rmdi logical :: missing missing = abs ( value - rmdi ) < epsilon ( value ) * abs ( rmdi ) endfunction is_missing function real_or_nan ( value ) result ( out ) !! Return NaN if a real value is the missing data value (rmdi), so missing !! fields stand out when printed. Otherwise return the value. !> The value to check real , intent ( in ) :: value !> The value, or NaN if it is missing data real :: out if ( is_missing ( value )) then out = ieee_value ( value , ieee_quiet_nan ) else out = value endif endfunction real_or_nan function int_or_nan ( value ) result ( out ) !! Return NaN if an integer value is the missing data value (imdi), so !! missing fields stand out when printed. Otherwise return the value as a !! real. !> The value to check integer , intent ( in ) :: value !> The value as a real, or NaN if it is missing data real :: out if ( value == imdi ) then ! to produce a NaN out = ieee_value ( real ( value ), ieee_quiet_nan ) else out = real ( value ) endif endfunction int_or_nan function int_to_string ( value ) result ( str ) !! Convert an integer to a string, with no padding !> The integer to convert integer , intent ( in ) :: value !> The integer as a string character ( len = :), allocatable :: str !> Buffer to write the integer into character ( len = 20 ) :: buffer write ( buffer , '(I0)' ) value str = trim ( buffer ) endfunction int_to_string function real_to_string ( value ) result ( str ) !! Convert a real to a string for printing in debug messages !> The value to convert real , intent ( in ) :: value !> The value as a string character ( len = 32 ) :: str write ( str , '(ES11.4)' ) value str = adjustl ( str ) endfunction real_to_string function log_to_string ( value ) result ( str ) !! Convert a logical to a string for printing in debug messages !> The value to convert logical , intent ( in ) :: value !> \"True\" or \"False\" character ( len = 5 ) :: str if ( value ) then str = 'True' else str = 'False' endif endfunction log_to_string endmodule box_environment_mod","tags":"","url":"sourcefile/box_environment.f90.html"},{"title":"conversions_mod.F90 – UKCA Box Model","text":"Source Code module conversions_mod implicit none public real , parameter :: pi = 3.14159265358979323846 real , parameter :: pi_over_180 = pi / 18 0.0 endmodule conversions_mod","tags":"","url":"sourcefile/conversions_mod.f90.html"},{"title":"fastjx_specs.F90 – UKCA Box Model","text":"Source Code module fastjx_specs implicit none public integer , parameter :: photol_jlabel_len = 7 integer , parameter :: x_ = 100 ! Max no. of cross sections to be read ! Array containing labels for photolysed species as read from file character ( LEN = photol_jlabel_len ) :: titlej ( x_ ) endmodule fastjx_specs","tags":"","url":"sourcefile/fastjx_specs.f90.html"},{"title":"ukca_box_model_main.F90 – UKCA Box Model","text":"Source Code program ukca_box_model_main !! Run the UKCA box model. The only input on the command line is the box !! config namelist, which names the other input files: !! !!     ukca_box_model namelist.nml [--debug <level>] use box_shell_mod , only : box_shell use box_debug_mod , only : set_debug_level use box_err_codes_mod , only : box_errcode_command_line use ereport_mod , only : ereport use ukca_api_mod , only : ukca_maxlen_message use umprintmgr , only : umMessage , umPrint implicit none !> Program name for logging and error reporting character ( len =* ), parameter :: prog_name = \"ukca_box_model_main\" !> One command line argument character ( len = 256 ) :: arg !> Path to the box config namelist character ( len = 256 ) :: namelist_path !> Number of command line arguments integer :: num_args !> Index of the current command line argument integer :: i !> Debug level set by --debug integer :: debug_level !> I/O status from reading the debug level integer :: iostat !> Whether the namelist file exists logical :: exists !> Error code for error reporting integer :: err_code !> Message for error reporting character ( len = ukca_maxlen_message ) :: err_msg num_args = command_argument_count () namelist_path = '' debug_level = 0 ! default: no debug i = 1 do while ( i <= num_args ) call get_command_argument ( i , arg ) select case ( trim ( arg )) case ( '--help' , '-h' ) call print_usage () stop 0 case ( '--debug' , '-d' ) call next_argument ( i , arg ) read ( arg , * , iostat = iostat ) debug_level if ( iostat /= 0 ) then write ( err_msg , \"(2A)\" ) \"Invalid debug level: \" , trim ( arg ) call report_usage_error ( err_msg ) endif case default if ( arg ( 1 : 1 ) == '-' ) then write ( err_msg , \"(2A)\" ) \"Unknown option: \" , trim ( arg ) call report_usage_error ( err_msg ) endif if ( len_trim ( namelist_path ) > 0 ) then write ( err_msg , \"(3A)\" ) \"Only one namelist file can be given, got '\" , & trim ( arg ), \"' as well\" call report_usage_error ( err_msg ) endif namelist_path = arg endselect i = i + 1 enddo if ( len_trim ( namelist_path ) == 0 ) then write ( err_msg , \"(A)\" ) \"No namelist file given\" call report_usage_error ( err_msg ) endif inquire ( file = trim ( namelist_path ), exist = exists ) if (. not . exists ) then write ( err_msg , \"(2A)\" ) \"Namelist file not found: \" , trim ( namelist_path ) call report_usage_error ( err_msg ) endif ! Set the global debug level call set_debug_level ( debug_level ) call umPrint ( \"Starting UKCA BOX_MODEL\" , src = prog_name ) write ( umMessage , \"(2A)\" ) \"Reading namelist from: \" , trim ( namelist_path ) call umPrint ( umMessage , src = prog_name ) if ( debug_level > 0 ) then write ( umMessage , \"(A, I0)\" ) \"Debug level set to: \" , debug_level call umPrint ( umMessage , src = prog_name ) endif call box_shell ( trim ( namelist_path )) call umPrint ( \"Finished UKCA BOX_MODEL\" , src = prog_name ) contains subroutine next_argument ( i , value ) !! Advance past an option and read its value, stopping with an error if !! the option is the last argument. !> Index of the option; on return, the index of its value integer , intent ( inout ) :: i !> The option's value character ( len = 256 ), intent ( out ) :: value !> The option itself, for the error message character ( len = 256 ) :: option call get_command_argument ( i , option ) if ( i == command_argument_count ()) then write ( err_msg , \"(2A)\" ) trim ( option ), \" option requires a value\" call report_usage_error ( err_msg ) endif i = i + 1 call get_command_argument ( i , value ) endsubroutine next_argument subroutine report_usage_error ( message ) !! Print the command line usage, then stop with an error. !> The error message character ( len =* ), intent ( in ) :: message call print_usage () err_code = box_errcode_command_line call ereport ( prog_name , err_code , message ) endsubroutine report_usage_error subroutine print_usage () !! Print the command line usage. call umPrint ( \"Usage: ukca_box_model <namelist_file> [--debug <level>]\" , & src = prog_name ) call umPrint ( \"The namelist's IO section names the other input files; \" // & \"relative paths are relative to the namelist's folder.\" , & src = prog_name ) call umPrint ( \"Debug levels: 0=off, 1=info, 2=detailed, 3=verbose\" , & src = prog_name ) endsubroutine print_usage endprogram ukca_box_model_main","tags":"","url":"sourcefile/ukca_box_model_main.f90.html"},{"title":"box_photol.F90 – UKCA Box Model","text":"Source Code module box_photol_mod !! Module for handling photolysis within the box model. use box_config_mod , only : box_config_type use errormessagelength_mod , only : errormessagelength use ereport_mod , only : ereport use ukca_error_mod , only : maxlen_message , maxlen_procname use ukca_api_mod , only : ukca_photol_varname_len use umprintmgr , only : umMessage , umPrint use box_debug_mod , only : is_debug_level implicit none private ! public procedures public :: box_photol_setup public :: photol_get_rates public :: update_solar_pos public :: get_photol_reaction_data !> Module name for error reporting character ( len =* ), parameter :: mod_name = \"box_photol_mod\" !> An array of offline photolysis rates for each grid point, level and !> reaction real , allocatable :: photol_rates_offline (:, :, :, :) !> An array of photolysis rates for each grid point, level and reaction real , allocatable :: photol_rates (:, :, :, :) !> A array of J rate values for each reaction and level character ( len = 10 ), pointer :: ratj_data (:, :) !> An array of photolysis variable names for each reaction character ( len = ukca_photol_varname_len ), pointer , public :: ratj_varnames (:) contains subroutine box_photol_setup ( cfg ) !! Setup up the photolysis module for the box model. This includes setting !! up the photolysis rates array, reading in the photolysis reaction data !! and setting up the photolysis scheme. use photol_setup_mod , only : photol_setup use box_const_mod , only : row_length , & model_levels , n_cca_lev , & l_enable_diag_um , l_environ_jo2 , & l_environ_jo2b , l_3d_cca , & l_environ_z_top , const_pi , earth_radius use box_socrates_mod , only : ip_aerosol_param_moist , ip_accum_sulphate , & ip_aitken_sulphate use ukca_constants , only : c_o3 !> Box model configuration type ( box_config_type ), intent ( in ) :: cfg !> Error code for error reporting integer :: err_code !> Error message for error reporting character ( len = errormessagelength ) :: err_msg !> Routine name for error reporting ukca errors character ( len = maxlen_procname ) :: ukca_routine_name call photol_setup ( & i_photol_scheme = cfg % i_photol_scheme , & error_code = err_code , & chem_timestep = cfg % chem_timestep , & fastjx_mode = cfg % fastjx_mode , & fastjx_numwl = cfg % fastjx_numwl , & global_row_length = row_length , & i_solcylc_type = cfg % i_solcylc_type , & ip_aerosol_param_moist = ip_aerosol_param_moist , & ip_accum_sulphate = ip_accum_sulphate , & ip_aitken_sulphate = ip_aitken_sulphate , & model_levels = model_levels , & n_cca_lev = n_cca_lev , & solcylc_start_year = cfg % solcylc_start_year , & i_error_method = cfg % i_error_method , & l_cal360 = cfg % l_cal360 , & l_cloud_pc2 = cfg % l_cloud_pc2 , & l_3d_cca = l_3d_cca , & l_enable_diag_um = l_enable_diag_um , & l_environ_jo2 = l_environ_jo2 , & l_environ_jo2b = l_environ_jo2b , & l_environ_ztop = l_environ_z_top , & l_strat_chem = cfg % l_strat_chem , & fastjx_prescutoff = cfg % fastjx_prescutoff , & timestep = cfg % timestep , & pi = const_pi , & o3_mmr_vmr = c_o3 , & planet_radius = earth_radius , & error_message = err_msg , & error_routine = ukca_routine_name ) if ( err_code /= 0 ) then call ereport ( ukca_routine_name , err_code , err_msg ) endif endsubroutine box_photol_setup subroutine get_photol_reaction_data () !! Get the photolysis reaction data by calling the UKCA API to retrieve !! the photolysis reaction data and variable names. Print the output if !! debug level is on. use ukca_api_mod , only : ukca_get_photol_reaction_data !> Loop index integer :: i !> Routine name for printing out character ( len =* ), parameter :: routine_name = mod_name // & \":get_photol_reaction_data\" !> Minimum debug level for printing integer , parameter :: minimum_debug_level = 1 call ukca_get_photol_reaction_data ( ratj_data , ratj_varnames ) if ( is_debug_level ( minimum_debug_level )) then ! print out the photolysis variable names when debug is on do i = 1 , size ( ratj_varnames ) write ( umMessage , \"(2A)\" ) \"Photolysis variable name: \" , & trim ( ratj_varnames ( i )) call umPrint ( umMessage , src = routine_name ) enddo endif endsubroutine get_photol_reaction_data subroutine setup_photol_rates () !! Setup the photolysis rates array for the box model. use box_const_mod , only : row_length , rows , model_levels use box_internal_ukca_config_mod , only : jppj if (. not . allocated ( photol_rates )) then allocate ( photol_rates ( row_length , rows , model_levels , jppj )) endif photol_rates = 0.0 endsubroutine setup_photol_rates subroutine update_solar_pos ( env ) !! Update the solar position in the box model environment based upon the !! current time and date. use box_time_mod , only : previous_date_time , & day_time_list_format , l_cal360 use box_environment_mod , only : box_environment_type !> The box model environment to update with the new solar position type ( box_environment_type ), intent ( inout ) :: env !> An array containing the day of year and time of day for the previous !> time step integer :: previous_day_time_list ( 7 ) !> Sin(solar declination) in radians real :: sindec !> The seconds since midnight for the previous time step real :: sec_since_mid !> True anomaly, equation 87 in Smart on p. 120 (UMDP23 Eq 73) real :: true_anomaly !> Eccentricity of the orbit real :: eccentricity !> Supplement of the longitude of perihelion real :: gamph !> Obliquity of the orbit real :: oblq !> Mean anomaly at 12Z real :: mean_anomaly !> Solar constant scaling factor real :: scs !> The equation of time, specified as an hour angle in radians. real :: eqt !> Derived orbital parameter - e1 real :: e1 !> Derived orbital parameter - e2 real :: e2 !> Derived orbital parameter - e3 real :: e3 !> Derived orbital parameter - e4 real :: e4 !> Intermediate variable real :: y1 !> Minimum debug level integer , parameter :: min_debug_level = 1 !> The routine name for logging and error reporting character ( len =* ), parameter :: routine_name = mod_name // & \":update_solar_pos\" if ( is_debug_level ( min_debug_level )) then write ( umMessage , \"(A,I2.2,A,I2.2,A,I2.2)\" ) & \"Updating solar position - using previous time: \" , & previous_date_time % hour , \":\" , previous_date_time % minute , \":\" , & previous_date_time % second call umprint ( umMessage , src = routine_name ) endif sec_since_mid = real ( previous_date_time % hour * 3600 + & previous_date_time % minute * 60 + & previous_date_time % second ) if ( is_debug_level ( min_debug_level )) then write ( umMessage , \"(A,I0)\" ) \"Seconds since midnight = \" , & int ( sec_since_mid ) call umprint ( umMessage , src = routine_name ) endif ! index 7 = day of year previous_day_time_list = day_time_list_format ( previous_date_time ) if ( is_debug_level ( min_debug_level )) then write ( umMessage , \"(A,I0)\" ) \"Day of year = \" , previous_day_time_list ( 7 ) call umprint ( umMessage , src = routine_name ) write ( umMessage , \"(A,I0)\" ) \"Year = \" , previous_date_time % year call umprint ( umMessage , src = routine_name ) endif ! Determine the orbital parameters for the Earth call orbprm ( previous_day_time_list ( 7 ), & l_cal360 , eccentricity , gamph , oblq , mean_anomaly ) if ( is_debug_level ( min_debug_level )) then write ( umMessage , \"(A,E12.3,A,E12.3,A,E12.3,A,E12.3)\" ) & \"Orbital parameters: e=\" , eccentricity , & \" gamph=\" , gamph , & \" oblq=\" , oblq , & \" mean_anomaly=\" , mean_anomaly call umprint ( umMessage , src = routine_name ) endif ! Calculate the coefficients in the equation of the centre and ! thence derive the true anomaly. e1 = eccentricity * ( 2.0 - . 25 * eccentricity * eccentricity ) e2 = 1.25 * eccentricity * eccentricity e3 = eccentricity * eccentricity * eccentricity * 1 3.0 / 1 2.0 ! True anomaly, equation 87 in Smart on p. 120 (UMDP23 Eq 73) true_anomaly = mean_anomaly + e1 * sin ( mean_anomaly ) + & e2 * sin ( 2.0 * mean_anomaly ) + & e3 * sin ( 3.0 * mean_anomaly ) ! Solar constant scaling factor (UMDP23 Eqs 75 and 76) e4 = ( 1.0 / ( 1.0 - eccentricity * eccentricity )) ** 2 ! not currently used but likely needed later scs = e4 * ( 1.0 + eccentricity * cos ( true_anomaly )) ** 2 ! sin(solar declination) (UMDP23 Eq 77) ! The solar declination is related to !  the true longitude of the earth (lambda) by: !  sindec = sin(obliquity) * sin(lambda) ! Lambda is counted counter-clockwise from the vernal equinox !  and is related to v (the true anomaly) through !  lambda = v + (longitude of perihelion) sindec = sin ( oblq ) * sin ( true_anomaly - gamph ) ! TODO - we only allow for Equation 29 on page 149 of Smart (1944) in !   equation of time calculations - should added Mueller option ! Use equation (29)on page 149 of Smart (1944). ! (Recall the factor of 5/4 in the definition of e2). y1 = ( tan ( 0.5 * oblq )) ** 2 eqt = y1 * sin ( 2.0 * ( mean_anomaly - gamph )) & - 2.0 * eccentricity * sin ( mean_anomaly ) & + 4.0 * eccentricity * y1 * sin ( mean_anomaly ) & * cos ( 2.0 * ( mean_anomaly - gamph )) & - 0.5 * y1 * y1 * sin ( 4.0 * ( mean_anomaly - gamph )) & - e2 * sin ( 2.0 * mean_anomaly ) ! now we've updated eqt and sindec we need to set the environment again env % sin_declination = sindec env % equation_of_time = eqt endsubroutine update_solar_pos subroutine orbprm ( day_number , l_cal360 , eccentricity , gamph , oblq , & mean_anomaly ) !! Calculate the orbital parameters ! TODO - we currently don't evolve orb parameters - model won't be suitable ! for paleo and long climate runs in current form use box_const_mod , only : const_pi !> Day-number in the year integer , intent ( in ) :: day_number !> Use a calendar of 360 days logical , intent ( in ) :: l_cal360 !> Eccentricity of earth's orbit real , intent ( out ) :: eccentricity !> Supplement of the longitude of perihelion real , intent ( out ) :: gamph !> Obliquity of the orbit real , intent ( out ) :: oblq !> Mean anomaly at 12Z real , intent ( out ) :: mean_anomaly !> Length of the calendar year (in whole days) real :: diny !> Time of the perihelion passage in days real :: tau0 !> Number of days in the tropical year real , parameter :: trop_year_length = 36 5.2424 !> Eccentricity of the orbit real , parameter :: e_dflt = 1.6710222e-02 !> Obliquity of the orbit - corresponds to 23.43929111 degrees real , parameter :: oblq_dflt = 0.409092804 !> Longitude of the perihelion in radians real , parameter :: lph_dflt = 10 2.94719 * const_pi / 18 0.0 !> Time of the perihelion passage in days real , parameter :: tau0_dflt = 2.667 ! Set the orbital parameters to their defaults eccentricity = e_dflt oblq = oblq_dflt gamph = const_pi - lph_dflt tau0 = tau0_dflt ! Calculate the mean anomaly at 12Z on the current day. ! The 0.5 accounts for the time in days since mid-night. ! The references are to Smart 1944 (and UMDP23) ! Eq 67 p. 113 and n=2pi/orbital period     (Eq 3.1.1) if ( l_cal360 ) then diny = 36 0.0 tau0 = tau0 * ( 36 0.0 / trop_year_length ) + 0.71 mean_anomaly = (( 2.0 * const_pi ) / diny ) * & ( real ( day_number ) - tau0 - 0.5 ) else mean_anomaly = (( 2.0 * const_pi ) / trop_year_length ) * & ( real ( day_number ) - tau0 - 0.5 ) endif endsubroutine orbprm subroutine photol_get_rates ( cfg , env ) !! Process the photolysis rates, beginning with setup and moving onto !! either calculate the rates in an offline or online manner depending on !! cfg%l_offline_photol use box_config_mod , only : box_config_type use box_environment_mod , only : box_environment_type !> the input box model configuration type ( box_config_type ), intent ( in ) :: cfg !> the input box model environment, photolysis rates are stored in type ( box_environment_type ), intent ( inout ) :: env if ( cfg % i_photol_scheme == 0 ) then ! not running photolysis - do nothing return endif call setup_photol_rates () if ( cfg % l_offline_photol ) then call photol_ctl_offline ( cfg , env ) else call photol_ctl_online ( env ) endif endsubroutine photol_get_rates subroutine photol_ctl_offline ( cfg , env ) !! A subroutine to handle box model configuration where photolysis rates !! are provided in an offline file use box_config_mod , only : box_config_type use box_environment_mod , only : box_environment_type use box_const_mod , only : row_length , rows , model_levels use box_internal_ukca_config_mod , only : jppj use box_time_mod , only : previous_date_time use ukca_solang_mod , only : ukca_solang !> The input box model configuration type ( box_config_type ), intent ( in ) :: cfg !> The input box model environment type ( box_environment_type ), intent ( inout ) :: env !> How many seconds since midnight real :: seconds_since_midnight !> The number of grid points in the model integer :: n_points !> The solar zenith angle array real :: cos_zenith_angle ( row_length , rows ) !> The day length array real :: daylen ( row_length , rows ) !> loop index integer :: i !> Loop index integer :: j !> Loop index integer :: k !> Loop index integer :: l !> Routine name for print outs character ( len = maxlen_procname ), parameter :: & routine_name = mod_name // \":photol_ctl_offline\" !> minimum debug level for printing integer , parameter :: minimum_debug = 1 ! use previous time step for the input seconds_since_midnight = real ( previous_date_time % hour * 3600 + & previous_date_time % minute * 60 + & previous_date_time % second ) ! number of points n_points = row_length * rows if (. not . allocated ( photol_rates_offline )) then call read_offline_photol_rates ( cfg % offline_photol_rates_file ) else if ( is_debug_level ( minimum_debug )) then write ( umMessage , \"(A,A)\" ) \"Photolysis rates already read from \" , & \"file - skipping re-read\" call umPrint ( umMessage , src = routine_name ) endif endif call calc_local_day_length ( env % tan_latitude , env % sin_declination , daylen ) call ukca_solang ( env % sin_declination , & seconds_since_midnight , & real ( cfg % chem_timestep ), & env % equation_of_time , env % sin_latitude , & env % cos_latitude , env % longitude , & n_points , cos_zenith_angle ) ! use the cosine of the solar zenith angle to scale the photolysis rates do k = 1 , model_levels do j = 1 , rows do i = 1 , row_length if ( cos_zenith_angle ( i , j ) > 0.0 ) then photol_rates ( i , j , k , :) = photol_rates_offline ( i , j , k , :) * & cos_zenith_angle ( i , j ) else photol_rates ( i , j , k , :) = 0.0 endif enddo enddo enddo if ( is_debug_level ( minimum_debug )) then write ( umMessage , \"(A)\" ) \"Photolysis rates:\" call umPrint ( umMessage , src = routine_name ) do l = 1 , jppj write ( umMessage , \"(A,A,A,E12.3)\" ) \"  Reaction \" , & trim ( ratj_varnames ( l )), \": \" , photol_rates ( 1 , 1 , 1 , l ) call umPrint ( umMessage , src = routine_name ) enddo endif ! these can then be set using ukca_set_environment env % photol_rates = photol_rates endsubroutine photol_ctl_offline subroutine calc_local_day_length ( tan_latitude , sin_declination , daylen ) !! Calculate the day length for a model's grid use box_const_mod , only : row_length , rows , & const_pi , rhour_per_day_const !> An array of the tangent of latitude values for the grid real , intent ( in ) :: tan_latitude ( row_length , rows ) !> sin of solar declination real , intent ( in ) :: sin_declination !> An array of the day lengths for each grid cell real , intent ( out ) :: daylen ( row_length , rows ) !> Cosine hour angle real :: cs_hour_ang ( row_length , rows ) !> TAN(solar declination angle) real :: tan_declin ! solar declination from the box model's own solar position ! (`update_solar_pos`), so day length is consistent with ! `cos_zenith_angle` tan_declin = sin_declination / sqrt ( 1.0 - sin_declination ** 2 ) ! guard against tan_declin == 0 (an equinox) if ( abs ( tan_declin ) < epsilon ( tan_declin )) then cs_hour_ang = 0.0 else cs_hour_ang = max ( - 1.0 , min ( 1.0 , - tan_latitude * tan_declin )) endif daylen = ( rhour_per_day_const / const_pi ) * acos ( cs_hour_ang ) endsubroutine calc_local_day_length subroutine read_offline_photol_rates ( photol_rates_file ) !! Read photolysis rates from an offline file use box_internal_ukca_config_mod , only : jppj use box_const_mod , only : row_length , rows , model_levels use missing_data_mod , only : rmdi use ukca_chem_defs_mod , only : ratj_defs use box_err_codes_mod , only : box_errcode_io_photol_offline !> The path to the file containing the offline rates character ( len =* ), intent ( in ) :: photol_rates_file !> An array of quantum yield scaling factors real :: jfacta ( jppj ) !> the I/O status of read integer :: iostat_read !> the I/O status of open integer :: iostat_open !> the I/O status of parse integer :: iostat_parse !> Code for error reporting integer :: err_code !> Loop index integer :: i !> Array of reaction indexes in the photol array integer , allocatable :: indexes (:) !> the I/O unit for reading the offline photolysis file integer :: unit !> Logical for determining if the rate file exists. logical :: file_exists !> Logical for determining if a reaction rate was found logical :: found !> Message for error reporting character ( len = errormessagelength ) :: err_msg !> Routine name for error reporting character ( len = maxlen_procname ), parameter :: & routine_name = mod_name // \":read_offline_photol_rates\" !> The read line from the offline photol file character ( len = 256 ) :: line !> The read variable name from the rates file character ( len = 256 ) :: var_name !> The read variable value from the rates file real :: var_value !> The default value to apply to required rates not found in the file real :: default_value !> Array of logicals showing which rates have been provided. logical :: photol_provided ( jppj ) ! allocate photol_rates_offline if (. not . allocated ( photol_rates_offline )) then allocate ( photol_rates_offline ( row_length , rows , model_levels , jppj )) photol_rates_offline = rmdi endif default_value = 0.0 err_code = 0 photol_provided = . false . iostat_read = 0 iostat_open = 0 iostat_parse = 0 inquire ( file = photol_rates_file , exist = file_exists ) if (. not . file_exists ) then write ( err_msg , \"(3A)\" ) \"Photol rate file '\" , trim ( photol_rates_file ), & \"' not found.\" err_code = box_errcode_io_photol_offline call ereport ( routine_name , err_code , err_msg ) endif ! TODO - move reading of rate file to a separate module due to duplication ! with tracer reading. open ( newunit = unit , file = photol_rates_file , status = 'old' , & action = 'read' , iostat = iostat_open ) if ( iostat_open /= 0 ) then write ( err_msg , \"(2A)\" ) \"Error opening the offline photolysis file: \" , & trim ( photol_rates_file ) err_code = box_errcode_io_photol_offline call ereport ( routine_name , err_code , err_msg ) endif do read ( unit , '(A)' , iostat = iostat_read ) line if ( is_iostat_end ( iostat_read )) then exit elseif ( iostat_read /= 0 ) then write ( err_msg , \"(3A)\" ) \"Error reading photol rates file '\" , & trim ( photol_rates_file ), \"'.\" err_code = box_errcode_io_photol_offline call ereport ( routine_name , err_code , err_msg ) endif if ( len_trim ( line ) == 0 . or . line ( 1 : 1 ) == \"#\" ) then cycle endif ! Read whitespace-separated tokens: <var_name> <var_value> read ( line , * , iostat = iostat_parse ) var_name , var_value if ( iostat_parse /= 0 ) then write ( err_msg , \"(3A)\" ) \"Could not parse offline photol rate line: '\" , & trim ( line ), \"'.\" err_code = - box_errcode_io_photol_offline call ereport ( routine_name , err_code , err_msg ) cycle endif if ( var_name == \"DEFAULT\" ) then default_value = var_value cycle endif ! find index of var_name in ratj_varnames call find_photol_varname_index ( var_name , indexes , found ) if ( found ) then do i = 1 , size ( indexes ) photol_rates_offline (:, :, :, indexes ( i )) = var_value photol_provided ( indexes ( i )) = . true . enddo else write ( err_msg , \"(3A)\" ) \"Variable '\" , trim ( var_name ), & \"' in photol rate file not found in model configuration.\" ! warning code err_code = - box_errcode_io_photol_offline call ereport ( routine_name , err_code , err_msg ) endif enddo close ( unit ) ! use default value to fill any missing photolysis rates do i = 1 , jppj if (. not . photol_provided ( i )) then photol_rates_offline (:, :, :, i ) = default_value write ( err_msg , \"(4A,E12.3E3,A)\" ) & \"No value provided for photolysis rate '\" , & trim ( ratj_varnames ( i )), \"' in photol rate file. \" , & \"Using default value of \" , default_value , \".\" ! warning code err_code = - box_errcode_io_photol_offline call ereport ( routine_name , err_code , err_msg ) endif enddo ! final check that no photolysis rates are missing, e.g. negative do i = 1 , jppj if ( any ( photol_rates_offline (:, :, :, i ) < 0.0 )) then write ( err_msg , \"(4A)\" ) \"Photolysis rate '\" , & trim ( ratj_varnames ( i )), & \"' has negative value in photol rate file. \" , & \"Please check file and try again.\" err_code = box_errcode_io_photol_offline call ereport ( routine_name , err_code , err_msg ) endif enddo ! we have to apply \"quantum yield\" scaling here do i = 1 , jppj jfacta ( i ) = ratj_defs ( i )% jfacta / 10 0.0 photol_rates_offline (:, :, :, i ) = photol_rates_offline (:, :, :, i ) * & jfacta ( i ) enddo endsubroutine read_offline_photol_rates subroutine find_photol_varname_index ( var_name , indexes , found ) !! Find the indexes of a j-value label in the ratj_varnames array based !! upon its name. Note that there can be multiple entries for a specific !! species in the ratj_varnames array. use box_internal_ukca_config_mod , only : jppj !> The variable name to find in the photolysis variable name array character ( len =* ), intent ( in ) :: var_name !> the indexes corresponding to the var_name integer , allocatable , intent ( out ) :: indexes (:) !> Logical indicating if one index was found logical , intent ( out ) :: found !> Loop index integer :: i allocate ( indexes ( 0 )) found = . false . do i = 1 , jppj if ( trim ( var_name ) == trim ( ratj_varnames ( i ))) then call append ( indexes , i ) found = . true . endif enddo contains subroutine append ( list , value ) !! Help routine for appending a value to a list !> The list to append the value to integer , allocatable , intent ( inout ) :: list (:) !> The value to append integer , intent ( in ) :: value !> Temporary copy of the list integer , allocatable :: temp (:) !> Length of the list integer :: n n = size ( list ) allocate ( temp ( n + 1 )) if ( n > 0 ) temp ( 1 : n ) = list temp ( n + 1 ) = value call move_alloc ( temp , list ) endsubroutine append endsubroutine find_photol_varname_index subroutine photol_ctl_online ( env ) !! Setup box model configuration where photolysis rates that are actively !! calculated based upon a provided column environment. use box_environment_mod , only : box_environment_type use box_time_mod , only : current_date_time , day_time_list_format use box_const_mod , only : row_length , rows , model_levels , rad_ctl_jo2 , & rad_ctl_jo2b use ukca_api_mod , only : ukca_photol_varname_len use photol_ctl_mod , only : photol_ctl use box_internal_ukca_config_mod , only : jppj use box_tracer_mod , only : return_tracer use box_err_codes_mod , only : box_errcode_not_implemented !> The box model environment type ( box_environment_type ), intent ( inout ) :: env !> The returned error code from photol_ctl integer , target :: error !> The point to error, passed into photol_ctl integer , pointer :: error_ptr !> The routine name for error reporting character ( len = maxlen_procname ), parameter :: routine_name = mod_name // & \":photol_ctl_online\" !> The internal UKCA routine that caused an error character ( len = maxlen_procname ) :: ukca_err_routine !> The message for error reporting character ( len = errormessagelength ) :: err_msg !> The error code for box model specific errors integer :: err_code !> The o3 mmr from the box model tracer real :: o3 !> An array containing the o3 mmr, passed into photol_ctl real :: ozone_mmr ( row_length , rows , model_levels ) !> number of seconds since midnight real :: seconds_since_midnight !> Current time list in the form  [year, month, day, hour, minute, second !> and day of year] integer :: current_time ( 7 ) !> rate data array for the output from photol_ctl character ( len = 10 ), pointer :: rate_data (:, :) !> rate variable names array for the output from photol_ctl character ( len = ukca_photol_varname_len ), pointer :: rate_varnames (:) ! Error for now write ( err_msg , \"(A)\" ) \"Not implemented yet - on the to do list!\" err_code = box_errcode_not_implemented call ereport ( routine_name , err_code , err_msg ) seconds_since_midnight = real ( current_date_time % hour * 3600 + & current_date_time % minute * 60 + & current_date_time % second ) current_time = day_time_list_format ( current_date_time ) ! fetch the O3 mixing ratio from the tracer array call return_tracer ( \"O3\" , o3 ) ! set ozone mmr (3D) to the real value of o3 ozone_mmr = o3 error_ptr => error ! because we don't need the column with offline mode we can just pass the ! box environment in call photol_ctl ( & error_code_ptr = error_ptr , & row_length = row_length , & rows = rows , & model_levels = model_levels , & jppj = jppj , & z_top_of_model = env % z_top_of_model , & seconds_since_midnight = seconds_since_midnight , & sin_declination = env % sin_declination , & equation_of_time = env % equation_of_time , & current_time = current_time , & ratj_data = rate_data , & ratj_varnames = rate_varnames , & conv_cloud_base = env % conv_cloud_base , & conv_cloud_top = env % conv_cloud_top , & land_fraction = env % fland , & surf_albedo = env % surf_albedo , & longitude = env % longitude , & sin_latitude = env % sin_latitude , & cos_latitude = env % cos_latitude , & tan_latitude = env % tan_latitude , & p_theta_levels = env % p_theta_levels , & p_layer_boundaries = env % p_layer_boundaries , & r_theta_levels = env % r_theta_levels , & r_rho_levels = env % r_rho_levels , & qcl = env % qcl , & qcf = env % qcf , & area_cloud_fraction = env % area_cloud_fraction , & conv_cloud_amount = env % conv_cloud_amount , & conv_cloud_lwp = env % conv_cloud_lwp , & ozone_mmr = ozone_mmr , & so4_aitken = env % so4_aitken , & so4_accum = env % so4_accum , & aod_sulph_aitk = env % aod_sulph_aitk , & aod_sulph_accum = env % aod_sulph_accum , & rad_ctl_jo2 = rad_ctl_jo2 , & rad_ctl_jo2b = rad_ctl_jo2b , & t_theta_levels = env % t_theta_levels , & photol_rates_2d = photol_rates_offline , & photol_rates = photol_rates , & error_message = err_msg , & error_routine = ukca_err_routine ) if ( error /= 0 ) then call ereport ( ukca_err_routine , error , err_msg ) endif endsubroutine photol_ctl_online endmodule box_photol_mod","tags":"","url":"sourcefile/box_photol.f90.html"},{"title":"ukca_internal_dump.F90 – UKCA Box Model","text":"Source Code module ukca_internal_dump_mod !! GENERATED FILE - DO NOT EDIT. !! Generated by tools/gen_ukca_internal_dump.py from UKCA !! apps2.2/um13.9 (4a2baa5). !! Regenerate after any UKCA upgrade. !! !! Dumps the internal UKCA config and state with box_dump_mod, !! read directly from UKCA. It never calls ukca_setup, !! ukca_set_environment or ukca_step. A driver adds: !! !!   if (ukca_dump_on()) call dump_ukca_internal_config() !!     after ukca_setup and photol_setup !!   if (ukca_dump_on()) call dump_ukca_step_in(<ukca_step args>) !!     immediately before ukca_step !!   if (ukca_dump_