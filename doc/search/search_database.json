var tipuesearch = {"pages":[{"title":" UKCA Box Model ","text":"UKCA Box Model A new completely stand-alone version of the UKCA box model used for\nexperiments, testing and development. Developer Info Rob Waters","tags":"home","url":"index.html"},{"title":"box_date_time – UKCA Box Model ","text":"type, public :: box_date_time Type for storing date and time information Components Type Visibility Attributes Name Initial integer, public :: year Year integer, public :: month Month integer, public :: day Day integer, public :: hour Hour integer, public :: minute Minute integer, public :: second Seconds","tags":"","url":"type/box_date_time.html"},{"title":"box_config_type – UKCA Box Model ","text":"type, public :: box_config_type All the box model configuration options, read from the box config\nnamelist Components Type Visibility Attributes Name Initial integer, public :: model_duration model duration (seconds) integer, public :: start_year starting year of model integer, public :: start_month starting month of model integer, public :: start_day starting day of model integer, public :: start_hour starting hour of model integer, public :: start_minute starting minute of model integer, public :: start_second starting second of model integer, public :: i_ukca_chem Chemistry scheme to use integer, public :: i_ukca_chem_version Chemical mechanism version identifier integer, public :: nrsteps No. of N-R solver iterations before time step is halved integer, public :: chem_timestep Chemical timestep in seconds for N-R and offline oxidant schemes integer, public :: dts0 Backward Euler timestep (seconds) integer, public :: i_ageair_reset_method Method for controlling age reset to 0 integer, public :: max_ageair_reset_level Max. level for reset (Method 1) integer, public :: i_error_method Error handling method to use integer, public :: nit Number of iterations for B-E Solver integer, public :: i_ukca_quasinewton_start Iteration to start quasi-Newton step (2-50, 2 recommended) integer, public :: i_ukca_quasinewton_end Iteration to stop quasi-Newton step (2-50, 3 recommended) integer, public :: i_ukca_topboundary Method of treating top boundary for certain species in stratospheric\nschemes integer, public :: i_ukca_hetconfig 0 = default (5 reactions); 1 = JPL-15 recommended coeff. 2 = JPL-15 +\nbromine reactions integer, public :: i_inferno_emi maximum INFERNO emission level integer, public :: i_ukca_dms_flux Sea-air DMS exchange scheme to use integer, public :: i_ukca_light_param Choice for flash-freq parameterisation (1 = Price & Rind, 2 = Luhar et\nal., 3 = external lightning scheme) integer, public :: i_photol_scheme Photolysis scheme: 0 = off, 1 = stratospheric only, 2 = offline/2-D,\n3 = Fast-JX integer, public :: env_log_step Timestep number at which environment summary diagnostics should be\nprinted to log file integer, public :: i_ukca_tune_bc Options for tuning BC absorption via adjusting BC mass density and\nrefractive index mixing approximations integer, public :: i_primss_method Sea-salt emission options integer, public :: i_mode_nzts No. of substeps for nucleation/sedimentation integer, public :: i_mode_setup MODE aerosol scheme to use integer, public :: i_mode_bln_param_method Parameterisation method for boundary layer nucleation 1=activation;\n2=kinetic; 3=organic mediated (as per Metzger et al, PNAS, 2010) -\nrequired when 'l_mode_bhn_on' is true. integer, public :: i_mode_nucscav Choice of nucl. scavenging coefficients: 1=original, 2=ECHAM5-HAM,\n3=as(1) but no scav of modes 6&7 integer, public :: i_ukca_activation_scheme Activation scheme to use integer, public :: i_ukca_nwbins Value of nwbins in Activate (1-20) See Rosalind West paper for details\ndoi:10.5194/acp-14-6369-2014 integer, public :: ntype Number of surface types considered in interactive dry deposition integer, public :: fastjx_mode fast-jx photolysis mode above cutoff (1=lookup tables, 2=fast-jx +\nlookup tables, 3=fast-jx) integer, public :: fastjx_numwl number of wavelengths to use in fast-jx. Options are 8, 12 or 18 integer, public :: i_solcylc_type apply solar variability to photolysis (fast-jx only). 0 = no solar\ncycle, 1 = observed cycle, 2 = average cycle. integer, public :: solcylc_start_year 1st year for the solar cycle (used when i_solcylc_type = 1) real, public :: dzsoil_layer1 Thickness of surface soil layer (m) real, public :: timestep Model timestep in seconds (an integer no of timesteps is expected in 1\nhour) real, public :: max_ageair_reset_height Max. height (m) for reset (Method 2) real, public :: max_z_for_offline_chem Maximum height at which to integrate chemistry with the explicit B-E\nOffline Oxidants scheme real, public :: fastjx_prescutoff Cut-off Pressure for tabulated photolysis real, public :: mode_parfrac Fraction of SO2 emissions as aerosol(%) real, public :: seadms_ems_scaling Marine DMS emission scaling factor real, public :: sea_salt_ems_scaling Sea salt emission scaling factor real, public :: marine_pom_ems_scaling Marine POM emission scaling factor real, public :: lightnox_scale_fac Lightning NOx emissions scaling factor real, public :: anth_so2_ems_scaling Anthropogenic SO2 emissions scaling factor real, public :: soa_yield_scaling_mt Scaling factor for production of SOA from monoterpene real, public :: soa_yield_scaling_isop Scaling factor for production of SOA from isoprene real, public :: dry_depvel_so2_scaling SO2 dry deposition velocity scaling factor real, public :: mode_activation_dryr Activation dry radius (nm) real, public :: dry_depvel_acc_scaling Scaling factor for the dry deposition velocity for the accumulation mode real, public :: acc_cor_scav_scaling Scaling factor for scavenging parameters for the accumulation and coarse\nmodes real, public :: mode_incld_so2_rfrac Fraction of in-cloud oxidised SO2 removed by precipitation real, public :: biom_aer_ems_scaling Biomass-burning emissions scaling real, public :: ph_fit_coeff_a value for fitting coefficient a of the interactive cloud pH code real, public :: ph_fit_coeff_b value for fitting coefficient b of the interactive cloud pH code real, public :: ph_fit_intercept y-intercept value of the relationship for the interactive cloud pH code real, public :: sigwmin Lower limit for std. dev. of updraft velocity pdf used in Activate\n(default: 0.01 m/s). real, public :: hno3_uptake_coeff HNO3 uptake coefficient for nitrate real, public :: sigma_updraught_scaling Scaling factor for standard deviation of updraught velocities real, public :: const_rmol Configurable universal gas constant R (J/mol/K) real, public :: const_tfs Configurable temperature at which sea water freezes (K) real, public :: const_rho_water Configurable density of pure water (kg/m3) real, public :: const_rhosea Configurable density of sea water (kg/m3) real, public :: const_lc Configurable latent heat of condensation of water at 0 degC (J/kg) real, public :: const_avogadro Configurable number of molecules in 1 mole (Avogadro constant) real, public :: const_boltzmann Configurable Boltzmann constant (J K-1) real, public :: const_rho_so4 Configurable density of SO4 particle (kg/m3) real, public :: delta_lambda EW (x) grid spacing in radians real, public :: delta_phi NS (y) grid spacing in radians logical, public :: l_cal360 True if UKCA is expected to use a 360-day calendar for applying a top\nboundary condition in stratospheric chemistry schemes and/or for\nvalidating external emissions. (Emissions registered with a day-of-week\nscaling requirement can't be used with a 360-day calendar). logical, public :: l_ukca_chem_aero True for aerosol precursor chemistry logical, public :: l_ukca_mode True for GLOMAP-mode aerosol scheme logical, public :: l_ukca_ageair True for age-of-air scheme logical, public :: l_blankout_invalid_diags True to set all non-valid diagnostic field data to missing data value logical, public :: l_timer True to use a timer routine for timing sub-models logical, public :: l_ukca_scale_ppe True to turn on perturbed parameter ensemble (PPE) scaling parameters logical, public :: l_ukca_drydep_off True to turn off dry deposition logical, public :: l_ukca_wetdep_off True to turn off wet deposition logical, public :: l_ukca_debug_asad Include additional print output specific to ASAD logical, public :: l_ukca_intdd True for interactive dry deposition logical, public :: l_ukca_ddepo3_ocean True to use Luhar et al. (2018) oceanic O3 dry-deposition scheme logical, public :: l_ukca_ddep_lev1 True to apply dry deposition losses only in level 1 logical, public :: l_ukca_dry_dep_so2wet True if considering the impact of surface wetness on dry deposition logical, public :: l_deposition_jules True when using JULES-based interactive dry deposition routines logical, public :: l_ukca_quasinewton True to use quasi-Newton (Broyden) method to reduce no. of iterations in\nN-R solver step logical, public :: l_tracer_lumping True to handle lumped tracers in stratospheric chemistry schemes logical, public :: l_ukca_ro2_ntp True to stop transport of peroxy radicals in StratTrop/CRI scheme logical, public :: l_ukca_ro2_perm True for RO2-permutation chemistry in StratTrop/CRI scheme logical, public :: l_ukca_intph True for calculating interactive cloud pH values (F for global value of\n5) logical, public :: l_ukca_het_psc True for heterogeneous polar stratospheric cloud chemistry logical, public :: l_ukca_limit_nat True to limit the formation of NAT in polar stratospheric clouds\n(type 1) to heights above 1 km logical, public :: l_ukca_sa_clim True to use surface area density climatology for heterogeneous PSC chem. logical, public :: l_ukca_trophet True for tropospheric het. chemistry logical, public :: l_ukca_classic_hetchem Allows the use of heterogeneous chemistry on aerosol surfaces from\nCLASSIC within UKCA. logical, public :: l_use_photolysis True if UKCA is expecting to apply Photolysis rates in the solver and\nhence needs the rates from the parent logical, public :: l_ukca_ibvoc True for interactive bVOC emissions logical, public :: l_ukca_inferno True for INFERNO fire emissions logical, public :: l_ukca_inferno_ch4 True for INFERNO CH4 fire emissions logical, public :: l_ukca_so2ems_expvolc True for interactive expvolc emissions logical, public :: l_ukca_so2ems_plumeria True for expvolc emissions with plumeria logical, public :: l_ukca_qch4inter True for interactive wetland CH4 emissions logical, public :: l_ukca_emsdrvn_ch4 True when running UKCA in CH4 emissions-driven mode logical, public :: l_ukca_scale_seadms_ems Apply scaling to marine DMS emissions. logical, public :: l_ukca_linox_scaling True to use LOG(p) to distribute lightning NOx in the vertical logical, public :: l_ukca_scale_soa_yield_mt Apply scaling factor to SOA production from monoterpene logical, public :: l_ukca_scale_soa_yield_isop Apply scaling factor to SOA production from isoprene logical, public :: l_support_ems_vertprof True to support full range of vertical scaling options for 2D emission\nfields. logical, public :: l_support_ems_gridbox_units True to support the provision of offline emissions in grid-box units logical, public :: l_suppress_ems True to suppress all tracer updates from emissions and boundary layer\nmixing (Emissions diagnostics are unaffected) logical, public :: l_ukca_h2o_feedback True for H2O feedback from chemistry logical, public :: l_param_conv True if using precipitation diagnostics from a parameterized convection\nscheme logical, public :: l_ctile True if using partial land points at coasts logical, public :: l_zon_av_ozone True if external O3, used for troposphere only schemes, is expected as a\nmean value for each domain row (i.e. zonal mean if lat const. in row) logical, public :: l_ukca_conserve_h True to include hydrogen conservation when 'l_ukca_h2o_feedback' is true logical, public :: l_chem_environ_gas_scalars True if using external values for CO2, CH4, O2, H2 and N2 in chemistry logical, public :: l_chem_environ_co2_fld True if using an external CO2 field in chemistry logical, public :: l_ukca_prescribech4 True if prescribing surface CH4 logical, public :: l_use_classic_so4 True to use CLASSIC SO4 for het. chem. logical, public :: l_use_classic_soot True to use CLASSIC black carbon for het. chem. (RAQ scheme only) logical, public :: l_use_classic_ocff True to use CLASSIC organic carbon from fossil fuels for het. chem.\n(RAQ only) logical, public :: l_use_classic_biogenic True to use CLASSIC biogenic secondary organic aerosol for het. chem.\n(RAQ only) logical, public :: l_use_classic_seasalt True to use CLASSIC sea salt for het. chem. (RAQ only) logical, public :: l_use_gridbox_volume True to use gridbox volume in diagnostic calculations. (This is required\nfor UM diagnostics and to enable use of ASAD framework diagnostics in\nnon-UM applications.) logical, public :: l_use_gridbox_mass True to use mass of air in grid box in prognostic and/or diagnostic\ncalculations. (Note that GLOMAP-mode prognostics will run with or\nwithout this option giving equivalent but not bit-comparable results.\nThe option is required for the stratospheric chemistry schemes and for\nUM diagnostics.) logical, public :: l_environ_rel_humid True if using external fields for relative humidity, clear-sky relative\nhumidity and/or saturation vapour pressure logical, public :: l_fix_ukca_cloud_frac True to fix cloud_frac offset bug logical, public :: l_fix_improve_drydep True to fix dry deposition velocities logical, public :: l_fix_drydep_so2_water True to use correct surface resistance of water when calculating dry\ndeposition of SO2 logical, public :: l_fix_ukca_h2dd_x True to fix H2 deposition to shrub/soil logical, public :: l_fix_ukca_offox_h2o_fac True to fix water vapour units in B-E Offline Oxidants scheme logical, public :: l_fix_ukca_h2so4_ystore True to fix storage of H2SO4 in ASAD N-R schemes for updating in GLOMAP logical, public :: l_mode_bhn_on True for binary homogeneous sulphate nucleation logical, public :: l_mode_bln_on True for boundary layer sulphate nucleation logical, public :: l_ddepaer True for aerosol dry deposition logical, public :: l_aero_rainout True for turning on nucleation scavenging (rainout) logical, public :: l_cv_rainout True for convective rainout in UKCA logical, public :: l_impc_scav True for turning on impaction scavenging logical, public :: l_dust_mp_slinn_impc_scav True for turning on the Slinn impaction scheme for dust and\nmicroplastics logical, public :: l_ukca_primss True for primary sea-salt emissions logical, public :: l_ukca_primsu True for primary sulphate emissions logical, public :: l_ukca_primdu True for primary dust emissions logical, public :: l_ukca_primbcoc True for primary BC/OC emissions logical, public :: l_ukca_prim_moc True for primary marine OC aerosol emissions logical, public :: l_bcoc_bf True for primary biofuel BC/OC emissions logical, public :: l_bcoc_bm True for primary biomass BC/OC emissions logical, public :: l_bcoc_ff True for primary fossil fuel BC/OC emissions logical, public :: l_ukca_scale_biom_aer_ems True to apply scaling factor to biomass burning BC/OC aerosol emissions logical, public :: l_ukca_fine_no3_prod True for fine mode NO3/NH4 emissions logical, public :: l_ukca_coarse_no3_prod True for coarse mode NO3 emissions logical, public :: l_no3_prod_in_aero_step True for nitrate emissions in MODE logical, public :: l_ukca_scale_sea_salt_ems True to apply scaling factor to sea salt emissions logical, public :: l_ukca_scale_marine_pom_ems True to apply scaling factor to marine particulate organic matter logical, public :: l_ukca_mp_fragment True for microplastic fragment emissions logical, public :: l_ukca_mp_fibre True for microplastic fibre emissions logical, public :: l_ukca_radaer Provide output for calculating direct radiative effects of aerosols\nusing RADAER logical, public :: l_ntpreq_n_activ_sum True to include total number concentration of active aerosol in\nnon-transported prognostics (e.g. for combination with an external cloud\nmask for calculating CDNC in the UM hybrid resolution model) logical, public :: l_ntpreq_dryd_nuc_sol True to include to include the dry diameter for nucleation soluble mode logical, public :: l_ukca_sfix True for diagnosing UKCA CCN at fixed supersaturation logical, public :: l_fix_neg_pvol_wat True to check, trap and fix for negative values in 'pvol' and 'mdwat' logical, public :: l_fix_ukca_impscav True to fix impaction scavenging bugs logical, public :: l_fix_nacl_density True to correct sea-salt density logical, public :: l_improve_aero_drydep if True the surface type used by the aerosol dry deposition is provided\nby the parent, rather than being inferred from roughness length in\nGLOMAP. logical, public :: l_fix_ukca_water_content True to fix bugs in the calculation of aerosol water content values. logical, public :: l_fix_ukca_activate_pdf True to fix probability density fn. of updraft velocities in Activate logical, public :: l_fix_ukca_activate_vert_rep True to fix CDNC vertical replication bug in Activate logical, public :: l_bug_repro_tke_index True to reproduce effects of an old bug in the calculation of updraft\npdf spread related to TKE indexing in the Unified Model logical, public :: l_fix_ukca_hygroscopicities True to update aerosol component hygroscopicities to kappa-Kohler values\nand fix bug in calculation of volume-weighted hygroscopicity value logical, public :: l_dust_mp_ageing True for dust and microplastics being subjected to nuc scav, conden,\ncoag, ageing, and activation logical, public :: l_skip_const_setup Control argument for skipping set up of constants if already done logical, public :: l_cloud_pc2 True if the atmosphere model is using the PC2 cloud scheme logical, public :: l_strat_chem True if UKCA is using a scheme that involves stratospheric chemistry\ni.e. Std Strat, Strattrop or CRI-strat logical, public :: l_offline_photol True to read photolysis rates from offline_photol_rates_file, rather\nthan calcu