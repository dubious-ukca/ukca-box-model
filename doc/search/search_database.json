n is above level,\nfor bl_tracer_mix {UM:03071} real, public, dimension(:, :, :), allocatable :: zrzi_dsc level height as fraction of decoupled stratocumulus inversion height\nabove DSC ML base, for bl_tracer_mix {UM:03072} real, public, dimension(:, :, :), allocatable :: stcon stomatal conductance on plant functional type (m/s) {UM:03462} real, public, dimension(:, :, :), allocatable :: ls_rain3d Read more… real, public, dimension(:, :, :), allocatable :: ls_snow3d Read more… real, public, dimension(:, :, :), allocatable :: autoconv rain autoconversion rate, mass fraction (/s) {UM:04257} real, public, dimension(:, :, :), allocatable :: accretion rain accretion rate, mass fraction (/s) {UM:04258} real, public, dimension(:, :, :), allocatable :: pv_on_theta_mlevs Read more… real, public, dimension(:, :, :), allocatable :: conv_rain3d convective_rainfall_flux [CF] (kg/m&#94;2/s) {UM:05227} real, public, dimension(:, :, :), allocatable :: conv_snow3d convective_snowfall_flux [CF] (kg/m&#94;2/s) {UM:05228} real, public, dimension(:, :, :), allocatable :: so4_sa_clim sulphate aerosol surface area density (cm&#94;2/cm&#94;3) real, public, dimension(:, :, :), allocatable :: so4_aitken mass fraction of aitken mode sulfate dry aerosol expressed as sulfur in\nair {UM:00103} real, public, dimension(:, :, :), allocatable :: so4_accum mass fraction of accumulation mode sulfate dry aerosol expressed as\nsulfur in air {UM:00104} real, public, dimension(:, :, :), allocatable :: soot_fresh mass fraction of fresh black carbon dry aerosol in air {UM:00108} real, public, dimension(:, :, :), allocatable :: soot_aged mass fraction of aged black carbon dry aerosol in air {UM:00109} real, public, dimension(:, :, :), allocatable :: ocff_fresh mass fraction of fresh organic carbon from fossil fuel dry aerosol in\nair {UM:00114} real, public, dimension(:, :, :), allocatable :: ocff_aged mass fraction of aged organic carbon from fossil fuel dry aerosol in\nair (kg/kg) {UM:00115} real, public, dimension(:, :, :), allocatable :: biogenic Read more… real, public, dimension(:, :, :), allocatable :: dust_div1 mass fraction of dust division 1 dry aerosol in air {UM:00431} real, public, dimension(:, :, :), allocatable :: dust_div2 mass fraction of dust division 2 dry aerosol in air {UM:00432} real, public, dimension(:, :, :), allocatable :: dust_div3 mass fraction of dust division 3 dry aerosol in air {UM:00433} real, public, dimension(:, :, :), allocatable :: dust_div4 mass fraction of dust division 4 dry aerosol in air {UM:00434} real, public, dimension(:, :, :), allocatable :: dust_div5 mass fraction of dust division 5 dry aerosol in air {UM:00435} real, public, dimension(:, :, :), allocatable :: dust_div6 mass fraction of dust division 6 dry aerosol in air {UM:00436} real, public, dimension(:, :, :), allocatable :: sea_salt_film Read more… real, public, dimension(:, :, :), allocatable :: sea_salt_jet Read more… real, public, dimension(:, :, :), allocatable :: co2_interactive mass_fraction_of_carbon_dioxide_in_air [CF] {UM:00252} real, public, dimension(:, :, :), allocatable :: rim_cry Read more… real, public, dimension(:, :, :), allocatable :: rim_agg riming rate for ice aggregates, mass fraction (/s) {UM:04248} real, public, dimension(:, :, :), allocatable :: vertvel upward_air_velocity [CF] (m/s) {UM:00150} real, public, dimension(:, :, :), allocatable :: bl_tke turbulent kinetic energy (m&#94;2/s&#94;2) {UM:03473} real, public, dimension(:, :, :), allocatable :: interf_z altitude of grid-cell interfaces (m) real, public, dimension(:, :, :), allocatable :: grid_area_fullht grid cell area (m&#94;2), all levels real, public, dimension(:, :, :), allocatable :: grid_volume grid cell volume (m&#94;3), theta levels real, public, dimension(:, :, :), allocatable :: grid_airmass grid cell air mass (kg), theta levels real, public, dimension(:, :, :), allocatable :: rel_humid_frac relative_humidity [CF] real, public, dimension(:, :, :), allocatable :: rel_humid_frac_clr clear-sky relative humidity real, public, dimension(:, :, :), allocatable :: qsvp saturation vapour pressure of water (Pa) real, public, dimension(:, :, :), allocatable :: h2o2_offline hydrogen peroxide as offline oxidant (kg/kg-air) real, public, dimension(:, :, :), allocatable :: ho2_offline hydroperoxyl radical as offline oxidant (kg/kg-air) real, public, dimension(:, :, :), allocatable :: no3_offline nitrate radical as offline oxidant (kg/kg-air) real, public, dimension(:, :, :), allocatable :: o3_offline mass_fraction_of_ozone_in_air [CF] {UM:00060} real, public, dimension(:, :, :), allocatable :: oh_offline hydroxyl radical as offline oxidant (kg/kg-air) real, public, dimension(:, :, :), allocatable :: r_theta_levels distance from the centre of the Earth to theta levels (m) real, public, dimension(:, :, :), allocatable :: r_rho_levels distance from the centre of the Earth to rho levels (m) real, public, dimension(:, :, :), allocatable :: p_rho_levels air_pressure [CF] at rho levels (Pa) {UM:00407} real, public, dimension(:, :, :), allocatable :: aod_sulph_accum aerosol optical depth of accumulation mode sulphate, for photolysis real, public, dimension(:, :, :), allocatable :: aod_sulph_aitk aerosol optical depth of Aitken mode sulphate, for photolysis real, public, dimension(:, :, :, :), allocatable :: photol_rates photolysis rates (row_length, rows, model_levels, jppj) Subroutines public  subroutine create_box_environment_type (env) Allocate the arrays in a box environment and set every field to its\nmissing data value. The environment is passed in so that its\ndeferred-shape arrays can be allocated. Arguments Type Intent Optional Attributes Name type( box_environment_type ), intent(out) :: env The box environment to allocate and initialise public  subroutine read_box_environment_nml (filename, env) Read in the box environment namelist and store the values in the box\nenvironment type. This is used to read in the environmental fields for\nthe box model. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Path to the environment namelist file type( box_environment_type ), intent(inout) :: env environment type to store the environment public  subroutine print_box_environment (env) Print the box environment to the console. This is used for logging and\ndebugging purposes. Fields are categorised by where they are used in the\ncode, e.g. photolysis environment section will be fields used primarily\nby the photolysis code. Arguments Type Intent Optional Attributes Name type( box_environment_type ), intent(in) :: env The box environment to print public  subroutine print_ukca_environment () Print the environment fields UKCA requires, as held inside UKCA, and\nwarn about any required field that has not been set. Arguments None public  subroutine set_box_environment (env) Set the internal ukca environment using the box environment data\nstructure. The internal ukca environment will be what the ukca model\nuses when solving chemistry. Arguments Type Intent Optional Attributes Name type( box_environment_type ), intent(in) :: env the box environment, containing both fields from the input namelist\nand derived fields. public  subroutine derive_env_variables (env) Derive environment variables from the input box environment fields, and\nstore the results in the same environment type. Read more… Arguments Type Intent Optional Attributes Name type( box_environment_type ), intent(inout) :: env the box model environment from which fields will be derived and set in public  subroutine update_env_from_tracers (env_entry, tracer_ukca, tracer_name) Subroutine for updating a box environment entry with the\na current value from the tracer array. Arguments Type Intent Optional Attributes Name real, intent(inout) :: env_entry (:,:,:) The box environment field to update real, intent(in) :: tracer_ukca (:,:,:,:) The UKCA tracer array character(len=*), intent(in) :: tracer_name Name of the tracer to copy into the environment field public  subroutine update_tracer_from_env (tracer_ukca, env_entry, tracer_name) Copy a box environment entry into the matching tracer, so that the\nenvironment stays the master copy of that field (e.g. q into H2O, as\nthe UM does). Does nothing if the species is not a tracer in this\nchemistry scheme. Arguments Type Intent Optional Attributes Name real, intent(inout) :: tracer_ukca (:,:,:,:) The UKCA tracer array real, intent(in) :: env_entry (:,:,:) The box environment entry to copy into the tracer character(len=*), intent(in) :: tracer_name Name of the tracer to update","tags":"","url":"module/box_environment_mod.html"},{"title":"conversions_mod – UKCA Box Model","text":"Variables Type Visibility Attributes Name Initial real, public, parameter :: pi = 3.14159265358979323846 real, public, parameter :: pi_over_180 = pi/180.0","tags":"","url":"module/conversions_mod.html"},{"title":"fastjx_specs – UKCA Box Model","text":"Variables Type Visibility Attributes Name Initial integer, public, parameter :: photol_jlabel_len = 7 integer, public, parameter :: x_ = 100 character(len=photol_jlabel_len), public :: titlej (x_)","tags":"","url":"module/fastjx_specs.html"},{"title":"box_photol_mod – UKCA Box Model","text":"Module for handling photolysis within the box model. Uses box_config_mod umprintmgr ukca_api_mod box_debug_mod errormessagelength_mod ukca_error_mod ereport_mod Variables Type Visibility Attributes Name Initial character(len=ukca_photol_varname_len), public, pointer :: ratj_varnames (:) An array of photolysis variable names for each reaction Subroutines public  subroutine box_photol_setup (cfg) Setup up the photolysis module for the box model. This includes setting\nup the photolysis rates array, reading in the photolysis reaction data\nand setting up the photolysis scheme. Arguments Type Intent Optional Attributes Name type( box_config_type ), intent(in) :: cfg Box model configuration public  subroutine get_photol_reaction_data () Get the photolysis reaction data by calling the UKCA API to retrieve\nthe photolysis reaction data and variable names. Print the output if\ndebug level is on. Arguments None public  subroutine update_solar_pos (env) Update the solar position in the box model environment based upon the\ncurrent time and date. Arguments Type Intent Optional Attributes Name type( box_environment_type ), intent(inout) :: env The box model environment to update with the new solar position public  subroutine photol_get_rates (cfg, env) Process the photolysis rates, beginning with setup and moving onto\neither calculate the rates in an offline or online manner depending on\ncfg%l_offline_photol Arguments Type Intent Optional Attributes Name type( box_config_type ), intent(in) :: cfg the input box model configuration type( box_environment_type ), intent(inout) :: env the input box model environment, photolysis rates are stored in","tags":"","url":"module/box_photol_mod.html"},{"title":"ukca_internal_dump_mod – UKCA Box Model","text":"GENERATED FILE - DO NOT EDIT.\nGenerated by tools/gen_ukca_internal_dump.py from UKCA\napps2.2/um13.9 (4a2baa5).\nRegenerate after any UKCA upgrade. Dumps the internal UKCA config and state with box_dump_mod,\nread directly from UKCA. It never calls ukca_setup,\nukca_set_environment or ukca_step. A driver adds: if (ukca_dump_on()) call dump_ukca_internal_config()\n    after ukca_setup and photol_setup\n  if (ukca_dump_on()) call dump_ukca_step_in( )\n    immediately before ukca_step\n  if (ukca_dump_on()) call dump_ukca_step_out(tracers, ntp)\n    immediately after ukca_step See tools/gen_ukca_internal_dump.py for what is dumped. Uses box_dump_mod Interfaces public        interface dump_ukca_step_in private  subroutine dump_ukca_step_in_1d_domain(timestep_number, current_time, tracer_data, ntp_data, r_theta_levels, r_rho_levels, previous_time, eta_theta_levels) Dump the UKCA environment and every input to a ukca_step call (1D\ndomain). Call immediately before ukca_step, with the same arguments\n(excluding the error and diagnostic arguments). Arguments Type Intent Optional Attributes Name integer, intent(in) :: timestep_number integer, intent(in) :: current_time (7) real, intent(in), allocatable :: tracer_data (:,:) real, intent(in), allocatable :: ntp_data (:,:) real, intent(in) :: r_theta_levels (:,:,0:) real, intent(in) :: r_rho_levels (:,:,:) integer, intent(in), optional :: previous_time (7) real, intent(in), optional, allocatable :: eta_theta_levels (:) private  subroutine dump_ukca_step_in_3d_domain(timestep_number, current_time, tracer_data, ntp_data, r_theta_levels, r_rho_levels, previous_time, eta_theta_levels) Dump the UKCA environment and every input to a ukca_step call (3D\ndomain). Call immediately before ukca_step, with the same arguments\n(excluding the error and diagnostic arguments). Arguments Type Intent Optional Attributes Name integer, intent(in) :: timestep_number integer, intent(in) :: current_time (7) real, intent(in), allocatable :: tracer_data (:,:,:,:) real, intent(in), allocatable :: ntp_data (:,:,:,:) real, intent(in) :: r_theta_levels (:,:,0:) real, intent(in) :: r_rho_levels (:,:,:) integer, intent(in), optional :: previous_time (7) real, intent(in), optional, allocatable :: eta_theta_levels (:) public        interface dump_ukca_step_out private  subroutine dump_ukca_step_out_1d_domain(tracer_data, ntp_data) Dump the tracers returned by a ukca_step call (1D domain). Call\nimmediately after ukca_step. Arguments Type Intent Optional Attributes Name real, intent(in), allocatable :: tracer_data (:,:) real, intent(in), allocatable :: ntp_data (:,:) private  subroutine dump_ukca_step_out_3d_domain(tracer_data, ntp_data) Dump the tracers returned by a ukca_step call (3D domain). Call\nimmediately after ukca_step. Arguments Type Intent Optional Attributes Name real, intent(in), allocatable :: tracer_data (:,:,:,:) real, intent(in), allocatable :: ntp_data (:,:,:,:) Functions public  function ukca_dump_on () result(is_on) True if dumping is switched on, i.e. UKCA_DUMP_FILE is set. The dump\nfile is opened on the first call. Arguments None Return Value logical Subroutines public  subroutine dump_ukca_internal_config () Dump the internal UKCA config. Call once, after ukca_setup and\nphotol_setup. Labelled step 0. Arguments None","tags":"","url":"module/ukca_internal_dump_mod.html"},{"title":"ukca_box_model_main – UKCA Box Model","text":"Uses box_shell_mod umprintmgr ukca_api_mod box_debug_mod ereport_mod box_err_codes_mod Run the UKCA box model. The only input on the command line is the box\nconfig namelist, which names the other input files: ukca_box_model namelist.nml [--debug <level>] Variables Type Attributes Name Initial character(len=*), parameter :: prog_name = \"ukca_box_model_main\" Program name for logging and error reporting character(len=256) :: arg One command line argument character(len=256) :: namelist_path Path to the box config namelist integer :: num_args Number of command line arguments integer :: i Index of the current command line argument integer :: debug_level Debug level set by --debug integer :: iostat I/O status from reading the debug level logical :: exists Whether the namelist file exists integer :: err_code Error code for error reporting character(len=ukca_maxlen_message) :: err_msg Message for error reporting Subroutines subroutine next_argument (i, value) Advance past an option and read its value, stopping with an error if\nthe option is the last argument. Arguments Type Intent Optional Attributes Name integer, intent(inout) :: i Index of the option; on return, the index of its value character(len=256), intent(out) :: value The option's value subroutine report_usage_error (message) Print the command line usage, then stop with an error. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: message The error message subroutine print_usage () Print the command line usage. Arguments None","tags":"","url":"program/ukca_box_model_main.html"},{"title":"  general_config – UKCA Box Model\n","text":"Variables Name Type Default Description env_log_step integer None Timestep number at which environment summary diagnostics should be\nprinted to log file i_ageair_reset_method integer None Method for controlling age reset to 0 i_error_method integer None Error handling method to use i_ukca_chem integer None Chemistry scheme to use i_ukca_chem_version integer None Chemical mechanism version identifier max_ageair_reset_level integer None Max. level for reset (Method 1) model_duration integer None model duration (seconds) start_day integer None starting day of model start_hour integer None starting hour of model start_minute integer None starting minute of model start_month integer None starting month of model start_second integer None starting second of model start_year integer None starting year of model l_blankout_invalid_diags logical None True to set all non-valid diagnostic field data to missing data value l_cal360 logical None True if UKCA is expected to use a 360-day calendar for applying a top\nboundary condition in stratospheric chemistry schemes and/or for\nvalidating external emissions. (Emissions registered with a day-of-week\nscaling requirement can't be used with a 360-day calendar). l_chem_environ_co2_fld logical None True if using an external CO2 field in chemistry l_chem_environ_gas_scalars logical None True if using external values for CO2, CH4, O2, H2 and N2 in chemistry l_ctile logical None True if using partial land points at coasts l_environ_rel_humid logical None True if using external fields for relative humidity, clear-sky relative\nhumidity and/or saturation vapour pressure l_fix_ukca_cloud_frac logical None True to fix cloud_frac offset bug l_param_conv logical None True if using precipitation diagnostics from a parameterized convection\nscheme l_timer logical None True to use a timer routine for timing sub-models l_tracer_lumping logical None True to handle lumped tracers in stratospheric chemistry schemes l_ukca_ageair logical None True for age-of-air scheme l_ukca_debug_asad logical None Include additional print output specific to ASAD l_ukca_scale_ppe logical None True to turn on perturbed parameter ensemble (PPE) scaling parameters l_use_gridbox_mass logical None True to use mass of air in grid box in prognostic and/or diagnostic\ncalculations. (Note that GLOMAP-mode prognostics will run with or\nwithout this option giving equivalent but not bit-comparable results.\nThe option is required for the stratospheric chemistry schemes and for\nUM diagnostics.) l_use_gridbox_volume logical None True to use gridbox volume in diagnostic calculations. (This is required\nfor UM diagnostics and to enable use of ASAD framework diagnostics in\nnon-UM applications.) l_zon_av_ozone logical None True if external O3, used for troposphere only schemes, is expected as a\nmean value for each domain row (i.e. zonal mean if lat const. in row) max_ageair_reset_height real None Max. height (m) for reset (Method 2) max_z_for_offline_chem real None Maximum height at which to integrate chemistry with the explicit B-E\nOffline Oxidants scheme timestep real None Model timestep in seconds (an integer no of timesteps is expected in 1\nhour) delta_lambda real None EW (x) grid spacing in radians delta_phi real None NS (y) grid spacing in radians","tags":"","url":"namelist/general_config.html"},{"title":"  aerosol – UKCA Box Model\n","text":"Variables Name Type Default Description i_mode_bln_param_method integer None Parameterisation method for boundary layer nucleation 1=activation;\n2=kinetic; 3=organic mediated (as per Metzger et al, PNAS, 2010) -\nrequired when 'l_mode_bhn_on' is true. i_mode_nzts integer None No. of substeps for nucleation/sedimentation i_mode_setup integer None MODE aerosol scheme to use l_bug_repro_tke_index logical None True to reproduce effects of an old bug in the calculation of updraft\npdf spread related to TKE indexing in the Unified Model l_dust_mp_ageing logical None True for dust and microplastics being subjected to nuc scav, conden,\ncoag, ageing, and activation l_dust_mp_slinn_impc_scav logical None True for turning on the Slinn impaction scheme for dust and\nmicroplastics l_fix_nacl_density logical None True to correct sea-salt density l_fix_neg_pvol_wat logical None True to check, trap and fix for negative values in 'pvol' and 'mdwat' l_fix_ukca_activate_pdf logical None True to fix probability density fn. of updraft velocities in Activate l_fix_ukca_activate_vert_rep logical None True to fix CDNC vertical replication bug in Activate l_fix_ukca_hygroscopicities logical None True to update aerosol component hygroscopicities to kappa-Kohler values\nand fix bug in calculation of volume-weighted hygroscopicity value l_fix_ukca_impscav logical None True to fix impaction scavenging bugs l_fix_ukca_water_content logical None True to fix bugs in the calculation of aerosol water content values. l_improve_aero_drydep logical None if True the surface type used by the aerosol dry deposition is provided\nby the parent, rather than being inferred from roughness length in\nGLOMAP. l_mode_bhn_on logical None True for binary homogeneous sulphate nucleation l_mode_bln_on logical None True for boundary layer sulphate nucleation l_ntpreq_dryd_nuc_sol logical None True to include to include the dry diameter for nucleation soluble mode l_ntpreq_n_activ_sum logical None True to include total number concentration of active aerosol in\nnon-transported prognostics (e.g. for combination with an external cloud\nmask for calculating CDNC in the UM hybrid resolution model) l_ukca_mode logical None True for GLOMAP-mode aerosol scheme l_ukca_sfix logical None True for diagnosing UKCA CCN at fixed supersaturation mode_activation_dryr real None Activation dry radius (nm) mode_incld_so2_rfrac real None Fraction of in-cloud oxidised SO2 removed by precipitation sigwmin real None Lower limit for std. dev. of updraft velocity pdf used in Activate\n(default: 0.01 m/s).","tags":"","url":"namelist/aerosol.html"},{"title":"  chemistry – UKCA Box Model\n","text":"Variables Name Type Default Description dts0 integer None Backward Euler timestep (seconds) i_ukca_hetconfig integer None 0 = default (5 reactions); 1 = JPL-15 recommended coeff. 2 = JPL-15 +\nbromine reactions i_ukca_quasinewton_end integer None Iteration to stop quasi-Newton step (2-50, 3 recommended) i_ukca_quasinewton_start integer None Iteration to start quasi-Newton step (2-50, 2 recommended) i_ukca_topboundary integer None Method of treating top boundary for certain species in stratospheric\nschemes nit integer None Number of iterations for B-E Solver nrsteps integer None No. of N-R solver iterations before time step is halved l_fix_ukca_h2so4_ystore logical None True to fix storage of H2SO4 in ASAD N-R schemes for updating in GLOMAP l_fix_ukca_offox_h2o_fac logical None True to fix water vapour units in B-E Offline Oxidants scheme l_ukca_chem_aero logical None True for aerosol precursor chemistry l_ukca_classic_hetchem logical None Allows the use of heterogeneous chemistry on aerosol surfaces from\nCLASSIC within UKCA. l_ukca_het_psc logical None True for heterogeneous polar stratospheric cloud chemistry l_ukca_intph logical None True for calculating interactive cloud pH values (F for global value of\n5) l_ukca_limit_nat logical None True to limit the formation of NAT in polar stratospheric clouds\n(type 1) to heights above 1 km l_ukca_prescribech4 logical None True if prescribing surface CH4 l_ukca_quasinewton logical None True to use quasi-Newton (Broyden) method to reduce no. of iterations in\nN-R solver step l_ukca_ro2_ntp logical None True to stop transport of peroxy radicals in StratTrop/CRI scheme l_ukca_ro2_perm logical None True for RO2-permutation chemistry in StratTrop/CRI scheme l_ukca_sa_clim logical None True to use surface area density climatology for heterogeneous PSC chem. l_ukca_trophet logical None True for tropospheric het. chemistry l_use_classic_biogenic logical None True to use CLASSIC biogenic secondary organic aerosol for het. chem.\n(RAQ only) l_use_classic_ocff logical None True to use CLASSIC organic carbon from fossil fuels for het. chem.\n(RAQ only) l_use_classic_seasalt logical None True to use CLASSIC sea salt for het. chem. (RAQ only) l_use_classic_so4 logical None True to use CLASSIC SO4 for het. chem. l_use_classic_soot logical None True to use CLASSIC black carbon for het. chem. (RAQ scheme only) ph_fit_coeff_a real None value for fitting coefficient a of the interactive cloud pH code ph_fit_coeff_b real None value for fitting coefficient b of the interactive cloud pH code ph_fit_intercept real None y-intercept value of the relationship for the interactive cloud pH code","tags":"","url":"namelist/chemistry.html"},{"title":"  constants – UKCA Box Model\n","text":"Variables Name Type Default Description l_skip_const_setup logical None Control argument for skipping set up of constants if already done const_avogadro real None Configurable number of molecules in 1 mole (Avogadro constant) const_boltzmann real None Configurable Boltzmann constant (J K-1) const_lc real None Configurable latent heat of condensation of water at 0 degC (J/kg) const_rho_so4 real None Configurable density of SO4 particle (kg/m3) const_rho_water real None Configurable density of pure water (kg/m3) const_rhosea real None Configurable density of sea water (kg/m3) const_rmol real None Configurable universal gas constant R (J/mol/K) const_tfs real None Configurable temperature at which sea water freezes (K)","tags":"","url":"namelist/constants.html"},{"title":"  deposition – UKCA Box Model\n","text":"Variables Name Type Default Description i_mode_nucscav integer None Choice of nucl. scavenging coefficients: 1=original, 2=ECHAM5-HAM,\n3=as(1) but no scav of modes 6&7 l_aero_rainout logical None True for turning on nucleation scavenging (rainout) l_cv_rainout logical None True for convective rainout in UKCA l_ddepaer logical None True for aerosol dry deposition l_deposition_jules logical None True when using JULES-based interactive dry deposition routines l_fix_drydep_so2_water logical None True to use correct surface resistance of water when calculating dry\ndeposition of SO2 l_fix_improve_drydep logical None True to fix dry deposition velocities l_fix_ukca_h2dd_x logical None True to fix H2 deposition to shrub/soil l_impc_scav logical None True for turning on impaction scavenging l_ukca_ddep_lev1 logical None True to apply dry deposition losses only in level 1 l_ukca_ddepo3_ocean logical None True to use Luhar et al. (2018) oceanic O3 dry-deposition scheme l_ukca_dry_dep_so2wet logical None True if considering the impact of surface wetness on dry deposition l_ukca_drydep_off logical None True to turn off dry deposition l_ukca_intdd logical None True for interactive dry deposition l_ukca_wetdep_off logical None True to turn off wet deposition acc_cor_scav_scaling real None Scaling factor for scavenging parameters for the accumulation and coarse\nmodes dry_depvel_acc_scaling real None Scaling factor for the dry deposition velocity for the accumulation mode dry_depvel_so2_scaling real None SO2 dry deposition velocity scaling factor","tags":"","url":"namelist/deposition.html"},{"title":"  emissions – UKCA Box Model\n","text":"Variables Name Type Default Description i_inferno_emi integer None maximum INFERNO emission level i_primss_method integer None Sea-salt emission options i_ukca_dms_flux integer None Sea-air DMS exchange scheme to use i_ukca_light_param integer None Choice for flash-freq parameterisation (1 = Price & Rind, 2 = Luhar et\nal., 3 = external lightning scheme) l_bcoc_bf logical None True for primary biofuel BC/OC emissions l_bcoc_bm logical None True for primary biomass BC/OC emissions l_bcoc_ff logical None True for primary fossil fuel BC/OC emissions l_no3_prod_in_aero_step logical None True for nitrate emissions in MODE l_support_ems_gridbox_units logical None True to support the provision of offline emissions in grid-box units l_support_ems_vertprof logical None True to support full range of vertical scaling options for 2D emission\nfields. l_suppress_ems logical None True to suppress all tracer updates from emissions and boundary layer\nmixing (Emissions diagnostics are unaffected) l_ukca_coarse_no3_prod logical None True for coarse mode NO3 emissions l_ukca_emsdrvn_ch4 logical None True when running UKCA in CH4 emissions-driven mode l_ukca_fine_no3_prod logical None True for fine mode NO3/NH4 emissions l_ukca_ibvoc logical None True for interactive bVOC emissions l_ukca_inferno logical None True for INFERNO fire emissions l_ukca_inferno_ch4 logical None True for INFERNO CH4 fire emissions l_ukca_linox_scaling logical None True to use LOG(p) to distribute lightning NOx in the vertical l_ukca_mp_fibre logical None True for microplastic fibre emissions l_ukca_mp_fragment logical None True for microplastic fragment emissions l_ukca_prim_moc logical None True for primary marine OC aerosol emissions l_ukca_primbcoc logical None True for primary BC/OC emissions l_ukca_primdu logical None True for primary dust emissions l_ukca_primss logical None True for primary sea-salt emissions l_ukca_primsu logical None True for primary sulphate emissions l_ukca_qch4inter logical None True for interactive wetland CH4 emissions l_ukca_scale_biom_aer_ems logical None True to apply scaling factor to biomass burning BC/OC aerosol emissions l_ukca_scale_marine_pom_ems logical None True to apply scaling factor to marine particulate organic matter l_ukca_scale_sea_salt_ems logical None True to apply scaling factor to sea salt emissions l_ukca_scale_seadms_ems logical None Apply scaling to marine DMS emissions. l_ukca_scale_soa_yield_isop logical None Apply scaling factor to SOA production from isoprene l_ukca_scale_soa_yield_mt logical None Apply scaling factor to SOA production from monoterpene l_ukca_so2ems_expvolc logical None True for interactive expvolc emissions l_ukca_so2ems_plumeria logical None True for expvolc emissions with plumeria anth_so2_ems_scaling real None Anthropogenic SO2 emissions scaling factor biom_aer_ems_scaling real None Biomass-burning emissions scaling hno3_uptake_coeff real None HNO3 uptake coefficient for nitrate lightnox_scale_fac real None Lightning NOx emissions scaling factor marine_pom_ems_scaling real None Marine POM emission scaling factor mode_parfrac real None Fraction of SO2 emissions as aerosol(%) sea_salt_ems_scaling real None Sea salt emission scaling factor seadms_ems_scaling real None Marine DMS emission scaling factor soa_yield_scaling_isop real None Scaling factor for production of SOA from isoprene soa_yield_scaling_mt real None Scaling factor for production of SOA from monoterpene","tags":"","url":"namelist/emissions.html"},{"title":"  feedbacks – UKCA Box Model\n","text":"Variables Name Type Default Description i_ukca_activation_scheme integer None Activation scheme to use i_ukca_nwbins integer None Value of nwbins in Activate (1-20) See Rosalind West paper for details\ndoi:10.5194/acp-14-6369-2014 i_ukca_tune_bc integer None Options for tuning BC absorption via adjusting BC mass density and\nrefractive index mixing approximations l_ukca_conserve_h logical None True to include hydrogen conservation when 'l_ukca_h2o_feedback' is true l_ukca_h2o_feedback logical None True for H2O feedback from chemistry l_ukca_radaer logical None Provide output for calculating direct radiative effects of aerosols\nusing RADAER sigma_updraught_scaling real None Scaling factor for standard deviation of updraught velocities","tags":"","url":"namelist/feedbacks.html"},{"title":"  landsurface – UKCA Box Model\n","text":"Variables Name Type Default Description ntype integer None Number of surface types considered in interactive dry deposition dzsoil_layer1 real None Thickness of surface soil layer (m)","tags":"","url":"namelist/landsurface.html"},{"title":"  IO – UKCA Box Model\n","text":"Variables Name Type Default Description environment_data_file character(len=256) None path to environment namelist file initial_tracer_file character(len=256) None path to initial tracer file initial_ntp_file character(len=256) None path to initial non-transported prognostics (NTP) file offline_photol_rates_file character(len=256) None path to offline photolysis rates file output_dir character(len=256) None directory for output files, relative to the working directory (empty\nmeans the working directory)","tags":"","url":"namelist/io.html"},{"title":"  photolysis – UKCA Box Model\n","text":"Variables Name Type Default Description fastjx_mode integer None fast-jx photolysis mode above cutoff (1=lookup tables, 2=fast-jx +\nlookup tables, 3=fast-jx) fastjx_numwl integer None number of wavelengths to use in fast-jx. Options are 8, 12 or 18 i_photol_scheme integer None Photolysis scheme: 0 = off, 1 = stratospheric only, 2 = offline/2-D,\n3 = Fast-JX i_solcylc_type integer None apply solar variability to photolysis (fast-jx only). 0 = no solar\ncycle, 1 = observed cycle, 2 = average cycle. solcylc_start_year integer None 1st year for the solar cycle (used when i_solcylc_type = 1) l_cloud_pc2 logical None True if the atmosphere model is using the PC2 cloud scheme l_strat_chem logical None True if UKCA is using a scheme that involves stratospheric chemistry\ni.e. Std Strat, Strattrop or CRI-strat l_use_photolysis logical None True if UKCA is expecting to apply Photolysis rates in the solver and\nhence needs the rates from the parent fastjx_prescutoff real None Cut-off Pressure for tabulated photolysis l_offline_photol logical None True to read photolysis rates from offline_photol_rates_file, rather\nthan calculating them online","tags":"","url":"namelist/photolysis.html"},{"title":"  core_environment – UKCA Box Model\n","text":"Variables Name Type Default Description z_top_of_model real None real scalar environment fields latitude real None real 2D environment fields longitude real None real 2D environment fields tstar real None real 2D environment fields zbl real None real 2D environment fields rough_length real None real 2D environment fields seaice_frac real None real 2D environment fields pstar real None real 2D environment fields u_s real None real 2D environment fields conv_cloud_base integer None integer 2D environment fields conv_cloud_top integer None integer 2D environment fields land_sea_mask logical None logical 2D environment fields q real None real 3D environment fields qcf real None real 3D environment fields rho_r2 real None real 3D environment fields qcl real None real 3D environment fields cloud_frac real None real 3D environment fields p_layer_boundaries real None real 3D environment fields p_theta_levels real None real 3D environment fields t_theta_levels real None real 3D environment fields ls_rain3d real None real 3D environment fields ls_snow3d real None real 3D environment fields pv_on_theta_mlevs real None real 3D environment fields conv_rain3d real None real 3D environment fields conv_snow3d real None real 3D environment fields co2_interactive real None real 3D environment fields grid_volume real None real 3D environment fields grid_airmass real None real 3D environment fields rel_humid_frac real None real 3D environment fields rel_humid_frac_clr real None real 3D environment fields qsvp real None real 3D environment fields","tags":"","url":"namelist/core_environment.html"},{"title":"  photolysis_environment – UKCA Box Model\n","text":"Variables Name Type Default Description sin_declination real None real scalar environment fields equation_of_time real None real scalar environment fields conv_cloud_lwp real None real 2D environment fields surf_albedo real None real 2D environment fields conv_cloud_amount real None real 3D environment fields area_cloud_fraction real None real 3D environment fields aod_sulph_accum real None real 3D environment fields aod_sulph_aitk real None real 3D environment fields","tags":"","url":"namelist/photolysis_environment.html"},{"title":"  prescribed_conc_environment – UKCA Box Model\n","text":"Variables Name Type Default Description atmospheric_ch4 real None real scalar environment fields atmospheric_co2 real None real scalar environment fields atmospheric_h2 real None real scalar environment fields atmospheric_n2 real None real scalar environment fields atmospheric_o2 real None real scalar environment fields atmospheric_n2o real None real scalar environment fields atmospheric_cfc11 real None real scalar environment fields atmospheric_cfc12 real None real scalar environment fields atmospheric_cfc113 real None real scalar environment fields atmospheric_hcfc22 real None real scalar environment fields atmospheric_hfc125 real None real scalar environment fields atmospheric_hfc134a real None real scalar environment fields atmospheric_mebr real None real scalar environment fields atmospheric_mecl real None real scalar environment fields atmospheric_ch2br2 real None real scalar environment fields atmospheric_chbr3 real None real scalar environment fields atmospheric_cfc114 real None real scalar environment fields atmospheric_cfc115 real None real scalar environment fields atmospheric_ccl4 real None real scalar environment fields atmospheric_meccl3 real None real scalar environment fields atmospheric_hcfc141b real None real scalar environment fields atmospheric_hcfc142b real None real scalar environment fields atmospheric_h1211 real None real scalar environment fields atmospheric_h1202 real None real scalar environment fields atmospheric_h1301 real None real scalar environment fields atmospheric_h2402 real None real scalar environment fields atmospheric_cos real None real scalar environment fields","tags":"","url":"namelist/prescribed_conc_environment.html"},{"title":"  deposition_environment – UKCA Box Model\n","text":"Variables Name Type Default Description soil_moisture_layer1 real None real 1D environment fields fland real None real 1D environment fields frac_types real None real 2D environment fields laift_lp real None real 2D environment fields canhtft_lp real None real 2D environment fields tstar_tile real None real 2D environment fields z0tile_lp real None real 2D environment fields surf_hf real None real 2D environment fields surf_wetness real None real 2D environment fields l_tile_active logical None logical 2D environment fields stcon real None real 3D environment fields","tags":"","url":"namelist/deposition_environment.html"},{"title":"  emissions_environment – UKCA Box Model\n","text":"Variables Name Type Default Description ibvoc_isoprene real None real 1D environment fields ibvoc_terpene real None real 1D environment fields ibvoc_methanol real None real 1D environment fields ibvoc_acetone real None real 1D environment fields inferno_bc real None real 1D environment fields inferno_ch4 real None real 1D environment fields inferno_co real None real 1D environment fields inferno_nox real None real 1D environment fields inferno_oc real None real 1D environment fields inferno_so2 real None real 1D environment fields inferno_c2h4 real None real 1D environment fields inferno_c2h6 real None real 1D environment fields inferno_c3h8 real None real 1D environment fields inferno_hcho real None real 1D environment fields inferno_mecho real None real 1D environment fields inferno_nh3 real None real 1D environment fields inferno_dms real None real 1D environment fields zhsc real None real 2D environment fields u_scalar_10m real None real 2D environment fields ch4_wetl_emiss real None real 2D environment fields dms_sea_conc real None real 2D environment fields chloro_sea real None real 2D environment fields dust_flux_div1 real None real 2D environment fields dust_flux_div2 real None real 2D environment fields dust_flux_div3 real None real 2D environment fields dust_flux_div4 real None real 2D environment fields dust_flux_div5 real None real 2D environment fields dust_flux_div6 real None real 2D environment fields grid_surf_area real None real 2D environment fields ext_cg_flash real None real 2D environment fields ext_ic_flash real None real 2D environment fields kent integer None integer 2D environment fields kent_dsc integer None integer 2D environment fields u_rho_levels real None real 3D environment fields v_rho_levels real None real 3D environment fields geopH_on_theta_mlevs real None real 3D environment fields rhokh_rdz real None real 3D environment fields dtrdz real None real 3D environment fields we_lim real None real 3D environment fields t_frac real None real 3D environment fields zrzi real None real 3D environment fields we_lim_dsc real None real 3D environment fields t_frac_dsc real None real 3D environment fields zrzi_dsc real None real 3D environment fields dust_div1 real None real 3D environment fields dust_div2 real None real 3D environment fields dust_div3 real None real 3D environment fields dust_div4 real None real 3D environment fields dust_div5 real None real 3D environment fields dust_div6 real None real 3D environment fields interf_z real None real 3D environment fields grid_area_fullht real None real 3D environment fields","tags":"","url":"namelist/emissions_environment.html"},{"title":"  aerosol_environment – UKCA Box Model\n","text":"Variables Name Type Default Description lscat_zhang integer None integer 2D environment fields cloud_liq_frac real None real 3D environment fields autoconv real None real 3D environment fields accretion real None real 3D environment fields so4_sa_clim real None real 3D environment fields so4_aitken real None real 3D environment fields so4_accum real None real 3D environment fields soot_fresh real None real 3D environment fields soot_aged real None real 3D environment fields ocff_fresh real None real 3D environment fields ocff_aged real None real 3D environment fields biogenic real None real 3D environment fields sea_salt_film real None real 3D environment fields sea_salt_jet real None real 3D environment fields rim_cry real None real 3D environment fields rim_agg real None real 3D environment fields vertvel real None real 3D environment fields bl_tke real None real 3D environment fields","tags":"","url":"namelist/aerosol_environment.html"},{"title":"  offlinechem_environment – UKCA Box Model\n","text":"Variables Name Type Default Description h2o2_offline real None real 3D environment fields ho2_offline real None real 3D environment fields no3_offline real None real 3D environment fields o3_offline real None real 3D environment fields oh_offline real None real 3D environment fields","tags":"","url":"namelist/offlinechem_environment.html"},{"title":"ereport_mod.F90 – UKCA Box Model","text":"Source Code module ereport_mod !! Module for error reporting in the UKCA box model. Used preferentially !! over the legacy `ereport_mod.F90` module, so that it stops the model with !! a non-zero exit code if an error has occurred. implicit none private !> Public subroutine for error reporting. public ereport contains subroutine ereport ( routine_name , error_status , message ) !! Report errors, warnings, and info messages in the UKCA box model. use , intrinsic :: iso_fortran_env , only : error_unit !> The name of the routine where the error occurred. character ( len =* ), intent ( in ) :: routine_name !> The error status code. Positive for errors, negative for warnings, and !> zero for info messages. This will be reset to zero after reporting. integer , intent ( in out ) :: error_status !> The message to be reported. character ( len =* ), intent ( in ) :: message ! Take action depending on UM error status convention if ( error_status > 0 ) then write ( error_unit , '(A,A,A,A)' ) 'UKCA ERROR in ' , trim ( routine_name ), & ': ' , trim ( message ) flush ( error_unit ) ! If an error has occurred lets stop with a non-zero exit code. error stop 1 else if ( error_status < 0 ) then write ( error_unit , '(A,A,A,A)' ) 'UKCA WARNING in ' , trim ( routine_name ), & ': ' , trim ( message ) else write ( error_unit , '(A,A,A,A)' ) 'UKCA INFO in ' , trim ( routine_name ), & ': ' , trim ( message ) endif ! Reset `error_status` for warnings and info only. error_status = 0 endsubroutine ereport endmodule ereport_mod","tags":"","url":"sourcefile/ereport_mod.f90.html"},{"title":"box_time.F90 – UKCA Box Model","text":"Source Code module box_time_mod !! Module for managing the time in the UKCA box model. use umprintmgr , only : umMessage , umPrint use ereport_mod , only : ereport use ukca_api_mod , only : ukca_maxlen_procname , ukca_maxlen_message use box_err_codes_mod , only : box_errcode_invalid_time implicit none private ! public procedures public :: box_time_initialise public :: box_time_advance public :: print_date_time public :: day_time_list_format public :: get_time_midpoint !> Module name for error reporting character ( len =* ), parameter :: mod_name = \"box_time_mod\" !> Array of month names character ( len = 9 ), parameter :: month_strs ( 12 ) = [ & \"January  \" , & \"February \" , & \"March    \" , & \"April    \" , & \"May      \" , & \"June     \" , & \"July     \" , & \"August   \" , & \"September\" , & \"October  \" , & \"November \" , & \"December \" ] !> Model duration (seconds) integer , public , protected :: model_duration !> Total number of time steps integer , public , protected :: n_steps !> The duration of a time step in seconds of the model integer , public , protected :: time_step !> Index of the current time step (starts at 1) integer , public , protected :: current_step !> Elapsed model time (seconds) integer , public , protected :: current_time !> Logical to determine if the model is using a 360-day calendar logical , public , protected :: l_cal360 !> Type for storing date and time information type , public :: box_date_time !> Year integer :: year !> Month integer :: month !> Day integer :: day !> Hour integer :: hour !> Minute integer :: minute !> Seconds integer :: second endtype box_date_time !> Model initial date and time type ( box_date_time ), public , protected :: initial_date_time !> Model current date and time type ( box_date_time ), public , protected :: current_date_time !> Previous date and time type ( box_date_time ), public , protected :: previous_date_time contains subroutine box_time_initialise ( time_step_nml , & model_duration_nml , & start_year , start_month , start_day , & start_hour , start_minute , & start_second , l_360 ) !! Initialize the time manager with the time step, model duration and the !! model start date and time from the configuration namelist. Current time !! and step are set to 0. !> Time step from configuration namelist (seconds) integer , intent ( in ) :: time_step_nml !> Model duration from configuration namelist (seconds) integer , intent ( in ) :: model_duration_nml !> Model start year integer , intent ( in ) :: start_year !> Model start month integer , intent ( in ) :: start_month !> Model start day integer , intent ( in ) :: start_day !> Model start hour integer , intent ( in ) :: start_hour !> Model start minute integer , intent ( in ) :: start_minute !> Model start second integer , intent ( in ) :: start_second !> Logical indicating if the model is using a 360-day calendar logical , intent ( in ) :: l_360 !> Error code for error reporting integer :: err_code !> Final model time step integer :: final_model_time !> Name of routine for error reporting character ( len =* ), parameter :: routine_name = mod_name // & \":box_time_initialise\" !> Error message for error reporting character ( len = ukca_maxlen_message ) :: err_msg ! Set the module level logical based upon the input logical for 360 day l_cal360 = l_360 ! prevent negative time step or model duration if ( time_step_nml <= 0 ) then write ( err_msg , \"(A,I0,A)\" ) \"Invalid time step: \" , time_step_nml , & \". Must be a positive integer.\" err_code = box_errcode_invalid_time call ereport ( routine_name = routine_name , error_status = err_code , & message = err_msg ) endif if ( model_duration_nml <= 0 ) then write ( err_msg , \"(A,I0,A)\" ) \"Invalid model duration: \" , & model_duration_nml , \". Must be a positive integer.\" err_code = box_errcode_invalid_time call ereport ( routine_name = routine_name , error_status = err_code , & message = err_msg ) endif time_step = time_step_nml model_duration = model_duration_nml ! Calculate the number of required  time steps and calculate the final ! model time which may be different to the requested model duration if the ! requested model duration is not an exact multiple of the time step n_steps = model_duration / time_step_nml final_model_time = n_steps * time_step ! print to user number of time steps write ( umMessage , \"(A,I0,A)\" ) \"Model duration: \" , model_duration , & \" seconds.\" call umPrint ( umMessage , src = routine_name ) write ( umMessage , \"(A,I0,A)\" ) \"Time step: \" , time_step , \" seconds.\" call umPrint ( umMessage , src = routine_name ) write ( umMessage , \"(A,I0)\" ) \"Number of time steps: \" , n_steps call umPrint ( umMessage , src = routine_name ) if ( final_model_time /= model_duration ) then write ( umMessage , \"(A,A,I0,A)\" ) \"Requested model duration is not an \" , & \"exact multiple of the time step. Final simulated time will be \" , & final_model_time , \" seconds.\" call umPrint ( umMessage , src = routine_name ) endif ! do checks on input start parameters if ( start_month < 1 . or . start_month > 12 ) then write ( err_msg , \"(A,I0,A)\" ) \"Invalid start month: \" , start_month , & \". Must be between 1 and 12.\" err_code = box_errcode_invalid_time call ereport ( routine_name = routine_name , error_status = err_code , & message = err_msg ) endif if ( start_day < 1 . or . start_day > & days_in_month ( start_year , start_month )) then write ( err_msg , \"(A,I0,A,I0,3A,I0,A)\" ) & \"Invalid start day: \" , & start_day , & \". Must be between 1 and \" , & days_in_month ( start_year , start_month ), & \" for the month of \" , & trim ( month_strs ( start_month )), & \" in year \" , & start_year , & \".\" err_code = box_errcode_invalid_time call ereport ( routine_name = routine_name , error_status = err_code , & message = err_msg ) endif if ( start_hour < 0 . or . start_hour > 23 ) then write ( err_msg , \"(A,I0,A)\" ) \"Invalid start hour: \" , start_hour , & \". Must be between 0 and 23.\" err_code = box_errcode_invalid_time call ereport ( routine_name = routine_name , error_status = err_code , & message = err_msg ) endif if ( start_minute < 0 . or . start_minute > 59 ) then write ( err_msg , \"(A,I0,A)\" ) \"Invalid start minute: \" , start_minute , & \". Must be between 0 and 59.\" err_code = box_errcode_invalid_time call ereport ( routine_name = routine_name , error_status = err_code , & message = err_msg ) endif if ( start_second < 0 . or . start_second > 59 ) then write ( err_msg , \"(A,I0,A)\" ) \"Invalid start second: \" , start_second , & \". Must be between 0 and 59.\" err_code = box_errcode_invalid_time call ereport ( routine_name = routine_name , error_status = err_code , & message = err_msg ) endif ! initialise current step and time initial_date_time % year = start_year initial_date_time % month = start_month initial_date_time % day = start_day initial_date_time % hour = start_hour initial_date_time % minute = start_minute initial_date_time % second = start_second ! model start so current time == initial time current_date_time = initial_date_time previous_date_time = initial_date_time current_step = 0 current_time = 0 ! print initial date and time call print_date_time ( current_date_time ) endsubroutine box_time_initialise subroutine print_date_time ( date_time ) !! Print the current model date and time in a human-readable format. !> Date and time info to print type ( box_date_time ), intent ( in ) :: date_time !> Str representation of the date and time for printing character ( len = 30 ) :: date_time_str !> Routine name for printing character ( len = ukca_maxlen_procname ), parameter :: & routine_name = mod_name // \":print_date_time\" write ( date_time_str , \"(I4.4,'-', A,'-',I2.2,' ',I2.2,':',I2.2,':',I2.2)\" ) & date_time % year , trim ( month_strs ( date_time % month )), date_time % day , & date_time % hour , date_time % minute , date_time % second write ( umMessage , \"(2A)\" ) \"Current model date and time: \" , & trim ( date_time_str ) call umPrint ( umMessage , src = routine_name ) endsubroutine print_date_time subroutine box_time_advance ( step_num ) !! Advance the model time by the current time step and increment the index. !! If all time steps have been completed, an error is reported as this !! should not occur. use box_err_codes_mod , only : box_errcode_internal !> The step number to advance to (should be current_step + 1) integer , intent ( in ) :: step_num !> Routine name for printing character ( len = ukca_maxlen_procname ), parameter :: & routine_name = mod_name // \":box_time_advance\" !> Error code for reporting integer :: err_code !> Error message for reporting character ( len = ukca_maxlen_message ) :: err_msg if ( step_num /= current_step + 1 ) then write ( err_msg , \"(A,I0,A,I0)\" ) \"Time step \" , step_num , & \" is not the next time step. Current time step is \" , current_step err_code = box_errcode_internal call ereport ( routine_name , err_code , err_msg ) endif ! Advance the model time by an increment. current_step = step_num if ( current_step > n_steps ) then write ( err_msg , \"(A,I0,A,I0)\" ) \"Time step \" , current_step , & \" is outside the run: 1 to \" , n_steps err_code = box_errcode_internal call ereport ( routine_name , err_code , err_msg ) endif ! hold the previous timestep - needed for input to ukca previous_date_time = current_date_time current_time = current_step * time_step ! add the current time which is total seconds since start to the initial ! date and time to get the current date and time current_date_time = add_seconds ( initial_date_time , current_time ) ! print out the current time for the user call print_date_time ( current_date_time ) endsubroutine box_time_advance function add_seconds ( date_time , seconds ) result ( new_date_time ) !! Add a non-negative number of seconds to a date and time to produce a !! new date_time object. Will account for leap years and 360 day calendar !! if l_cal360 (module variable) is true !> The input date and time object type ( box_date_time ), intent ( in ) :: date_time !> The number of seconds to add integer , intent ( in ) :: seconds !> The resultant date and time object type ( box_date_time ) :: new_date_time !> The number of seconds in a day integer , parameter :: sec_in_day = 86400 !> The number of seconds in an hour integer , parameter :: sec_in_hour = 3600 !> The number of seconds in a minute integer , parameter :: sec_in_minute = 60 !> The total number of seconds in the input date and time plus the seconds integer :: total ! the output datetime new_date_time = date_time total = date_time % hour * sec_in_hour + date_time % minute * sec_in_minute & + date_time % second + seconds ! update the hour, minute and second based on the total number of seconds ! note values are integers so the division will be integer division new_date_time % hour = mod ( total , sec_in_day ) / sec_in_hour new_date_time % minute = mod ( total , sec_in_hour ) / sec_in_minute new_date_time % second = mod ( total , sec_in_minute ) new_date_time % day = date_time % day + total / sec_in_day ! update the month and year based on the new day value do while ( new_date_time % day > & days_in_month ( new_date_time % year , new_date_time % month )) new_date_time % day = & new_date_time % day - & days_in_month ( new_date_time % year , new_date_time % month ) ! advance a month new_date_time % month = new_date_time % month + 1 ! advance a year if the month exceeds 12 if ( new_date_time % month > 12 ) then new_date_time % month = 1 new_date_time % year = new_date_time % year + 1 endif enddo endfunction add_seconds subroutine get_time_midpoint ( time , timestep , midpoint ) !! Get the midpoint between two time steps. ! TODO - ask Luke why photolysis goes to the previous midpoint rather than ! the current midpoint !> The input date and time object type ( box_date_time ), intent ( in ) :: time !> The time step size (seconds) integer , intent ( in ) :: timestep !> The output midpoint date and time object type ( box_date_time ), intent ( out ) :: midpoint midpoint = add_seconds ( time , timestep / 2 ) endsubroutine get_time_midpoint function days_in_month ( year , month ) result ( days ) !! Return the number of days in a given month, taking into account leap !! years. Will account for 360 day calendar if l_cal360 (module variable) !! is true. !> The input year integer , intent ( in ) :: year !> The input month integer , intent ( in ) :: month !> The number of days in the year and month integer :: days !> The number of days in each month for a normal year integer , parameter :: normal_days_in_month ( 12 ) = [ 31 , 28 , 31 , 30 , 31 , 30 , & 31 , 31 , 30 , 31 , 30 , 31 ] if ( l_cal360 ) then days = 30 else if ( month /= 2 ) then days = normal_days_in_month ( month ) else days = 28 if ( mod ( year , 4 ) == 0 . and . ( mod ( year , 100 ) /= 0 . or . & mod ( year , 400 ) == 0 )) then days = 29 endif endif endif endfunction days_in_month function calc_day_of_year ( year , month , day ) result ( day_of_year ) !! Calculate the day number of the year for a given year, month and day. !! Will account for 360 day calendar if l_cal360 (module variable) is true. !> The input year integer , intent ( in ) :: year !> The input month integer , intent ( in ) :: month !> The input day integer , intent ( in ) :: day !> The calculated day number of the year integer :: day_of_year !> Month index integer :: m day_of_year = 0 do m = 1 , month - 1 day_of_year = day_of_year + days_in_month ( year , m ) enddo day_of_year = day_of_year + day endfunction calc_day_of_year function day_time_list_format ( date_time ) result ( day_time_list ) !! Format a box_date_time object into a list of integers representing: !! - [year, month, day, hour, minute, second and day of year] !> The input date and time object type ( box_date_time ), intent ( in ) :: date_time !> The output list of integers integer :: day_time_list ( 7 ) day_time_list ( 1 ) = date_time % year day_time_list ( 2 ) = date_time % month day_time_list ( 3 ) = date_time % day day_time_list ( 4 ) = date_time % hour day_time_list ( 5 ) = date_time % minute day_time_list ( 6 ) = date_time % second ! will account of 360 day calendar if l_cal360 (module variable) is true day_time_list ( 7 ) = calc_day_of_year ( date_time % year , date_time % month , & date_time % day ) endfunction day_time_list_format endmodule box_time_mod","tags":"","url":"sourcefile/box_time.f90.html"},{"title":"box_jules.F90 – UKCA Box Model","text":"Source Code module box_jules_mod !! Module for storing constants for the UKCA box model that are stored in !! the Jules model for the operational runs. To reduce the number of !! dependencies on Jules, we store the constants here in the box model !! and set them to the same values as in Jules. !! !! Note the values of each constant are dependent on the number of land types !! (ntype), which is a configuration option set by the user. setup_jules() !! must therefore be called. use ukca_missing_data_mod , only : imdi implicit none public ! TODO - frac_types is a jules variable - need to have something in here for ! it !> Module name for error reporting character ( len =* ), parameter , private :: mod_name = \"box_jules_mod\" !> number of land types integer , protected :: ntype = imdi !> No. of elevated ice types in the 27 surface type configuration integer , parameter :: n_elev_ice = 10 !> Array of indices for the elevated ice types in the 27 surface type !> configuration integer , dimension (:), allocatable , protected :: i_elev_ice !> Number of plant functional types considered in interactive dry deposition integer , protected :: npft = imdi !> Number of non-vegetation surface types integer , protected :: nnvg = imdi !> Index of surface type 'broad-leaf tree' integer , protected :: i_brd_leaf = imdi !> Index of surface type 'broad-leaf dec tree' integer , protected :: i_brd_leaf_dec = imdi !> Index of surface type 'broad-leaf eg trop tree' integer , protected :: i_brd_leaf_eg_trop = imdi !> Index of surface type 'broad-leaf eg temp tree' integer , protected :: i_brd_leaf_eg_temp = imdi !> Index of surface type 'needle-leaf tree' integer , protected :: i_ndl_leaf = imdi !> Index of surface type 'needle-leaf dec tree' integer , protected :: i_ndl_leaf_dec = imdi !> Index of surface type 'needle-leaf eg tree' integer , protected :: i_ndl_leaf_eg = imdi !> Index of surface type 'c3 grass' integer , protected :: i_c3_grass = imdi !> Index of surface type 'c3 crop' integer , protected :: i_c3_crop = imdi !> Index of surface type 'c3 pasture' integer , protected :: i_c3_pasture = imdi !> Index of surface type 'c4 grass' integer , protected :: i_c4_grass = imdi !> Index of surface type 'c4 crop' integer , protected :: i_c4_crop = imdi !> Index of surface type 'c4 pasture' integer , protected :: i_c4_pasture = imdi !> Index of surface type 'shrub' integer , protected :: i_shrub = imdi !> Index of surface type 'shrub dec' integer , protected :: i_shrub_dec = imdi !> Index of surface type 'shrub eg' integer , protected :: i_shrub_eg = imdi !> Index of surface type 'urban' integer , protected :: i_urban = imdi !> Index of surface type 'lake' integer , protected :: i_lake = imdi !> Index of surface type 'soil' integer , protected :: i_soil = imdi !> Index of surface type 'ice' integer , protected :: i_ice = imdi contains subroutine setup_jules ( ntype_in ) !! Set up the constants related to the Jules model for use by the UKCA box !! model. Takes number of land types (ntype) to determine constant values. use ereport_mod , only : ereport use ukca_api_mod , only : ukca_errcode_value_invalid , ukca_maxlen_message !> Number of land types (surface types) for the box model configuration integer , intent ( in ) :: ntype_in !> Name of the routine for error reporting character ( len =* ), parameter :: routine_name = \"setup_jules\" !> Error message for error reporting character ( len = ukca_maxlen_message ) :: error_message !> Error code for error reporting integer :: errcode !> loop index for creation of i_elev_ice array integer :: i errcode = 0 ntype = ntype_in select case ( ntype ) case ( 9 ) npft = 5 nnvg = 4 i_brd_leaf = 1 i_ndl_leaf = 2 i_c3_grass = 3 i_c4_grass = 4 i_shrub = 5 i_urban = 6 i_lake = 7 i_soil = 8 i_ice = 9 case ( 13 ) npft = 9 nnvg = 4 i_brd_leaf = 1 i_brd_leaf_dec = 2 i_brd_leaf_eg_trop = 3 i_ndl_leaf_dec = 4 i_ndl_leaf_eg = 5 i_c3_grass = 6 i_c4_grass = 7 i_shrub_dec = 8 i_shrub_eg = 9 i_urban = 10 i_lake = 11 i_soil = 12 i_ice = 13 case ( 17 ) npft = 13 nnvg = 4 i_brd_leaf_dec = 1 i_brd_leaf_eg_trop = 2 i_brd_leaf_eg_temp = 3 i_ndl_leaf_dec = 4 i_ndl_leaf_eg = 5 i_c3_grass = 6 i_c3_crop = 7 i_c3_pasture = 8 i_c4_grass = 9 i_c4_crop = 10 i_c4_pasture = 11 i_shrub_dec = 12 i_shrub_eg = 13 i_urban = 14 i_lake = 15 i_soil = 16 i_ice = 17 case ( 27 ) nnvg = 14 npft = 13 i_brd_leaf_dec = 1 i_brd_leaf_eg_trop = 2 i_brd_leaf_eg_temp = 3 i_ndl_leaf_dec = 4 i_ndl_leaf_eg = 5 i_c3_grass = 6 i_c3_crop = 7 i_c3_pasture = 8 i_c4_grass = 9 i_c4_crop = 10 i_c4_pasture = 11 i_shrub_dec = 12 i_shrub_eg = 13 i_urban = 14 i_lake = 15 i_soil = 16 i_ice = 17 ! dependent on n_elev_ice i_elev_ice = [( i , i = 18 , 17 + n_elev_ice )] case default write ( error_message , '(A,I0,A)' ) 'Unsupported ntype value: ' , ntype , & '. Supported values are: 9, 13, 17, 27' errcode = ukca_errcode_value_invalid call ereport ( mod_name // \":\" // routine_name , errcode , & error_message ) endselect endsubroutine setup_jules endmodule box_jules_mod","tags":"","url":"sourcefile/box_jules.f90.html"},{"title":"box_err_codes.F90 – UKCA Box Model","text":"Source Code module box_err_codes_mod !! Module for storing error codes for the UKCA box model. These are used !! for error reporting and handling within the box model. implicit none public ! Error codes for IO issues !> Error code for IO issues with writing tracer file integer , parameter :: box_errcode_io_tracer = 101 !> Error code for IO issues with reading NTP file integer , parameter :: box_errcode_io_ntp = 102 !> Error code for IO issues with the offline photolysis rates file. integer , parameter :: box_errcode_io_photol_offline = 103 !> Error code for issues related to the environment namelist integer , parameter :: box_errcode_env_namelist = 104 !> Error code for issues related to the box config namelist integer , parameter :: box_errcode_config_namelist = 105 ! Error codes for issues with box model arrays !> Error code for generic issues with the NTP array integer , parameter :: box_errcode_ntp = 201 !> Error code for duplicate species in the tracers array integer , parameter :: box_errcode_duplicate_species = 202 !> Error code for tracer output not allocated integer , parameter :: box_errcode_tracer_allocation = 203 !> Error code for tracer not found in array integer , parameter :: box_errcode_tracer_not_found = 204 !> Error code for duplicate ntp variable name in ntp array integer , parameter :: box_errcode_duplicate_ntp = 205 ! Error codes for configuration issues !> Error code for configuration values out of range integer , parameter :: box_errcode_config_range = 301 !> Error code for not implemented integer , parameter :: box_errcode_not_implemented = 302 !> Error code for invalid command line arguments integer , parameter :: box_errcode_command_line = 303 ! Error codes for internal box model issues !> Error code for generic internal box model issues integer , parameter :: box_errcode_internal = 401 !> Error code for invalid time integer , parameter :: box_errcode_invalid_time = 402 !> Error code for environment field number mismatch integer , parameter :: box_errcode_env_count = 403 !> Error code for environment field type integer , parameter :: box_errcode_env_type = 404 !> Error code for environment field not associated integer , parameter :: box_errcode_env_not_assoc = 405 !> Error code for non-physical calculation integer , parameter :: box_errcode_non_phys_calc = 406 endmodule box_err_codes_mod","tags":"","url":"sourcefile/box_err_codes.f90.html"},{"title":"box_debug.F90 – UKCA Box Model","text":"Source Code module box_debug_mod !! A module for managing the debug level of the box model, allowing the user !! to set and query the debug level. !! !! The debug level is an integer value that controls the verbosity of the !! output. Current debug levels: !! !! - 0 = gives no debug output, !! - 1 = basic debug output, !! - 2 = detailed debug output, !! - 3 = maximum verbosity. use ereport_mod , only : ereport use ukca_api_mod , only : ukca_maxlen_message , ukca_maxlen_procname , & ukca_errcode_value_invalid implicit none private public :: set_debug_level public :: get_debug_level public :: is_debug_level !> The current debug level for the box model. Default is 0 (no debug output). integer :: debug_level = 0 !> module name character ( len =* ), parameter :: mod_name = \"box_debug_mod\" !> The maximum debug level allowed. integer , parameter :: max_debug_level = 3 contains subroutine set_debug_level ( level ) !! Set the debug level for the box model. Higher levels may produce more !! verbose output. level 0 is not debug output. !> The debug level to set for the box model. Must be between 0 and !> max_debug_level. integer , intent ( in ) :: level !> the error code for the error message integer :: err_code !> the error message to be printed character ( len = ukca_maxlen_message ) :: error_message !> the routine name for the error message character ( len = ukca_maxlen_procname ) :: error_routine error_routine = mod_name // \":set_debug_level\" !> error code directly from ukca api err_code = ukca_errcode_value_invalid if ( level < 0 ) then write ( error_message , '(A,I0)' ) \"Debug level cannot be less \" // & \"than 0: \" , level call ereport ( error_routine , err_code , error_message ) endif if ( level > max_debug_level ) then write ( error_message , '(A,I0,A,I0)' ) \"Debug level cannot \" // & \"be greater than \" , max_debug_level , \": \" , level call ereport ( error_routine , err_code , error_message ) endif debug_level = level endsubroutine set_debug_level function get_debug_level () result ( level ) !! Get the current debug level of the box model. !> The current debug level of the box model. integer :: level level = debug_level endfunction get_debug_level function is_debug_level ( min_level ) result ( is_active ) !! Function to check if the current debug level is at least the specified !! minimum level. !> The minimum debug level to check against. integer , intent ( in ) :: min_level !> A logical value indicating whether the current debug level is at least !> the minimum level. logical :: is_active is_active = ( debug_level >= min_level ) endfunction is_debug_level endmodule box_debug_mod","tags":"","url":"sourcefile/box_debug.f90.html"},{"title":"box_ntp.F90 – UKCA Box Model","text":"Source Code module box_ntp_mod !! Module for handling non-transported prognostic variables (NTPs) in the !! UKCA box model. use ukca_api_mod , only : ukca_get_ntp_varlist , ukca_maxlen_fieldname , & ukca_maxlen_procname , ukca_maxlen_message use ereport_mod , only : ereport use umprintmgr , only : umMessage , umPrint use box_debug_mod , only : is_debug_level implicit none !> Pointer to an array containing the names of the NTP variable names character ( len = ukca_maxlen_fieldname ), pointer :: ntp_varnames (:) !> Allocatable array to hold the values of the NTP variables. The dimensions !> are (row_length, rows, model_levels, num_ntps). real , allocatable , public :: ntp_ukca (:, :, :, :) !> The module name for error reporting. character ( len =* ), parameter :: mod_name = \"box_ntp_mod\" !> The number of non-transported prognostic variables. integer , public :: num_ntps private public :: get_ntp_varnames , create_initial_ntp contains subroutine get_ntp_varnames () !! Retrieve the list of non-transported prognostic variable names from !! the UKCA API and store them in the ntp_varnames pointer. !> The error code returned by the UKCA API call. integer :: err_code !> Loop index integer :: i !> The error message for error reporting returned from !> ukca_get_ntp_varlist. character ( len = ukca_maxlen_message ) :: err_msg !> The routine name for error reporting returned from !> ukca_get_ntp_varlist. character ( len = ukca_maxlen_procname ) :: err_routine ! Initialise list pointer for safety nullify ( ntp_varnames ) ! Fetch ntp variable names from UKCA API call ukca_get_ntp_varlist ( ntp_varnames , err_code , & error_message = err_msg , error_routine = err_routine ) if ( err_code /= 0 ) then call ereport ( err_routine , err_code , err_msg ) endif ! public variable num_ntps = size ( ntp_varnames ) if ( is_debug_level ( 1 )) then ! print out each available non-transported prognostic variable do i = 1 , size ( ntp_varnames ) write ( umMessage ,( \"(3A)\" )) \"Available non-transported prognostic \" , & \"variable name: \" , ntp_varnames ( i ) call umPrint ( umMessage , src = mod_name ) enddo endif endsubroutine get_ntp_varnames subroutine create_initial_ntp ( ntp_file ) !! Create the initial values for the non-transported prognostic (ntp) !! array from a provided file. !! !! The file should contain lines of the form: <var_name> <var_value> !! !! Where <var_name> is the name of the non-transported prognostic variable !! and <var_value> is the initial value to set for that variable. If the !! variable name is \"DEFAULT\", then <var_value> will be used as the default !! value for any non-transported prognostic variable not explicitly set in !! the file. If no \"DEFAULT\" line is provided, the default value will be !! set to 1.0e-14. use box_const_mod , only : row_length , rows , model_levels use box_err_codes_mod , only : box_errcode_io_ntp , box_errcode_ntp !> The name of the file containing the values for initial non-transported !> prognostic (ntp) array character ( len =* ), intent ( in ) :: ntp_file !> A logical value indicating whether the file exists logical :: file_exists !> A logical value indicating whether the variable was found logical :: found !> The unit number for the file integer :: unit !> The I/O status for reading the file integer :: iostat_read !> The I/O status for opening the file integer :: iostat_open !> The I/O status for parsing the file integer :: iostat_parse !> The error message for error reporting character ( len = ukca_maxlen_message ) :: err_msg !> Error code for error reporting integer :: err_code !> NTP generic default real , parameter :: generic_default_value = 1.0e-14 !> The routine name for error reporting character ( len = ukca_maxlen_procname ) :: routine_name !> A line read from the file character ( len = 256 ) :: line !> The name of the variable read from the file character ( len = 256 ) :: var_name !> A logical array indicating which ntps have been provided in the file logical :: ntp_provided ( num_ntps ) !> The value of the variable read from the file real :: var_value !> The default value for any ntp not provided in the file real :: default_value !> The index of the ntp variable in the ntp_varnames array integer :: ntp_index !> Loop index integer :: i ! for error reporting routine_name = mod_name // \":create_initial_ntp\" if ( allocated ( ntp_ukca )) then deallocate ( ntp_ukca ) endif allocate ( ntp_ukca ( row_length , rows , model_levels , num_ntps )) default_value = generic_default_value ntp_index = 0 ntp_provided = . false . iostat_read = 0 iostat_open = 0 iostat_parse = 0 if ( num_ntps == 0 ) then write ( err_msg , \"(2A)\" ) \"No non-transported prognostic variables \" , & \"required to initialise. Check UKCA configuration.\" err_code = box_errcode_ntp * ( - 1 ) call ereport ( routine_name , err_code , err_msg ) return endif inquire ( file = ntp_file , exist = file_exists ) if (. not . file_exists ) then write ( err_msg , \"(3A)\" ) \"Non-transported prognostic variable file '\" , & trim ( ntp_file ), \"' does not exist.\" err_code = box_errcode_io_ntp call ereport ( routine_name , err_code , err_msg ) endif ! TODO - because this is so similar to the tracer initialisation, we ! could likely combine these into a single routine with some additional ! arguments open ( newunit = unit , file = ntp_file , status = 'old' , action = 'read' , & iostat = iostat_open ) if ( iostat_open /= 0 ) then write ( err_msg , \"(4A)\" ) \"Error opening non-transported prognostic \" , & \"variable file '\" , trim ( ntp_file ), \"'.\" err_code = box_errcode_io_ntp call ereport ( routine_name , err_code , err_msg ) endif do read ( unit , '(A)' , iostat = iostat_read ) line if ( iostat_read /= 0 ) exit ! Skip blank lines or comments. if ( len_trim ( line ) == 0 . or . line ( 1 : 1 ) == '#' ) cycle ! Read whitespace-separated tokens: <var_name> <var_value> read ( line , * , iostat = iostat_parse ) var_name , var_value if ( iostat_parse /= 0 ) then write ( err_msg , \"(3A)\" ) \"WARNING: Could not parse ntp line: '\" , & trim ( line ), \"'.\" err_code = box_errcode_io_ntp * ( - 1 ) call ereport ( routine_name , err_code , err_msg ) cycle endif if ( var_name == \"DEFAULT\" ) then default_value = var_value cycle endif ! from the list of ntp variable names, find the index of the variable call find_ntp_index ( var_name , ntp_index , found ) if ( found ) then ntp_ukca (:, :, :, ntp_index ) = var_value ntp_provided ( ntp_index ) = . true . write ( umMessage , \"(3A,E12.3,A)\" ) \"Set initial value of ntp '\" , & trim ( var_name ), \"' to \" , var_value , \".\" call umPrint ( umMessage , src = routine_name ) else write ( err_msg , \"(3A)\" ) \"WARNING: Variable '\" , trim ( var_name ), & \"' in ntp file not found in needed ntp variable list.\" err_code = box_errcode_io_ntp * ( - 1 ) call ereport ( routine_name , err_code , err_msg ) endif enddo close ( unit ) ! now use default value for unset ntps and provide warning for any ! ntps not actively being set do i = 1 , num_ntps if (. not . ntp_provided ( i )) then ntp_ukca (:, :, :, i ) = default_value write ( err_msg , & \"(3A,E12.3,A)\" ) \"WARNING: No value provided for ntp '\" , & trim ( ntp_varnames ( i )), & \"' in ntp file. Setting to default value of \" , default_value , \".\" err_code = box_errcode_io_ntp * ( - 1 ) call ereport ( routine_name , err_code , err_msg ) endif enddo endsubroutine create_initial_ntp subroutine find_ntp_index ( var_name , ntp_index , found ) !! Find the index of a non-transported prognostic variable in the !! ntp_varnames array. use box_err_codes_mod , only : box_errcode_duplicate_ntp !> The name of the non-transported prognostic variable to find. character ( len =* ), intent ( in ) :: var_name !> The index of the non-transported prognostic variable in the !> ntp_varnames array. integer , intent ( out ) :: ntp_index !> A logical value indicating whether the variable was found in the !> ntp_varnames array. logical , intent ( out ) :: found !> The error code for error reporting. integer :: err_code !> The error message for error reporting. character ( len = ukca_maxlen_message ) :: err_msg !> The name of the routine for error reporting. character ( len = ukca_maxlen_procname ) :: routine_name !> Loop index integer :: i found = . false . ntp_index = - 1 routine_name = mod_name // \":find_ntp_index\" do i = 1 , num_ntps if ( ntp_varnames ( i ) == var_name ) then if ( found ) then write ( err_msg , \"(3A)\" ) \"Duplicate variable name found in \" , & \"ntp_varnames: \" , trim ( var_name ) err_code = box_errcode_duplicate_ntp call ereport ( routine_name , err_code , err_msg ) return endif found = . true . ntp_index = i endif enddo endsubroutine find_ntp_index endmodule box_ntp_mod","tags":"","url":"sourcefile/box_ntp.f90.html"},{"title":"setup_namelist.F90 – UKCA Box Model","text":"Source Code module setup_namelist implicit none public contains subroutine setup_nml_type implicit none ! not current setup endsubroutine setup_nml_type endmodule setup_namelist","tags":"","url":"sourcefile/setup_namelist.f90.html"},{"title":"box_dump.F90 – UKCA Box Model","text":"Source Code module box_dump_mod !! Write every value passed into, or returned from, the UKCA library to a !! plain-text dump file, one value per line, so that two box models can be !! compared with `diff`. !! !! Each line is fully keyed and self-contained: !! !!     <step> <section> <name> <index> <value> !! !! e.g. !! !!     0 ukca_setup:in i_ukca_chem - 51 !!     3 ukca_step:out tracers (1,1,1,2) 9.90333269774813254E-008 3E7A9C... !! !! so dumps can also be compared after `sort` if the two models make calls !! in a different order. A real value is written twice: with 17 significant !! digits, which round-trips a double exactly, and as the 16 hex digits of !! its bits. The hex makes the comparison bit-for-bit without relying on how !! the compiler converts reals to decimal, and shows how many bits differ. !! !! This module only depends on Fortran intrinsics and ereport_mod (which !! both the old and new box models have), so the same file can be compiled !! into the old (UM/FCM) box model unchanged. !! !! Usage: !! !!     call dump_open(\"ukca_dump.txt\") !!     call dump_section(\"ukca_setup:in\", 0) !!     call dump(\"i_ukca_chem\", i_ukca_chem) !!     call dump(\"tracers\", tracer_ukca) !!     call dump_close() !! !! All dump calls are no-ops while no dump file is open. Instead of calling !! dump_open directly, a driver (or wrapper) can call dump_open_from_env, !! which opens the file named by the environment variable UKCA_DUMP_FILE, !! if set, so dumping can be switched on without changing driver code. !! !! Optional arguments that are not present, and allocatable arguments that !! are not allocated, are recorded with dump_marker as \"<absent>\" and !! \"<unallocated>\" so that differences in what is passed are also visible. use , intrinsic :: iso_fortran_env , only : int64 use ereport_mod , only : ereport implicit none private public :: dump_open public :: dump_open_from_env public :: dump_marker public :: dump_close public :: dump_is_open public :: dump_section public :: dump !> Write one variable (any supported type and rank) to the dump file interface dump procedure dump_real_0d , dump_real_1d , dump_real_2d , & dump_real_3d , dump_real_4d procedure dump_int_0d , dump_int_1d , dump_int_2d , dump_int_3d procedure dump_logical_0d , dump_logical_1d , dump_logical_2d , & dump_logical_3d procedure dump_char_0d , dump_char_1d endinterface dump !> Module name for error reporting character ( len =* ), parameter :: mod_name = \"box_dump_mod\" !> Error code for failing to open the dump file. A literal, as the old box !> model has no box_err_codes_mod. integer , parameter :: errcode_dump_open = 1 !> Minimum width the variable name is padded to, for readability only integer , parameter :: name_width = 32 !> Format for real values: 17 significant digits round-trips a double character ( len =* ), parameter :: real_fmt = \"(ES25.17E3)\" !> Environment variable naming the dump file, see dump_open_from_env character ( len =* ), parameter :: dump_env_var = \"UKCA_DUMP_FILE\" !> Unit of the open dump file, or -1 when no dump file is open integer :: dump_unit = - 1 !> Whether dump_open_from_env has already checked the environment variable logical :: env_checked = . false . !> Time step written at the start of each line, set by dump_section integer :: current_step = 0 !> Section label written on each line, set by dump_section character ( len = 64 ) :: current_section = \"unset\" contains subroutine dump_open ( filename ) !! Open (replacing) the dump file. Dumping is active until dump_close. !> Path to the dump file character ( len =* ), intent ( in ) :: filename !> I/O status from opening the file integer :: iostat !> I/O message from opening the file character ( len = 256 ) :: iomsg !> Error code for error reporting integer :: err_code !> Message for error reporting character ( len = 512 ) :: err_msg if ( dump_unit /= - 1 ) call dump_close () open ( newunit = dump_unit , file = filename , status = \"replace\" , & action = \"write\" , iostat = iostat , iomsg = iomsg ) if ( iostat /= 0 ) then write ( err_msg , \"(4A)\" ) \"Cannot open dump file '\" , trim ( filename ), & \"': \" , trim ( iomsg ) err_code = errcode_dump_open call ereport ( mod_name // \":dump_open\" , err_code , err_msg ) endif write ( dump_unit , \"(A)\" ) \"# step section name index value [hex]\" endsubroutine dump_open subroutine dump_open_from_env () !! Open the dump file named by the environment variable UKCA_DUMP_FILE, !! if it is set and non-empty. Only the first call has any effect, so it !! is cheap to call at the start of every wrapped API routine. !> Length of the environment variable's value integer :: length !> Status from reading the environment variable integer :: status !> Path to the dump file, from the environment variable character ( len = :), allocatable :: filename if ( env_checked ) return env_checked = . true . call get_environment_variable ( dump_env_var , length = length , status = status ) if ( status /= 0 . or . length == 0 ) return allocate ( character ( len = length ) :: filename ) call get_environment_variable ( dump_env_var , value = filename ) call dump_open ( filename ) endsubroutine dump_open_from_env subroutine dump_close () !! Close the dump file, if open. if ( dump_unit == - 1 ) return close ( dump_unit ) dump_unit = - 1 endsubroutine dump_close function dump_is_open () result ( is_open ) !! True if a dump file is open, i.e. dump calls will write output. !> Whether a dump file is open logical :: is_open is_open = ( dump_unit /= - 1 ) endfunction dump_is_open subroutine dump_section ( section , step ) !! Set the section label (e.g. \"ukca_step:in\") and timestep used to key !! subsequent lines. Flushes the file so a crash leaves a usable dump. !> Section label, e.g. \"ukca_step:in\" character ( len =* ), intent ( in ) :: section !> Time step integer , intent ( in ) :: step current_section = section current_step = step if ( dump_unit /= - 1 ) flush ( dump_unit ) endsubroutine dump_section subroutine dump_marker ( name , marker ) !! Write a marker in place of a value, e.g. \"<absent>\" for an optional !! argument that was not passed. !> Name of the variable character ( len =* ), intent ( in ) :: name !> Marker to write in place of the value character ( len =* ), intent ( in ) :: marker if ( dump_unit == - 1 ) return call write_line ( name , \"-\" , marker ) endsubroutine dump_marker subroutine write_line ( name , idx , value ) !! Write one dump line: step, section, name, index and value. !> Name of the variable character ( len =* ), intent ( in ) :: name !> Index of the element, e.g. \"(1,1,2)\", or \"-\" for a scalar character ( len =* ), intent ( in ) :: idx !> The value as text character ( len =* ), intent ( in ) :: value !> The step as text character ( len = 24 ) :: step_str write ( step_str , \"(I0)\" ) current_step write ( dump_unit , \"(A)\" ) trim ( step_str ) // \" \" // & trim ( current_section ) // \" \" // pad ( name ) // \" \" // idx // \" \" // & trim ( adjustl ( value )) endsubroutine write_line function pad ( name ) result ( padded ) !! Pad a variable name to at least name_width characters. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The padded name character ( len = max ( name_width , len ( name ))) :: padded padded = name endfunction pad function real_str ( value ) result ( str ) !! Full-precision text for a real: the value to 17 significant digits, !! then the 16 hex digits of its bits. A NaN is written as \"NaN:\" and its !! bits, detected from the bit pattern (comparisons on a signalling NaN !! would trip -ffpe-trap=invalid). !> The value to convert real , intent ( in ) :: value !> The value as text character ( len = 48 ) :: str !> The bits of the value integer ( int64 ) :: bits !> Mask for the exponent bits of a double integer ( int64 ), parameter :: exp_mask = int ( z \"7FF0000000000000\" , int64 ) !> Mask for the mantissa bits of a double integer ( int64 ), parameter :: man_mask = int ( z \"000FFFFFFFFFFFFF\" , int64 ) if ( storage_size ( value ) /= 64 ) then ! hex is only written for a double; the decimal is exact for any real write ( str , real_fmt ) value return endif bits = transfer ( value , bits ) if ( iand ( bits , exp_mask ) == exp_mask . and . & iand ( bits , man_mask ) /= 0_int64 ) then write ( str , \"(A, Z16.16)\" ) \"NaN:\" , bits else write ( str , \"(\" // real_fmt ( 2 : len ( real_fmt ) - 1 ) // \", 1X, Z16.16)\" ) & value , bits endif endfunction real_str function int_str ( value ) result ( str ) !! Text for an integer. !> The value to convert integer , intent ( in ) :: value !> The value as text character ( len = 24 ) :: str write ( str , \"(I0)\" ) value endfunction int_str function logical_str ( value ) result ( str ) !! Text for a logical: \"T\" or \"F\". !> The value to convert logical , intent ( in ) :: value !> The value as text character ( len = 1 ) :: str str = merge ( \"T\" , \"F\" , value ) endfunction logical_str function idx1 ( i ) result ( str ) !! Text for a 1D index, e.g. \"(3)\". !> First index integer , intent ( in ) :: i !> The index as text character ( len = 64 ) :: str str = \"(\" // trim ( int_str ( i )) // \")\" endfunction idx1 function idx2 ( i , j ) result ( str ) !! Text for a 2D index, e.g. \"(1,3)\". !> First index integer , intent ( in ) :: i !> Second index integer , intent ( in ) :: j !> The index as text character ( len = 64 ) :: str str = \"(\" // trim ( int_str ( i )) // \",\" // trim ( int_str ( j )) // \")\" endfunction idx2 function idx3 ( i , j , k ) result ( str ) !! Text for a 3D index, e.g. \"(1,1,3)\". !> First index integer , intent ( in ) :: i !> Second index integer , intent ( in ) :: j !> Third index integer , intent ( in ) :: k !> The index as text character ( len = 64 ) :: str str = \"(\" // trim ( int_str ( i )) // \",\" // trim ( int_str ( j )) // \",\" // & trim ( int_str ( k )) // \")\" endfunction idx3 function idx4 ( i , j , k , l ) result ( str ) !! Text for a 4D index, e.g. \"(1,1,1,3)\". !> First index integer , intent ( in ) :: i !> Second index integer , intent ( in ) :: j !> Third index integer , intent ( in ) :: k !> Fourth index integer , intent ( in ) :: l !> The index as text character ( len = 100 ) :: str str = \"(\" // trim ( int_str ( i )) // \",\" // trim ( int_str ( j )) // \",\" // & trim ( int_str ( k )) // \",\" // trim ( int_str ( l )) // \")\" endfunction idx4 ! Specific procedures for the generic dump interface. Array elements are ! written in Fortran (column-major) order with 1-based indices. subroutine dump_real_0d ( name , value ) !! Dump a real scalar. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The value to dump real , intent ( in ) :: value if ( dump_unit == - 1 ) return call write_line ( name , \"-\" , real_str ( value )) endsubroutine dump_real_0d subroutine dump_real_1d ( name , value ) !! Dump a 1D real array. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The values to dump real , intent ( in ) :: value (:) !> Loop index integer :: i if ( dump_unit == - 1 ) return do i = 1 , size ( value , 1 ) call write_line ( name , trim ( idx1 ( i )), real_str ( value ( i ))) enddo endsubroutine dump_real_1d subroutine dump_real_2d ( name , value ) !! Dump a 2D real array. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The values to dump real , intent ( in ) :: value (:, :) !> Loop index, first dimension integer :: i !> Loop index, second dimension integer :: j if ( dump_unit == - 1 ) return do j = 1 , size ( value , 2 ) do i = 1 , size ( value , 1 ) call write_line ( name , trim ( idx2 ( i , j )), real_str ( value ( i , j ))) enddo enddo endsubroutine dump_real_2d subroutine dump_real_3d ( name , value ) !! Dump a 3D real array. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The values to dump real , intent ( in ) :: value (:, :, :) !> Loop index, first dimension integer :: i !> Loop index, second dimension integer :: j !> Loop index, third dimension integer :: k if ( dump_unit == - 1 ) return do k = 1 , size ( value , 3 ) do j = 1 , size ( value , 2 ) do i = 1 , size ( value , 1 ) call write_line ( name , trim ( idx3 ( i , j , k )), & real_str ( value ( i , j , k ))) enddo enddo enddo endsubroutine dump_real_3d subroutine dump_real_4d ( name , value ) !! Dump a 4D real array. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The values to dump real , intent ( in ) :: value (:, :, :, :) !> Loop index, first dimension integer :: i !> Loop index, second dimension integer :: j !> Loop index, third dimension integer :: k !> Loop index, fourth dimension integer :: l if ( dump_unit == - 1 ) return do l = 1 , size ( value , 4 ) do k = 1 , size ( value , 3 ) do j = 1 , size ( value , 2 ) do i = 1 , size ( value , 1 ) call write_line ( name , trim ( idx4 ( i , j , k , l )), & real_str ( value ( i , j , k , l ))) enddo enddo enddo enddo endsubroutine dump_real_4d subroutine dump_int_0d ( name , value ) !! Dump an integer scalar. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The value to dump integer , intent ( in ) :: value if ( dump_unit == - 1 ) return call write_line ( name , \"-\" , int_str ( value )) endsubroutine dump_int_0d subroutine dump_int_1d ( name , value ) !! Dump a 1D integer array. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The values to dump integer , intent ( in ) :: value (:) !> Loop index integer :: i if ( dump_unit == - 1 ) return do i = 1 , size ( value , 1 ) call write_line ( name , trim ( idx1 ( i )), int_str ( value ( i ))) enddo endsubroutine dump_int_1d subroutine dump_int_2d ( name , value ) !! Dump a 2D integer array. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The values to dump integer , intent ( in ) :: value (:, :) !> Loop index, first dimension integer :: i !> Loop index, second dimension integer :: j if ( dump_unit == - 1 ) return do j = 1 , size ( value , 2 ) do i = 1 , size ( value , 1 ) call write_line ( name , trim ( idx2 ( i , j )), int_str ( value ( i , j ))) enddo enddo endsubroutine dump_int_2d subroutine dump_int_3d ( name , value ) !! Dump a 3D integer array. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The values to dump integer , intent ( in ) :: value (:, :, :) !> Loop index, first dimension integer :: i !> Loop index, second dimension integer :: j !> Loop index, third dimension integer :: k if ( dump_unit == - 1 ) return do k = 1 , size ( value , 3 ) do j = 1 , size ( value , 2 ) do i = 1 , size ( value , 1 ) call write_line ( name , trim ( idx3 ( i , j , k )), & int_str ( value ( i , j , k ))) enddo enddo enddo endsubroutine dump_int_3d subroutine dump_logical_0d ( name , value ) !! Dump a logical scalar. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The value to dump logical , intent ( in ) :: value if ( dump_unit == - 1 ) return call write_line ( name , \"-\" , logical_str ( value )) endsubroutine dump_logical_0d subroutine dump_logical_1d ( name , value ) !! Dump a 1D logical array. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The values to dump logical , intent ( in ) :: value (:) !> Loop index integer :: i if ( dump_unit == - 1 ) return do i = 1 , size ( value , 1 ) call write_line ( name , trim ( idx1 ( i )), logical_str ( value ( i ))) enddo endsubroutine dump_logical_1d subroutine dump_logical_2d ( name , value ) !! Dump a 2D logical array. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The values to dump logical , intent ( in ) :: value (:, :) !> Loop index, first dimension integer :: i !> Loop index, second dimension integer :: j if ( dump_unit == - 1 ) return do j = 1 , size ( value , 2 ) do i = 1 , size ( value , 1 ) call write_line ( name , trim ( idx2 ( i , j )), logical_str ( value ( i , j ))) enddo enddo endsubroutine dump_logical_2d subroutine dump_logical_3d ( name , value ) !! Dump a 3D logical array. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The values to dump logical , intent ( in ) :: value (:, :, :) !> Loop index, first dimension integer :: i !> Loop index, second dimension integer :: j !> Loop index, third dimension integer :: k if ( dump_unit == - 1 ) return do k = 1 , size ( value , 3 ) do j = 1 , size ( value , 2 ) do i = 1 , size ( value , 1 ) call write_line ( name , trim ( idx3 ( i , j , k )), & logical_str ( value ( i , j , k ))) enddo enddo enddo endsubroutine dump_logical_3d subroutine dump_char_0d ( name , value ) !! Dump a character scalar, in double quotes. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The value to dump character ( len =* ), intent ( in ) :: value if ( dump_unit == - 1 ) return call write_line ( name , \"-\" , '\"' // trim ( value ) // '\"' ) endsubroutine dump_char_0d subroutine dump_char_1d ( name , value ) !! Dump a 1D character array, each value in double quotes. !> Name of the variable character ( len =* ), intent ( in ) :: name !> The values to dump character ( len =* ), intent ( in ) :: value (:) !> Loop index integer :: i if ( dump_unit == - 1 ) return do i = 1 , size ( value , 1 ) call write_line ( name , trim ( idx1 ( i )), '\"' // trim ( value ( i )) // '\"' ) enddo endsubroutine dump_char_1d endmodule box_dump_mod","tags":"","url":"sourcefile/box_dump.f90.html"},{"title":"box_tracers.F90 – UKCA Box Model","text":"Source Code module box_tracer_mod !! Module for handling tracer variables in the UKCA box model. use ukca_api_mod , only : ukca_maxlen_fieldname , ukca_get_tracer_varlist , & ukca_maxlen_procname , ukca_maxlen_message use ereport_mod , only : ereport use umprintmgr , only : umMessage , umPrint use box_debug_mod , only : is_debug_level implicit none private public :: get_tracer_varnames , & create_initial_tracers , print_tracer_output , & initialise_output_tracers , & cleanup_tracers , add_tracers_to_output , & return_tracer , find_species_index !> Pointer to an array containing the names of the tracer variables. character ( len = ukca_maxlen_fieldname ), pointer , public , protected :: & tracer_varnames (:) !> Allocatable array to hold the values of the tracer variables. The !> dimensions are (row_length, rows, model_levels, num_tracers). real , allocatable , public :: tracer_ukca (:, :, :, :) !> Allocatable array to hold the output values of the tracer variables. The !> dimensions are (num_tracers, num_timesteps). real , allocatable , public , protected :: output_tracers (:, :) !> The module name for error reporting. character ( len =* ), parameter :: mod_name = \"box_tracer_mod\" !> The number of tracer variables. integer , public , protected :: num_tracers contains subroutine get_tracer_varnames () !! Retrieve the list of tracer variable names from the UKCA API and store !! them in the tracer_varnames pointer. !> The error code returned by the UKCA API call. integer :: err_code !> Loop index integer :: i !> The error message for error reporting returned from !> ukca_get_tracer_varlist. character ( len = ukca_maxlen_message ) :: err_msg !> The routine name for error reporting returned from !> ukca_get_tracer_varlist. character ( len = ukca_maxlen_procname ) :: err_routine ! Initialise list pointer for safety nullify ( tracer_varnames ) ! Fetch tracer variable names from UKCA API call ukca_get_tracer_varlist ( tracer_varnames , & err_code , & error_message = err_msg , & error_routine = err_routine ) if ( err_code /= 0 ) then call ereport ( err_routine , err_code , err_msg ) endif ! public variable num_tracers = size ( tracer_varnames ) if ( is_debug_level ( 1 )) then ! print out each available tracer do i = 1 , size ( tracer_varnames ) write ( umMessage , \"(2A)\" ) \"Available tracer variable name: \" , & tracer_varnames ( i ) call umPrint ( umMessage , src = mod_name ) enddo endif endsubroutine get_tracer_varnames subroutine create_initial_tracers ( tracer_file ) !! Create the initial tracer array from a provided tracer file. !! !! The tracer file should contain lines of the form: <var_name> <var_value> !! !! Where <var_name> is the name of the tracer variable and <var_value> !! is the initial value to set for that tracer. If a line with the !! variable name is \"DEFAULT\", then <var_value> will be used as the default !! value for any tracer variable not explicitly set in the file. If no !! \"DEFAULT\" line is provided, the default value will be set to 1.0e-10. use box_const_mod , only : row_length , rows , model_levels use box_err_codes_mod , only : box_errcode_io_tracer !> The name of the tracer file to read initial values from. character ( len =* ), intent ( in ) :: tracer_file !> Logical array to track which tracers have been provided in the tracer !> file. logical :: tracer_provided ( num_tracers ) !> The unit number for the file integer :: unit !> The I/O status for reading the file integer :: iostat_read !> The I/O status for opening the file integer :: iostat_open !> The I/O status for parsing the file integer :: iostat_parse !> A logical value indicating whether the file exists logical :: file_exists !> A logical value indicating whether the variable was found logical :: found !> The error message for error reporting character ( len = ukca_maxlen_message ) :: err_msg !> A line read from the file character ( len = 256 ) :: line !> The name of the variable read from the file character ( len = 256 ) :: var_name !> The value of the variable read from the file real :: var_value !> Tracer generic default real , parameter :: generic_default_value = 1.0e-10 !> The default value to use for tracers not provided in the file. real :: default_value !> The index of the tracer variable in the tracer_varnames array integer :: species_index !> The routine name for error reporting character ( len = ukca_maxlen_procname ) :: routine_name !> The error code for error reporting integer :: err_code !> Loop index integer :: i routine_name = mod_name // \":create_initial_tracers\" default_value = generic_default_value species_index = 0 iostat_read = 0 iostat_open = 0 iostat_parse = 0 tracer_provided = . false . ! deallocate tracer array if already allocated if ( allocated ( tracer_ukca )) then deallocate ( tracer_ukca ) endif allocate ( tracer_ukca ( row_length , rows , model_levels , num_tracers )) inquire ( file = tracer_file , exist = file_exists ) if (. not . file_exists ) then write ( err_msg , \"(3A)\" ) \"Tracer file '\" , trim ( tracer_file ), & \"' not found. Check box model configuration.\" err_code = box_errcode_io_tracer call ereport ( routine_name , err_code , err_msg ) endif open ( newunit = unit , file = tracer_file , status = 'old' , action = 'read' , & iostat = iostat_open ) if ( iostat_open /= 0 ) then write ( err_msg , \"(3A)\" ) \"Error opening tracer file '\" , & trim ( tracer_file ), \"'. Check box model configuration.\" err_code = box_errcode_io_tracer call ereport ( routine_name , err_code , err_msg ) endif ! read line by line of tracer file do read ( unit , '(A)' , iostat = iostat_read ) line if ( is_iostat_end ( iostat_read )) then exit elseif ( iostat_read /= 0 ) then write ( err_msg , \"(3A)\" ) \"Error reading tracer file '\" , & trim ( tracer_file ), \"'.\" err_code = box_errcode_io_tracer call ereport ( routine_name , err_code , err_msg ) endif ! Skip blank lines or comments. if ( len_trim ( line ) == 0 . or . line ( 1 : 1 ) == '#' ) cycle ! Read whitespace-separated tokens: <var_name> <var_value> read ( line , * , iostat = iostat_parse ) var_name , var_value if ( iostat_parse /= 0 ) then write ( err_msg , \"(3A)\" ) \"Could not parse tracer line: '\" , trim ( line ), & \"'.\" err_code = - box_errcode_io_tracer call ereport ( routine_name , err_code , err_msg ) cycle endif if ( var_name == \"DEFAULT\" ) then default_value = var_value cycle endif ! Find the index of the tracer variable in the tracer_varnames array call find_species_index ( var_name , species_index , found ) if ( found ) then tracer_ukca (:, :, :, species_index ) = var_value tracer_provided ( species_index ) = . true . write ( umMessage , \"(3A,E12.3E3,A)\" ) \"Set initial value of tracer '\" , & trim ( var_name ), \"' to \" , var_value , \".\" call umPrint ( umMessage , src = mod_name ) else write ( err_msg , \"(3A)\" ) \"Tracer variable '\" , trim ( var_name ), & \"' in tracer file not found in needed tracer variable list.\" err_code = - box_errcode_io_tracer call ereport ( routine_name , err_code , err_msg ) endif enddo close ( unit ) ! now use default value for unset tracers and provide warning for any ! tracers not actively being set do i = 1 , num_tracers if (. not . tracer_provided ( i )) then tracer_ukca (:, :, :, i ) = default_value write ( err_msg , \"(3A,(E12.3E3),A)\" ) & \"No value provided for tracer '\" , & trim ( tracer_varnames ( i )), \"'. Setting to default value of \" , & default_value , \".\" err_code = - box_errcode_io_tracer call ereport ( routine_name , err_code , err_msg ) endif enddo endsubroutine create_initial_tracers subroutine print_tracer_output () !! Subroutine to print the current tracer values to the log. !> Loop index integer :: i do i = 1 , num_tracers write ( umMessage , \"(2A,E15.6E3)\" ) trim ( tracer_varnames ( i )), \": \" , & tracer_ukca ( 1 , 1 , 1 , i ) call umPrint ( umMessage , src = mod_name ) enddo endsubroutine print_tracer_output subroutine find_species_index ( species_name , species_index , found ) !! Subroutine to find the index of a species in the tracer variable name !! array. Returns the index and a logical indicating if the species was !! found. If multiple matches are found, an error is reported. use box_err_codes_mod , only : box_errcode_duplicate_species !> The name of the species to find. character ( len =* ), intent ( in ) :: species_name !> The index of the species in the tracer variable name array, if found. If !> not found, this will be set to -1. integer , intent ( out ) :: species_index !> Logical indicating if the species was found in the tracer variable name !> array. logical , intent ( out ) :: found !> Error code for error reporting integer :: err_code !> Error message for error reporting character ( len = ukca_maxlen_message ) :: err_msg !> Routine name for error reporting character ( len =* ), parameter :: routine_name = & mod_name // \":find_species_index\" !> Loop index integer :: i found = . false . species_index = - 1 do i = 1 , num_tracers if ( tracer_varnames ( i ) == species_name ) then if ( found ) then write ( err_msg , '(3A)' ) \"Duplicate species '\" , trim ( species_name ), & \"' found in tracer list.\" err_code = box_errcode_duplicate_species call ereport ( routine_name , err_code , err_msg ) endif species_index = i found = . true . endif enddo endsubroutine find_species_index subroutine initialise_output_tracers ( num_timesteps ) !! Subroutine to allocate the output tracer array based on the number of !! tracers and the number of timesteps in the model run. !> The number of timesteps in the model run. integer , intent ( in ) :: num_timesteps !> First time step integer , parameter :: first_timestep = 0 if ( allocated ( output_tracers )) then deallocate ( output_tracers ) endif ! output tracers starts from timestep 0 to capture initial conditions allocate ( output_tracers ( num_tracers , 0 : num_timesteps )) ! set initial conditions at timestep 0 call add_tracers_to_output ( first_timestep ) endsubroutine initialise_output_tracers subroutine add_tracers_to_output ( timestep ) !! Subroutine to add the current tracer values to the output array for a !! given timestep. use box_err_codes_mod , only : box_errcode_tracer_allocation !> The timestep for which to add the tracer values to the output array. integer , intent ( in ) :: timestep !> Error message for error reporting character ( len = ukca_maxlen_message ) :: err_msg !> Routine name for error reporting character ( len =* ), parameter :: routine_name = & mod_name // \":add_tracers_to_output\" !> Error code for error reporting integer :: err_code if (. not . allocated ( output_tracers )) then write ( err_msg , \"(A)\" ) \"Output tracer array not allocated. Call \" // & \"initialise_output_tracers first.\" err_code = box_errcode_tracer_allocation call ereport ( routine_name , err_code , err_msg ) endif output_tracers (:, timestep ) = tracer_ukca ( 1 , 1 , 1 , :) endsubroutine add_tracers_to_output subroutine cleanup_tracers () !! Subroutine to deallocate the tracer arrays and nullify var name pointer. if ( allocated ( tracer_ukca )) then deallocate ( tracer_ukca ) endif if ( allocated ( output_tracers )) then deallocate ( output_tracers ) endif nullify ( tracer_varnames ) endsubroutine cleanup_tracers subroutine return_tracer ( tracer_name , tracer ) !! Subroutine to return the value of a tracer variable given its name. !! If not found the routine will error. use box_err_codes_mod , only : box_errcode_tracer_not_found !> The name of the tracer variable to return. character ( len =* ), intent ( in ) :: tracer_name !> The value of the tracer variable. real , intent ( out ) :: tracer !> Error code for error reporting integer :: err_code !> Species index in the tracer variable name array integer :: species_index !> Logical indicating if the species was found in the available tracers logical :: found !> Error message for error reporting character ( len = ukca_maxlen_message ) :: err_msg !> Routine name for error reporting character ( len =* ), parameter :: routine_name = & mod_name // \":return_tracer\" call find_species_index ( tracer_name , species_index , found ) if ( found ) then tracer = tracer_ukca ( 1 , 1 , 1 , species_index ) else write ( err_msg , \"(3A)\" ) \"Tracer '\" , trim ( tracer_name ), & \"' not found in tracer variable list.\" err_code = box_errcode_tracer_not_found call ereport ( routine_name , err_code , err_msg ) endif endsubroutine return_tracer endmodule box_tracer_mod","tags":"","url":"sourcefile/box_tracers.f90.html"},{"title":"box_const.F90 – UKCA Box Model","text":"Source Code module box_const_mod !! Module containing constants for the UKCA box model. use ukca_api_mod , only : ukca_strat_lbc_env use , intrinsic :: iso_c_binding , only : c_double implicit none public !> c iso binding of real 64 bit integer , parameter , private :: real64 = c_double !> dimension 1 - x integer , parameter :: row_length = 1 !> dimension 2 - y integer , parameter :: rows = 1 !> dimension 3 - z integer , parameter :: model_levels = 1 !> No of boundary layer levels integer , parameter :: bl_levels = 1 !> Number of grid levels for entrainment-related fields used by tr_mix integer , parameter :: nlev_ent_tr_mix = 3 !> Number of land points integer , parameter :: land_points = 1 !> use in photolysis - Number of CCA levels integer , parameter :: n_cca_lev = 0 ! RW - TODO - this will be dependent on the equivalent logical - need to add ! validator !> The level at which to fix the tropopause height in the box model. integer , parameter :: fixed_tropopause_level = 1 !> Grid points per segment for the column-based chemical solver integer , parameter :: ukca_chem_seg_size = 1 !> Columns per segment for aerosol integer , parameter :: ukca_mode_seg_size = 1 !> Number of levels above tropopause at which to start overwriting O3 and !> HNO3 with values derived from O3 data in troposphere only schemes integer , parameter :: nlev_above_trop_o3_env = 2 !> Number of top levels at which to apply stratospheric CH4 loss rate in !> troposphere only schemes integer , parameter :: nlev_ch4_stratloss = 1 !> Logical to fix the tropopause level in the box model. logical , parameter :: l_fix_tropopause_level = . true . !> STASH diagnostics always off in box model logical , parameter :: l_enable_diag_um = . false . !> If True no saving of horizontal arrays between timesteps logical , parameter :: l_ukca_persist_off = . false . !> No emissions currently in box model - True to turn off emissions logical , parameter :: l_ukca_emissions_off = . true . !> Box model doesn't pass to um but we set this to true anyway logical , parameter :: l_ukca_asad_columns = . true . ! TODO - change below to true when the co2_interactive issue is fixed in ukca !> Box model doesn't pass to um but we set this to true anyway logical , parameter :: l_ukca_asad_full = . false . !> True to explicitly enable marine DMS emissions - (deprecated redundant !> setting; if omitted from 'ukca_setup' call DMS emissions are enabled or !> disabled according to the value of 'i_ukca_dms_flux') logical , parameter :: l_ukca_enable_seadms_ems = . true . ! convenience constants !> mathematical pi real , parameter :: const_pi = 3.14159265358979323846 !> mathematical pi divided by 180.0 degrees real , parameter :: const_pi_over_180 = const_pi / 18 0.0 !> the reciprocal of mathematical pi divided by 180.0 degrees real , parameter :: const_recip_pi_over_180 = 18 0.0 / const_pi !> True if Convective Cloud Amount is calculated as a 3-D field, i.e. loop !> over n_cca_lev, else use only first level from cca array. logical , parameter :: l_3d_cca = . false . !> Use O2 + hv -> O(3P) + O(3P) photolysis rate from Socrates logical , parameter :: l_environ_jo2 = . false . !> Use O2 + hv -> O(1D) + O(3P) photolysis rate from Socrates logical , parameter :: l_environ_jo2b = . false . !> True if z_top_of_model is being supplied by parent model logical , parameter :: l_environ_z_top = . false . ! TODO - we should facilitate differing planet constants ! planet constants !> Mean scale height for pressure real , parameter :: sclht = 6.8e+03 !> Gas constant for dry air real , parameter :: earth_r = 28 7.05 !> Earth radius in metres real , parameter :: earth_radius = 637122 9.0 !> Specific heat of dry air at constant pressure real , parameter :: earth_cp = 100 5.0 !> Ratio of gas constant to specific heat real , parameter :: kappa = earth_r / earth_cp !> Reference surface pressure real , parameter :: earth_pref = 10000 0.0 !> repsilon, ratio of molecular weights of water and dry air real , parameter :: earth_repsilon = 0.62198 !> 1.0/repsilon-1.0 real , parameter :: c_virtual = 1.0 / earth_repsilon - 1.0 !> only ever use strat lbc from env (um scenario) integer , parameter :: i_strat_lbc_source = ukca_strat_lbc_env !> placeholder for JO2 rates from Radiation real , parameter :: rad_ctl_jo2 ( row_length , rows , model_levels ) = 0.0 !> placeholder for JO2B rates from Radiation real , parameter :: rad_ctl_jo2b ( row_length , rows , model_levels ) = 0.0 !> hours in a day real ( kind = real64 ), parameter :: rhour_per_day_const = 2 4.0_real64 endmodule box_const_mod","tags":"","url":"sourcefile/box_const.f90.html"},{"title":"box_io.F90 – UKCA Box Model","text":"Source Code module box_io_mod !! Module for input/output operations in the UKCA box model. implicit none !> Module name for error reporting character ( len =* ), parameter :: mod_name = \"box_io_mod\" public :: write_tracer_output private contains subroutine write_tracer_output ( filename ) !! Write the tracer output array to a csv file. use box_tracer_mod , only : output_tracers , num_tracers , tracer_varnames use box_time_mod , only : n_steps use ukca_api_mod , only : ukca_maxlen_message use box_err_codes_mod , only : box_errcode_io_tracer use umprintmgr , only : umMessage , umPrint use ereport_mod , only : ereport !> The name of the output file to write the tracer data to. character ( len =* ), intent ( in ) :: filename !> the I/O status code returned by the open statement integer :: iostat !> Loop index integer :: i !> Loop index integer :: j !> Error code for reporting I/O errors with the tracer output file integer :: err_code !> I/O unit number for the output file integer :: unit !> Message for error reporting character ( len = ukca_maxlen_message ) :: error_message !> Routine name for error reporting character ( len =* ), parameter :: routine_name = \"write_tracer_output\" err_code = 0 write ( umMessage , '(A,A)' ) 'Writing tracer output to file: ' , trim ( filename ) call umPrint ( umMessage , src = mod_name // \":\" // routine_name ) open ( newunit = unit , file = filename , status = 'replace' , action = 'write' , & iostat = iostat ) if ( iostat /= 0 ) then write ( error_message , '(A,A)' ) 'Error opening file: ' , & trim ( adjustl ( filename )) err_code = box_errcode_io_tracer ! Call error call ereport ( mod_name // \":\" // routine_name , err_code , & trim ( error_message )) endif ! Write header line with tracer variable names write ( unit , '(A)' , advance = 'no' ) 'TimeStep' do i = 1 , num_tracers write ( unit , '(2A)' , advance = 'no' ) ',' , trim ( tracer_varnames ( i )) enddo write ( unit , '(A)' ) '' ! Write tracer data for each time step do i = 0 , n_steps ! Time step number write ( unit , '(I0)' , advance = 'no' ) i do j = 1 , num_tracers write ( unit , '(A,E15.6E3)' , advance = 'no' ) ',' , output_tracers ( j , i ) enddo write ( unit , '(A)' ) '' enddo close ( unit ) endsubroutine write_tracer_output endmodule box_io_mod","tags":"","url":"sourcefile/box_io.f90.html"},{"title":"box_config.F90 – UKCA Box Model","text":"Source Code module box_config_mod !! Module for reading, validating and printing the box model configuration. !! Box model configurations are read from a user-provided namelist file and !! are stored in a box_config_type type, which is used to control the !! behaviour of the box model and UKCA. use umprintmgr , only : umMessage , umPrint use ereport_mod , only : ereport use ukca_api_mod , only : ukca_maxlen_message , ukca_maxlen_procname implicit none private public :: read_box_config public :: print_box_config public :: output_file_path !> Module name for logging and error reporting character ( len =* ), parameter :: mod_name = \"box_config_mod\" interface print_field procedure print_field_int procedure print_field_real procedure print_field_logical procedure print_field_char endinterface print_field !> All the box model configuration options, read from the box config !> namelist type , public :: box_config_type !> model duration (seconds) integer :: model_duration !> starting year of model integer :: start_year !> starting month of model integer :: start_month !> starting day of model integer :: start_day !> starting hour of model integer :: start_hour !> starting minute of model integer :: start_minute !> starting second of model integer :: start_second !> Chemistry scheme to use integer :: i_ukca_chem !> Chemical mechanism version identifier integer :: i_ukca_chem_version !> No. of N-R solver iterations before time step is halved integer :: nrsteps !> Chemical timestep in seconds for N-R and offline oxidant schemes integer :: chem_timestep !> Backward Euler timestep (seconds) integer :: dts0 !> Method for controlling age reset to 0 integer :: i_ageair_reset_method !> Max. level for reset (Method 1) integer :: max_ageair_reset_level !> Error handling method to use integer :: i_error_method !> Number of iterations for B-E Solver integer :: nit !> Iteration to start quasi-Newton step (2-50, 2 recommended) integer :: i_ukca_quasinewton_start !> Iteration to stop quasi-Newton step (2-50, 3 recommended) integer :: i_ukca_quasinewton_end !> Method of treating top boundary for certain species in stratospheric !> schemes integer :: i_ukca_topboundary !> 0 = default (5 reactions); 1 = JPL-15 recommended coeff. 2 = JPL-15 + !> bromine reactions integer :: i_ukca_hetconfig !> maximum INFERNO emission level integer :: i_inferno_emi !> Sea-air DMS exchange scheme to use integer :: i_ukca_dms_flux !> Choice for flash-freq parameterisation (1 = Price & Rind, 2 = Luhar et !> al., 3 = external lightning scheme) integer :: i_ukca_light_param !> Photolysis scheme: 0 = off, 1 = stratospheric only, 2 = offline/2-D, !> 3 = Fast-JX integer :: i_photol_scheme !> Timestep number at which environment summary diagnostics should be !> printed to log file integer :: env_log_step !> Options for tuning BC absorption via adjusting BC mass density and !> refractive index mixing approximations integer :: i_ukca_tune_bc !> Sea-salt emission options integer :: i_primss_method !> No. of substeps for nucleation/sedimentation integer :: i_mode_nzts !> MODE aerosol scheme to use integer :: i_mode_setup !> Parameterisation method for boundary layer nucleation 1=activation; !> 2=kinetic; 3=organic mediated (as per Metzger et al, PNAS, 2010) - !> required when 'l_mode_bhn_on' is true. integer :: i_mode_bln_param_method !> Choice of nucl. scavenging coefficients: 1=original, 2=ECHAM5-HAM, !> 3=as(1) but no scav of modes 6&7 integer :: i_mode_nucscav !> Activation scheme to use integer :: i_ukca_activation_scheme !> Value of nwbins in Activate (1-20) See Rosalind West paper for details !> doi:10.5194/acp-14-6369-2014 integer :: i_ukca_nwbins !> Number of surface types considered in interactive dry deposition integer :: ntype !> fast-jx photolysis mode above cutoff (1=lookup tables, 2=fast-jx + !> lookup tables, 3=fast-jx) integer :: fastjx_mode !> number of wavelengths to use in fast-jx. Options are 8, 12 or 18 integer :: fastjx_numwl !> apply solar variability to photolysis (fast-jx only). 0 = no solar !> cycle, 1 = observed cycle, 2 = average cycle. integer :: i_solcylc_type !> 1st year for the solar cycle (used when i_solcylc_type = 1) integer :: solcylc_start_year !> Thickness of surface soil layer (m) real :: dzsoil_layer1 !> Model timestep in seconds (an integer no of timesteps is expected in 1 !> hour) real :: timestep !> Max. height (m) for reset (Method 2) real :: max_ageair_reset_height !> Maximum height at which to integrate chemistry with the explicit B-E !> Offline Oxidants scheme real :: max_z_for_offline_chem !> Cut-off Pressure for tabulated photolysis real :: fastjx_prescutoff !> Fraction of SO2 emissions as aerosol(%) real :: mode_parfrac !> Marine DMS emission scaling factor real :: seadms_ems_scaling !> Sea salt emission scaling factor real :: sea_salt_ems_scaling !> Marine POM emission scaling factor real :: marine_pom_ems_scaling !> Lightning NOx emissions scaling factor real :: lightnox_scale_fac !> Anthropogenic SO2 emissions scaling factor real :: anth_so2_ems_scaling !> Scaling factor for production of SOA from monoterpene real :: soa_yield_scaling_mt !> Scaling factor for production of SOA from isoprene real :: soa_yield_scaling_isop !> SO2 dry deposition velocity scaling factor real :: dry_depvel_so2_scaling !> Activation dry radius (nm) real :: mode_activation_dryr !> Scaling factor for the dry deposition velocity for the accumulation mode real :: dry_depvel_acc_scaling !> Scaling factor for scavenging parameters for the accumulation and coarse !> modes real :: acc_cor_scav_scaling !> Fraction of in-cloud oxidised SO2 removed by precipitation real :: mode_incld_so2_rfrac !> Biomass-burning emissions scaling real :: biom_aer_ems_scaling !> value for fitting coefficient a of the interactive cloud pH code real :: ph_fit_coeff_a !> value for fitting coefficient b of the interactive cloud pH code real :: ph_fit_coeff_b !> y-intercept value of the relationship for the interactive cloud pH code real :: ph_fit_intercept !> Lower limit for std. dev. of updraft velocity pdf used in Activate !> (default: 0.01 m/s). real :: sigwmin !> HNO3 uptake coefficient for nitrate real :: hno3_uptake_coeff !> Scaling factor for standard deviation of updraught velocities real :: sigma_updraught_scaling !> Configurable universal gas constant R (J/mol/K) real :: const_rmol !> Configurable temperature at which sea water freezes (K) real :: const_tfs !> Configurable density of pure water (kg/m3) real :: const_rho_water !> Configurable density of sea water (kg/m3) real :: const_rhosea !> Configurable latent heat of condensation of water at 0 degC (J/kg) real :: const_lc !> Configurable number of molecules in 1 mole (Avogadro constant) real :: const_avogadro !> Configurable Boltzmann constant (J K-1) real :: const_boltzmann !> Configurable density of SO4 particle (kg/m3) real :: const_rho_so4 !> EW (x) grid spacing in radians real :: delta_lambda !> NS (y) grid spacing in radians real :: delta_phi !> True if UKCA is expected to use a 360-day calendar for applying a top !> boundary condition in stratospheric chemistry schemes and/or for !> validating external emissions. (Emissions registered with a day-of-week !> scaling requirement can't be used with a 360-day calendar). logical :: l_cal360 !> True for aerosol precursor chemistry logical :: l_ukca_chem_aero !> True for GLOMAP-mode aerosol scheme logical :: l_ukca_mode !> True for age-of-air scheme logical :: l_ukca_ageair !> True to set all non-valid diagnostic field data to missing data value logical :: l_blankout_invalid_diags !> True to use a timer routine for timing sub-models logical :: l_timer !> True to turn on perturbed parameter ensemble (PPE) scaling parameters logical :: l_ukca_scale_ppe !> True to turn off dry deposition logical :: l_ukca_drydep_off !> True to turn off wet deposition logical :: l_ukca_wetdep_off !> Include additional print output specific to ASAD logical :: l_ukca_debug_asad !> True for interactive dry deposition logical :: l_ukca_intdd !> True to use Luhar et al. (2018) oceanic O3 dry-deposition scheme logical :: l_ukca_ddepo3_ocean !> True to apply dry deposition losses only in level 1 logical :: l_ukca_ddep_lev1 !> True if considering the impact of surface wetness on dry deposition logical :: l_ukca_dry_dep_so2wet !> True when using JULES-based interactive dry deposition routines logical :: l_deposition_jules !> True to use quasi-Newton (Broyden) method to reduce no. of iterations in !> N-R solver step logical :: l_ukca_quasinewton !> True to handle lumped tracers in stratospheric chemistry schemes logical :: l_tracer_lumping !> True to stop transport of peroxy radicals in StratTrop/CRI scheme logical :: l_ukca_ro2_ntp !> True for RO2-permutation chemistry in StratTrop/CRI scheme logical :: l_ukca_ro2_perm !> True for calculating interactive cloud pH values (F for global value of !> 5) logical :: l_ukca_intph !> True for heterogeneous polar stratospheric cloud chemistry logical :: l_ukca_het_psc !> True to limit the formation of NAT in polar stratospheric clouds !> (type 1) to heights above 1 km logical :: l_ukca_limit_nat !> True to use surface area density climatology for heterogeneous PSC chem. logical :: l_ukca_sa_clim !> True for tropospheric het. chemistry logical :: l_ukca_trophet !> Allows the use of heterogeneous chemistry on aerosol surfaces from !> CLASSIC within UKCA. logical :: l_ukca_classic_hetchem !> True if UKCA is expecting to apply Photolysis rates in the solver and !> hence needs the rates from the parent logical :: l_use_photolysis !> True for interactive bVOC emissions logical :: l_ukca_ibvoc !> True for INFERNO fire emissions logical :: l_ukca_inferno !> True for INFERNO CH4 fire emissions logical :: l_ukca_inferno_ch4 !> True for interactive expvolc emissions logical :: l_ukca_so2ems_expvolc !> True for expvolc emissions with plumeria logical :: l_ukca_so2ems_plumeria !> True for interactive wetland CH4 emissions logical :: l_ukca_qch4inter !> True when running UKCA in CH4 emissions-driven mode logical :: l_ukca_emsdrvn_ch4 !> Apply scaling to marine DMS emissions. logical :: l_ukca_scale_seadms_ems !> True to use LOG(p) to distribute lightning NOx in the vertical logical :: l_ukca_linox_scaling !> Apply scaling factor to SOA production from monoterpene logical :: l_ukca_scale_soa_yield_mt !> Apply scaling factor to SOA production from isoprene logical :: l_ukca_scale_soa_yield_isop !> True to support full range of vertical scaling options for 2D emission !> fields. logical :: l_support_ems_vertprof !> True to support the provision of offline emissions in grid-box units logical :: l_support_ems_gridbox_units !> True to suppress all tracer updates from emissions and boundary layer !> mixing (Emissions diagnostics are unaffected) logical :: l_suppress_ems !> True for H2O feedback from chemistry logical :: l_ukca_h2o_feedback !> True if using precipitation diagnostics from a parameterized convection !> scheme logical :: l_param_conv !> True if using partial land points at coasts logical :: l_ctile !> True if external O3, used for troposphere only schemes, is expected as a !> mean value for each domain row (i.e. zonal mean if lat const. in row) logical :: l_zon_av_ozone !> True to include hydrogen conservation when 'l_ukca_h2o_feedback' is true logical :: l_ukca_conserve_h !> True if using external values for CO2, CH4, O2, H2 and N2 in chemistry logical :: l_chem_environ_gas_scalars !> True if using an external CO2 field in chemistry logical :: l_chem_environ_co2_fld !> True if prescribing surface CH4 logical :: l_ukca_prescribech4 !> True to use CLASSIC SO4 for het. chem. logical :: l_use_classic_so4 !> True to use CLASSIC black carbon for het. chem. (RAQ scheme only) logical :: l_use_classic_soot !> True to use CLASSIC organic carbon from fossil fuels for het. chem. !> (RAQ only) logical :: l_use_classic_ocff !> True to use CLASSIC biogenic secondary organic aerosol for het. chem. !> (RAQ only) logical :: l_use_classic_biogenic !> True to use CLASSIC sea salt for het. chem. (RAQ only) logical :: l_use_classic_seasalt !> True to use gridbox volume in diagnostic calculations. (This is required !> for UM diagnostics and to enable use of ASAD framework diagnostics in !> non-UM applications.) logical :: l_use_gridbox_volume !> True to use mass of air in grid box in prognostic and/or diagnostic !> calculations. (Note that GLOMAP-mode prognostics will run with or !> without this option giving equivalent but not bit-comparable results. !> The option is required for the stratospheric chemistry schemes and for !> UM diagnostics.) logical :: l_use_gridbox_mass !> True if using external fields for relative humidity, clear-sky relative !> humidity and/or saturation vapour pressure logical :: l_environ_rel_humid !> True to fix cloud_frac offset bug logical :: l_fix_ukca_cloud_frac !> True to fix dry deposition velocities logical :: l_fix_improve_drydep !> True to use correct surface resistance of water when calculating dry !> deposition of SO2 logical :: l_fix_drydep_so2_water !> True to fix H2 deposition to shrub/soil logical :: l_fix_ukca_h2dd_x !> True to fix water vapour units in B-E Offline Oxidants scheme logical :: l_fix_ukca_offox_h2o_fac !> True to fix storage of H2SO4 in ASAD N-R schemes for updating in GLOMAP logical :: l_fix_ukca_h2so4_ystore !> True for binary homogeneous sulphate nucleation logical :: l_mode_bhn_on !> True for boundary layer sulphate nucleation logical :: l_mode_bln_on !> True for aerosol dry deposition logical :: l_ddepaer !> True for turning on nucleation scavenging (rainout) logical :: l_aero_rainout !> True for convective rainout in UKCA logical :: l_cv_rainout !> True for turning on impaction scavenging logical :: l_impc_scav !> True for turning on the Slinn impaction scheme for dust and !> microplastics logical :: l_dust_mp_slinn_impc_scav !> True for primary sea-salt emissions logical :: l_ukca_primss !> True for primary sulphate emissions logical :: l_ukca_primsu !> True for primary dust emissions logical :: l_ukca_primdu !> True for primary BC/OC emissions logical :: l_ukca_primbcoc !> True for primary marine OC aerosol emissions logical :: l_ukca_prim_moc !> True for primary biofuel BC/OC emissions logical :: l_bcoc_bf !> True for primary biomass BC/OC emissions logical :: l_bcoc_bm !> True for primary fossil fuel BC/OC emissions logical :: l_bcoc_ff !> True to apply scaling factor to biomass burning BC/OC aerosol emissions logical :: l_ukca_scale_biom_aer_ems !> True for fine mode NO3/NH4 emissions logical :: l_ukca_fine_no3_prod !> True for coarse mode NO3 emissions logical :: l_ukca_coarse_no3_prod !> True for nitrate emissions in MODE logical :: l_no3_prod_in_aero_step !> True to apply scaling factor to sea salt emissions logical :: l_ukca_scale_sea_salt_ems !> True to apply scaling factor to marine particulate organic matter logical :: l_ukca_scale_marine_pom_ems !> True for microplastic fragment emissions logical :: l_ukca_mp_fragment !> True for microplastic fibre emissions logical :: l_ukca_mp_fibre !> Provide output for calculating direct radiative effects of aerosols !> using RADAER logical :: l_ukca_radaer !> True to include total number concentration of active aerosol in !> non-transported prognostics (e.g. for combination with an external cloud !> mask for calculating CDNC in the UM hybrid resolution model) logical :: l_ntpreq_n_activ_sum !> True to include to include the dry diameter for nucleation soluble mode logical :: l_ntpreq_dryd_nuc_sol !> True for diagnosing UKCA CCN at fixed supersaturation logical :: l_ukca_sfix !> True to check, trap and fix for negative values in 'pvol' and 'mdwat' logical :: l_fix_neg_pvol_wat !> True to fix impaction scavenging bugs logical :: l_fix_ukca_impscav !> True to correct sea-salt density logical :: l_fix_nacl_density !> if True the surface type used by the aerosol dry deposition is provided !> by the parent, rather than being inferred from roughness length in !> GLOMAP. logical :: l_improve_aero_drydep !> True to fix bugs in the calculation of aerosol water content values. logical :: l_fix_ukca_water_content !> True to fix probability density fn. of updraft velocities in Activate logical :: l_fix_ukca_activate_pdf !> True to fix CDNC vertical replication bug in Activate logical :: l_fix_ukca_activate_vert_rep !> True to reproduce effects of an old bug in the calculation of updraft !> pdf spread related to TKE indexing in the Unified Model logical :: l_bug_repro_tke_index !> True to update aerosol component hygroscopicities to kappa-Kohler values !> and fix bug in calculation of volume-weighted hygroscopicity value logical :: l_fix_ukca_hygroscopicities !> True for dust and microplastics being subjected to nuc scav, conden, !> coag, ageing, and activation logical :: l_dust_mp_ageing !> Control argument for skipping set up of constants if already done logical :: l_skip_const_setup !> True if the atmosphere model is using the PC2 cloud scheme logical :: l_cloud_pc2 !> True if UKCA is using a scheme that involves stratospheric chemistry !> i.e. Std Strat, Strattrop or CRI-strat logical :: l_strat_chem !> True to read photolysis rates from offline_photol_rates_file, rather !> than calculating them online logical :: l_offline_photol !> path to offline photolysis rates file character ( len = 256 ) :: offline_photol_rates_file !> path to environment namelist file character ( len = 256 ) :: environment_data_file !> path to initial tracer file character ( len = 256 ) :: initial_tracer_file !> path to initial non-transported prognostics (NTP) file character ( len = 256 ) :: initial_ntp_file !> directory for output files, relative to the working directory (empty !> means the working directory) character ( len = 256 ) :: output_dir endtype box_config_type contains subroutine read_box_config ( filename , cfg ) !! Reads the box model configuration from a user-provided namelist file and !! stores the configuration in a box_config_type type. use box_debug_mod , only : is_debug_level use box_err_codes_mod , only : box_errcode_config_namelist use ukca_missing_data_mod , only : imdi !> Name of the namelist file to read character ( len =* ), intent ( in ) :: filename !> The resulting box model configuration read from the namelist file type ( box_config_type ), intent ( out ) :: cfg !> Routine name for logging and error reporting character ( len = ukca_maxlen_procname ), parameter :: & routine_name = mod_name // \":read_box_config\" !> I/O status for opening the namelist file integer :: iostat_open !> I/O status for reading each namelist section integer :: iostat_read !> I/O message from opening or reading the namelist file character ( len = 256 ) :: iomsg !> Error code for error reporting integer :: err_code !> Message for error reporting character ( len = ukca_maxlen_message ) :: err_msg !> Debug level to start recording debug message integer , parameter :: min_debug_level = 1 !> unit for opening file integer :: unit !> Loop index integer :: i !> Array of namelist names character ( len = 16 ), dimension ( 10 ), parameter :: nml_names = [ & \"general_config  \" , & \"aerosol         \" , & \"chemistry       \" , & \"constants       \" , & \"deposition      \" , & \"emissions       \" , & \"feedbacks       \" , & \"landsurface     \" , & \"photolysis      \" , & \"IO              \" ] !> model duration (seconds) integer :: model_duration !> starting year of model integer :: start_year !> starting month of model integer :: start_month !> starting day of model integer :: start_day !> starting hour of model integer :: start_hour !> starting minute of model integer :: start_minute !> starting second of model integer :: start_second !> Chemistry scheme to use integer :: i_ukca_chem !> Chemical mechanism version identifier integer :: i_ukca_chem_version !> No. of N-R solver iterations before time step is halved integer :: nrsteps !> Backward Euler timestep (seconds) integer :: dts0 !> Method for controlling age reset to 0 integer :: i_ageair_reset_method !> Max. level for reset (Method 1) integer :: max_ageair_reset_level !> Error handling method to use integer :: i_error_method !> Number of iterations for B-E Solver integer :: nit !> Iteration to start quasi-Newton step (2-50, 2 recommended) integer :: i_ukca_quasinewton_start !> Iteration to stop quasi-Newton step (2-50, 3 recommended) integer :: i_ukca_quasinewton_end !> Method of treating top boundary for certain species in stratospheric !> schemes integer :: i_ukca_topboundary !> 0 = default (5 reactions); 1 = JPL-15 recommended coeff. 2 = JPL-15 + !> bromine reactions integer :: i_ukca_hetconfig !> maximum INFERNO emission level integer :: i_inferno_emi !> Sea-air DMS exchange scheme to use integer :: i_ukca_dms_flux !> Choice for flash-freq parameterisation (1 = Price & Rind, 2 = Luhar et !> al., 3 = external lightning scheme) integer :: i_ukca_light_param !> Photolysis scheme: 0 = off, 1 = stratospheric only, 2 = offline/2-D, !> 3 = Fast-JX integer :: i_photol_scheme !> Timestep number at which environment summary diagnostics should be !> printed to log file integer :: env_log_step !> Options for tuning BC absorption via adjusting BC mass density and !> refractive index mixing approximations integer :: i_ukca_tune_bc !> Sea-salt emission options integer :: i_primss_method !> No. of substeps for nucleation/sedimentation integer :: i_mode_nzts !> MODE aerosol scheme to use integer :: i_mode_setup !> Parameterisation method for boundary layer nucleation 1=activation; !> 2=kinetic; 3=organic mediated (as per Metzger et al, PNAS, 2010) - !> required when 'l_mode_bhn_on' is true. integer :: i_mode_bln_param_method !> Choice of nucl. scavenging coefficients: 1=original, 2=ECHAM5-HAM, !> 3=as(1) but no scav of modes 6&7 integer :: i_mode_nucscav !> Activation scheme to use integer :: i_ukca_activation_scheme !> Value of nwbins in Activate (1-20) See Rosalind West paper for details !> doi:10.5194/acp-14-6369-2014 integer :: i_ukca_nwbins !> Number of surface types considered in interactive dry deposition integer :: ntype !> fast-jx photolysis mode above cutoff (1=lookup tables, 2=fast-jx + !> lookup tables, 3=fast-jx) integer :: fastjx_mode !> number of wavelengths to use in fast-jx. Options are 8, 12 or 18 integer :: fastjx_numwl !> apply solar variability to photolysis (fast-jx only). 0 = no solar !> cycle, 1 = observed cycle, 2 = average cycle. integer :: i_solcylc_type !> 1st year for the solar cycle (used when i_solcylc_type = 1) integer :: solcylc_start_year !> Thickness of surface soil layer (m) real :: dzsoil_layer1 !> Model timestep in seconds (an integer no of timesteps is expected in 1 !> hour) real :: timestep !> Max. height (m) for reset (M