lcylc_start_year' , cfg % solcylc_start_year , fmt_int ) call print_field ( '  fastjx_prescutoff (hPa)' , & cfg % fastjx_prescutoff , fmt_real ) call print_field ( '  l_cloud_pc2' , cfg % l_cloud_pc2 , fmt_log ) call print_field ( '  l_strat_chem' , cfg % l_strat_chem , fmt_log ) call print_field ( '  l_use_photolysis' , cfg % l_use_photolysis , fmt_log ) call print_field ( '  l_offline_photol' , cfg % l_offline_photol , fmt_log ) call umPrint ( '' , src = routine_name ) call umPrint ( '=' // repeat ( '=' , 78 ) // '=' , src = routine_name ) call umPrint ( '' , src = routine_name ) endsubroutine print_box_config subroutine print_field_int ( label , value , fmt ) !! Print a labelled integer configuration option !> The label to print before the value character ( len =* ), intent ( in ) :: label !> The value to print integer , intent ( in ) :: value !> The format to print the label and value with character ( len =* ), intent ( in ) :: fmt write ( umMessage , fmt ) label , value call umPrint ( umMessage , src = mod_name ) endsubroutine print_field_int subroutine print_field_real ( label , value , fmt ) !! Print a labelled real configuration option !> The label to print before the value character ( len =* ), intent ( in ) :: label !> The value to print real , intent ( in ) :: value !> The format to print the label and value with character ( len =* ), intent ( in ) :: fmt write ( umMessage , fmt ) label , value call umPrint ( umMessage , src = mod_name ) endsubroutine print_field_real subroutine print_field_logical ( label , value , fmt ) !! Print a labelled logical configuration option !> The label to print before the value character ( len =* ), intent ( in ) :: label !> The value to print logical , intent ( in ) :: value !> The format to print the label and value with character ( len =* ), intent ( in ) :: fmt write ( umMessage , fmt ) label , value call umPrint ( umMessage , src = mod_name ) endsubroutine print_field_logical subroutine print_field_char ( label , value , fmt ) !! Print a labelled character configuration option !> The label to print before the value character ( len =* ), intent ( in ) :: label !> The value to print character ( len =* ), intent ( in ) :: value !> The format to print the label and value with character ( len =* ), intent ( in ) :: fmt write ( umMessage , fmt ) label , trim ( value ) call umPrint ( umMessage , src = mod_name ) endsubroutine print_field_char endmodule box_config_mod","tags":"","url":"sourcefile/box_config.f90.html"},{"title":"box_shell.F90 – UKCA Box Model","text":"Source Code module box_shell_mod !! Module holding the box model driver: it reads the box config and inputs, !! sets up UKCA, then runs UKCA for each time step and writes the output. use umprintmgr , only : umMessage , umPrint use ereport_mod , only : ereport implicit none private public :: box_shell !> Module name for logging and error reporting character ( len =* ), parameter :: mod_name = \"box_shell_mod\" contains subroutine box_shell ( namelist_path ) !! Run the box model: read the box config namelist and the input files it !! names, set up UKCA and photolysis, then step UKCA through the model !! duration and write the tracer output. use box_config_mod , only : read_box_config , box_config_type , & print_box_config , output_file_path use box_jules_mod , only : setup_jules use box_internal_ukca_config_mod , only : setup_internal_ukca_config , & read_internal_ukca_config use box_environment_mod , & only : box_environment_type , & read_box_environment_nml , & print_box_environment , set_box_environment , & derive_env_variables , print_ukca_environment , & update_env_from_tracers , update_tracer_from_env use box_tracer_mod , only : create_initial_tracers , & get_tracer_varnames , & tracer_ukca , print_tracer_output , & initialise_output_tracers , & cleanup_tracers , add_tracers_to_output use box_ntp_mod , only : get_ntp_varnames , ntp_ukca , create_initial_ntp use box_time_mod , only : box_time_initialise , & box_time_advance , n_steps , & day_time_list_format , & current_date_time , & previous_date_time use ukca_api_mod , only : ukca_step , & ukca_maxlen_message , ukca_maxlen_procname use box_io_mod , only : write_tracer_output use box_photol_mod , only : box_photol_setup , photol_get_rates , & update_solar_pos , get_photol_reaction_data use box_debug_mod , only : is_debug_level use box_config_validator_mod , only : validate_config use ukca_internal_dump_mod , only : ukca_dump_on , & dump_ukca_internal_config , & dump_ukca_step_in , dump_ukca_step_out !> Path to the box config namelist, which names the other input files character ( len =* ), intent ( in ) :: namelist_path !> Error message returned by ukca_step character ( len = ukca_maxlen_message ) :: error_message !> Routine reporting the error, returned by ukca_step character ( len = ukca_maxlen_procname ) :: error_routine !> Message for error reporting character ( len = ukca_maxlen_message ) :: err_msg !> The box model configuration, read from the box config namelist type ( box_config_type ) :: cfg !> The box model environment, read from the environment namelist type ( box_environment_type ) :: env !> Error code returned by ukca_step integer :: err_code !> Time step index integer :: t !> Current model date and time, as the 7-element list UKCA expects integer :: current_date_time_list ( 7 ) !> Previous model date and time, as the 7-element list UKCA expects integer :: previous_date_time_list ( 7 ) ! initialise variables err_code = 0 current_date_time_list = - 1 previous_date_time_list = - 1 call umPrint ( \"Starting UKCA shell\" , src = mod_name ) call read_box_config ( namelist_path , cfg ) call umPrint ( \"Successfully read box config namelist\" , src = mod_name ) ! perform checks on input configuration call validate_config ( cfg ) call print_box_config ( cfg ) ! call jules setup to initialise land surface type indices call setup_jules ( cfg % ntype ) ! setup photolysis call box_photol_setup ( cfg ) ! set up UKCA's internal configuration from the box config call setup_internal_ukca_config ( cfg ) if ( ukca_dump_on ()) call dump_ukca_internal_config () ! set options from ukca internal configuration call read_internal_ukca_config () ! get photolysis call get_photol_reaction_data () ! TODO - need to write a checker of internal ukca config vs the namelist ! config - check specific values match ! Read in the environment write ( umMessage , \"(2A)\" ) \"Reading environment from: \" , & trim ( cfg % environment_data_file ) call umPrint ( umMessage , src = mod_name ) call read_box_environment_nml ( trim ( cfg % environment_data_file ), env ) ! derive the environment variables from the namelist values, e.g. calculate ! the solar declination and equation of time from the date and time call derive_env_variables ( env ) ! print the environment out - there will be NaN values for unset env ! variables if ( is_debug_level ( 1 )) then call print_box_environment ( env ) endif ! generate the tracer variable list based upon the model configuration call get_tracer_varnames () ! create initial tracer array from input file write ( umMessage , \"(2A)\" ) \"Reading initial tracers from: \" , & trim ( cfg % initial_tracer_file ) call umPrint ( umMessage , src = mod_name ) call create_initial_tracers ( trim ( cfg % initial_tracer_file )) ! generate the non-transported prognostic variable list based upon the ! model configuration call get_ntp_varnames () ! create initial non-transported prognostic variable array from input file write ( umMessage , \"(2A)\" ) \"Reading initial ntp from: \" , & trim ( cfg % initial_ntp_file ) call umPrint ( umMessage , src = mod_name ) call create_initial_ntp ( trim ( cfg % initial_ntp_file )) ! need to set up time here call box_time_initialise ( cfg % chem_timestep , & cfg % model_duration , & cfg % start_year , cfg % start_month , & cfg % start_day , cfg % start_hour , & cfg % start_minute , cfg % start_second , & cfg % l_cal360 ) call initialise_output_tracers ( n_steps ) ! Print the initial tracer output, which will be the initial conditions call print_tracer_output () do t = 1 , n_steps call box_time_advance ( t ) ! env sin_declination and equation_of_time recalculated here call update_solar_pos ( env ) ! get photolysis rates either from file (offline) or by running scheme call photol_get_rates ( cfg , env ) ! a call to set the internal ukca environment from the box environment call set_box_environment ( env ) ! the environment's q is the master copy of water vapour, as in the UM: ! UKCA's H2O tracer (if it has one) is reset from q before every step. ! With l_ukca_h2o_feedback, q is updated from H2O after the step. call update_tracer_from_env ( tracer_ukca , env % q , \"H2O\" ) ! print out the internal ukca environment if ( is_debug_level ( 1 )) then call print_ukca_environment () endif current_date_time_list = day_time_list_format ( current_date_time ) previous_date_time_list = day_time_list_format ( previous_date_time ) if ( ukca_dump_on ()) then call dump_ukca_step_in ( t , & current_date_time_list , tracer_ukca , & ntp_ukca , env % r_theta_levels , & env % r_rho_levels , & previous_time = previous_date_time_list , & eta_theta_levels = env % eta_theta_levels ) endif call ukca_step ( t , current_date_time_list , tracer_ukca , ntp_ukca , & env % r_theta_levels , env % r_rho_levels , err_code , & previous_time = previous_date_time_list , & eta_theta_levels = env % eta_theta_levels , & error_message = error_message , error_routine = error_routine ) if ( ukca_dump_on ()) call dump_ukca_step_out ( tracer_ukca , ntp_ukca ) if ( err_code /= 0 ) then write ( err_msg , \"(A, I0, 2A)\" ) \"Error in ukca_step at time step \" , t , & \": \" , trim ( error_message ) call ereport ( trim ( error_routine ), err_code , err_msg ) endif if ( cfg % l_ukca_h2o_feedback ) then ! update the box environment with the ukca effect on h2o call update_env_from_tracers ( env % q , tracer_ukca , \"H2O\" ) endif ! after ukca_step need to retrieve the tracers and ntp from master arrays ! and return them to the box_tracer and box_ntp modules ! print out the tracer output for this time step call print_tracer_output () ! add tracers to io output array call add_tracers_to_output ( t ) enddo ! write the tracer output to file call write_tracer_output ( trim ( output_file_path ( cfg , \"tracer_output.csv\" ))) ! clean-up tracers call cleanup_tracers () call umPrint ( \"Ending UKCA shell\" , src = mod_name ) endsubroutine box_shell endmodule box_shell_mod","tags":"","url":"sourcefile/box_shell.f90.html"},{"title":"um_parcore.F90 – UKCA Box Model","text":"Source Code ! *****************************COPYRIGHT******************************* ! (C) Crown copyright Met Office. All rights reserved. ! For further details please refer to the file COPYRIGHT.txt ! which you should have received as part of this distribution. ! *****************************COPYRIGHT******************************* ! ! Code Owner: Please refer to the UM file CodeOwners.txt ! This file belongs in section: MPP. module UM_ParCore ! Note: These vars were formally part of parvars, but do not 'switch' ! with decomposition, and hence were inappropriately homed there, and also ! cause circular dependencies when used from very basic routines. implicit none public ! Initialise these for sane defaults in serial use cases integer :: mype = 0 integer :: nproc = 1 ! number of processes integer :: nproc_max = 1 ! maximum number of processes endmodule UM_ParCore","tags":"","url":"sourcefile/um_parcore.f90.html"},{"title":"box_internal_ukca_config.F90 – UKCA Box Model","text":"Source Code module box_internal_ukca_config_mod !! Module for setting up UKCA's internal configuration from the box config !! (setup_internal_ukca_config, which calls ukca_setup), and for storing !! internal ukca configuration options that are dependent on configuration !! choices, but also need to be made accessible by the box model. !! !! Note these values are only valid after ukca_setup() has been called, and !! the internal configuration been set up. !! !! This includes the number of photolytic reactions, which is needed by the !! box model to allocate arrays for photolysis rates. use ukca_missing_data_mod , only : imdi implicit none private public :: setup_internal_ukca_config public :: read_internal_ukca_config !> Number of dust emission size ranges integer , public , protected :: n_dust_emissions = imdi !> Number of photolytic reactions integer , public , protected :: jppj = imdi !> module name for error reporting character ( len =* ), parameter :: mod_name = & \"box_internal_ukca_config_mod\" contains subroutine setup_internal_ukca_config ( cfg ) !! Set up UKCA's internal configuration by calling ukca_setup with the box !! config, the box model's fixed settings (box_const_mod) and the JULES !! surface type indices. setup_jules must be called first. use box_config_mod , only : box_config_type use box_const_mod , only : row_length , & rows , model_levels , bl_levels , & nlev_ent_tr_mix , ukca_chem_seg_size , & ukca_mode_seg_size , l_fix_tropopause_level , & l_enable_diag_um , l_ukca_persist_off , & l_ukca_emissions_off , & l_ukca_asad_columns , l_ukca_asad_full , & i_strat_lbc_source , & l_ukca_enable_seadms_ems , l_environ_z_top use photol_api_mod , only : photol_off , photol_strat_only , photol_2d , & photol_fastjx use box_jules_mod , only : npft , i_brd_leaf , i_brd_leaf_dec , & i_brd_leaf_eg_trop , i_brd_leaf_eg_temp , & i_ndl_leaf , i_ndl_leaf_dec , & i_ndl_leaf_eg , i_c3_grass , i_c3_crop , & i_c3_pasture , i_c4_grass , & i_c4_crop , i_c4_pasture , i_shrub , & i_shrub_dec , i_shrub_eg , i_urban , & i_lake , i_soil , i_ice , i_elev_ice use ukca_api_mod , only : ukca_setup , ukca_maxlen_message , & ukca_maxlen_procname use ereport_mod , only : ereport !> The box model configuration type ( box_config_type ), intent ( in ) :: cfg !> Error code returned by ukca_setup integer :: err_code !> Error message returned by ukca_setup character ( len = ukca_maxlen_message ) :: error_message !> Routine reporting the error, returned by ukca_setup character ( len = ukca_maxlen_procname ) :: error_routine !> Message for error reporting character ( len = ukca_maxlen_message ) :: err_msg err_code = 0 call ukca_setup ( & error_code = err_code , & row_length = row_length , & rows = rows , & model_levels = model_levels , & bl_levels = bl_levels , & nlev_ent_tr_mix = nlev_ent_tr_mix , & ntype = cfg % ntype , & npft = npft , & i_brd_leaf = i_brd_leaf , & i_brd_leaf_dec = i_brd_leaf_dec , & i_brd_leaf_eg_trop = i_brd_leaf_eg_trop , & i_brd_leaf_eg_temp = i_brd_leaf_eg_temp , & i_ndl_leaf = i_ndl_leaf , & i_ndl_leaf_dec = i_ndl_leaf_dec , & i_ndl_leaf_eg = i_ndl_leaf_eg , & i_c3_grass = i_c3_grass , & i_c3_crop = i_c3_crop , & i_c3_pasture = i_c3_pasture , & i_c4_grass = i_c4_grass , & i_c4_crop = i_c4_crop , & i_c4_pasture = i_c4_pasture , & i_shrub = i_shrub , & i_shrub_dec = i_shrub_dec , & i_shrub_eg = i_shrub_eg , & i_urban = i_urban , & i_lake = i_lake , & i_soil = i_soil , & i_ice = i_ice , & i_elev_ice = i_elev_ice , & i_ukca_chem = cfg % i_ukca_chem , & !fixed_tropopause_level=fixed_tropopause_level, & i_ageair_reset_method = cfg % i_ageair_reset_method , & max_ageair_reset_level = cfg % max_ageair_reset_level , & !i_error_method=cfg%i_error_method, & i_ukca_chem_version = cfg % i_ukca_chem_version , & nrsteps = cfg % nrsteps , & chem_timestep = cfg % chem_timestep , & dts0 = cfg % dts0 , & nit = cfg % nit , & i_ukca_quasinewton_start = cfg % i_ukca_quasinewton_start , & i_ukca_quasinewton_end = cfg % i_ukca_quasinewton_end , & ukca_chem_seg_size = ukca_chem_seg_size , & !nlev_above_trop_o3_env=nlev_above_trop_o3_env, & !nlev_ch4_stratloss=nlev_ch4_stratloss, & i_ukca_topboundary = cfg % i_ukca_topboundary , & i_ukca_hetconfig = cfg % i_ukca_hetconfig , & i_inferno_emi = cfg % i_inferno_emi , & i_ukca_dms_flux = cfg % i_ukca_dms_flux , & i_ukca_light_param = cfg % i_ukca_light_param , & i_strat_lbc_source = i_strat_lbc_source , & !i_primss_method=cfg%i_primss_method, & !env_log_step=cfg%env_log_step, & i_mode_nzts = cfg % i_mode_nzts , & ukca_mode_seg_size = ukca_mode_seg_size , & i_mode_setup = cfg % i_mode_setup , & i_mode_bln_param_method = cfg % i_mode_bln_param_method , & i_mode_nucscav = cfg % i_mode_nucscav , & i_ukca_activation_scheme = cfg % i_ukca_activation_scheme , & i_ukca_nwbins = cfg % i_ukca_nwbins , & i_ukca_tune_bc = cfg % i_ukca_tune_bc , & i_photol_scheme = cfg % i_photol_scheme , & i_photol_scheme_off = photol_off , & i_photol_scheme_strat_only = photol_strat_only , & i_photol_scheme_2d = photol_2d , & i_photol_scheme_fastjx = photol_fastjx , & dzsoil_layer1 = cfg % dzsoil_layer1 , & timestep = cfg % timestep , & max_ageair_reset_height = cfg % max_ageair_reset_height , & max_z_for_offline_chem = cfg % max_z_for_offline_chem , & soa_yield_scaling_mt = cfg % soa_yield_scaling_mt , & soa_yield_scaling_isop = cfg % soa_yield_scaling_isop , & !dry_depvel_so2_scaling=cfg%dry_depvel_so2_scaling, & !fastjx_prescutoff=cfg%fastjx_prescutoff, & mode_parfrac = cfg % mode_parfrac , & seadms_ems_scaling = cfg % seadms_ems_scaling , & sea_salt_ems_scaling = cfg % sea_salt_ems_scaling , & marine_pom_ems_scaling = cfg % marine_pom_ems_scaling , & lightnox_scale_fac = cfg % lightnox_scale_fac , & !anth_so2_ems_scaling=cfg%anth_so2_ems_scaling, & mode_activation_dryr = cfg % mode_activation_dryr , & !dry_depvel_acc_scaling=cfg%dry_depvel_acc_scaling, & !acc_cor_scav_scaling=cfg%acc_cor_scav_scaling, & mode_incld_so2_rfrac = cfg % mode_incld_so2_rfrac , & biom_aer_ems_scaling = cfg % biom_aer_ems_scaling , & !hno3_uptake_coeff=cfg%hno3_uptake_coeff, & !ph_fit_coeff_a=cfg%ph_fit_coeff_a, & !ph_fit_coeff_b=cfg%ph_fit_coeff_b, & !ph_fit_intercept=cfg%ph_fit_intercept, & sigwmin = cfg % sigwmin , & !sigma_updraught_scaling=cfg%sigma_updraught_scaling, & !const_rmol=cfg%const_rmol, & !const_tfs=cfg%const_tfs, & !const_rho_water=cfg%const_rho_water, & !const_rhosea=cfg%const_rhosea, & !const_lc=cfg%const_lc, & !const_avogadro=cfg%const_avogadro, & !const_boltzmann=cfg%const_boltzmann, & !const_rho_so4=cfg%const_rho_so4, & l_cal360 = cfg % l_cal360 , & l_ukca_chem_aero = cfg % l_ukca_chem_aero , & l_ukca_mode = cfg % l_ukca_mode , & l_fix_tropopause_level = l_fix_tropopause_level , & l_ukca_ageair = cfg % l_ukca_ageair , & !l_blankout_invalid_diags=cfg%l_blankout_invalid_diags, & l_enable_diag_um = l_enable_diag_um , & l_ukca_persist_off = l_ukca_persist_off , & l_timer = cfg % l_timer , & l_ukca_emissions_off = l_ukca_emissions_off , & l_ukca_drydep_off = cfg % l_ukca_drydep_off , & l_ukca_wetdep_off = cfg % l_ukca_wetdep_off , & !l_ukca_scale_ppe=cfg%l_ukca_scale_ppe, & l_ukca_asad_columns = l_ukca_asad_columns , & l_ukca_asad_full = l_ukca_asad_full , & l_ukca_debug_asad = cfg % l_ukca_debug_asad , & l_ukca_intdd = cfg % l_ukca_intdd , & l_ukca_ddepo3_ocean = cfg % l_ukca_ddepo3_ocean , & l_ukca_ddep_lev1 = cfg % l_ukca_ddep_lev1 , & l_ukca_dry_dep_so2wet = cfg % l_ukca_dry_dep_so2wet , & l_deposition_jules = cfg % l_deposition_jules , & l_ukca_quasinewton = cfg % l_ukca_quasinewton , & l_tracer_lumping = cfg % l_tracer_lumping , & l_ukca_ro2_ntp = cfg % l_ukca_ro2_ntp , & l_ukca_ro2_perm = cfg % l_ukca_ro2_perm , & !l_ukca_intph=cfg%l_ukca_intph, & l_ukca_scale_soa_yield_mt = cfg % l_ukca_scale_soa_yield_mt , & l_ukca_scale_soa_yield_isop = cfg % l_ukca_scale_soa_yield_isop , & l_ukca_het_psc = cfg % l_ukca_het_psc , & l_ukca_limit_nat = cfg % l_ukca_limit_nat , & l_ukca_sa_clim = cfg % l_ukca_sa_clim , & l_ukca_trophet = cfg % l_ukca_trophet , & l_ukca_classic_hetchem = cfg % l_ukca_classic_hetchem , & l_use_photolysis = cfg % l_use_photolysis , & l_ukca_ibvoc = cfg % l_ukca_ibvoc , & l_ukca_inferno = cfg % l_ukca_inferno , & l_ukca_inferno_ch4 = cfg % l_ukca_inferno_ch4 , & l_ukca_so2ems_expvolc = cfg % l_ukca_so2ems_expvolc , & l_ukca_so2ems_plumeria = cfg % l_ukca_so2ems_plumeria , & l_ukca_qch4inter = cfg % l_ukca_qch4inter , & l_ukca_emsdrvn_ch4 = cfg % l_ukca_emsdrvn_ch4 , & l_ukca_enable_seadms_ems = l_ukca_enable_seadms_ems , & l_ukca_scale_seadms_ems = cfg % l_ukca_scale_seadms_ems , & l_ukca_linox_scaling = cfg % l_ukca_linox_scaling , & l_support_ems_vertprof = cfg % l_support_ems_vertprof , & l_support_ems_gridbox_units = cfg % l_support_ems_gridbox_units , & !l_suppress_ems=cfg%l_suppress_ems, & l_ukca_h2o_feedback = cfg % l_ukca_h2o_feedback , & l_ukca_conserve_h = cfg % l_ukca_conserve_h , & l_param_conv = cfg % l_param_conv , & l_ctile = cfg % l_ctile , & l_zon_av_ozone = cfg % l_zon_av_ozone , & l_chem_environ_gas_scalars = cfg % l_chem_environ_gas_scalars , & l_chem_environ_co2_fld = cfg % l_chem_environ_co2_fld , & l_ukca_prescribech4 = cfg % l_ukca_prescribech4 , & l_use_classic_so4 = cfg % l_use_classic_so4 , & l_use_classic_soot = cfg % l_use_classic_soot , & l_use_classic_ocff = cfg % l_use_classic_ocff , & l_use_classic_biogenic = cfg % l_use_classic_biogenic , & l_use_classic_seasalt = cfg % l_use_classic_seasalt , & l_use_gridbox_volume = cfg % l_use_gridbox_volume , & l_use_gridbox_mass = cfg % l_use_gridbox_mass , & !l_environ_rel_humid=cfg%l_environ_rel_humid, & l_environ_z_top = l_environ_z_top , & !l_fix_ukca_cloud_frac=cfg%l_fix_ukca_cloud_frac, & l_fix_improve_drydep = cfg % l_fix_improve_drydep , & l_fix_drydep_so2_water = cfg % l_fix_drydep_so2_water , & l_fix_ukca_h2dd_x = cfg % l_fix_ukca_h2dd_x , & l_fix_ukca_offox_h2o_fac = cfg % l_fix_ukca_offox_h2o_fac , & l_fix_ukca_h2so4_ystore = cfg % l_fix_ukca_h2so4_ystore , & l_mode_bhn_on = cfg % l_mode_bhn_on , & l_mode_bln_on = cfg % l_mode_bln_on , & l_ddepaer = cfg % l_ddepaer , & !l_aero_rainout=cfg%l_aero_rainout, & l_cv_rainout = cfg % l_cv_rainout , & !l_impc_scav=cfg%l_impc_scav, & !l_dust_mp_slinn_impc_scav=cfg%l_dust_mp_slinn_impc_scav, & l_ukca_primss = cfg % l_ukca_primss , & l_ukca_primsu = cfg % l_ukca_primsu , & l_ukca_primdu = cfg % l_ukca_primdu , & l_ukca_primbcoc = cfg % l_ukca_primbcoc , & l_ukca_prim_moc = cfg % l_ukca_prim_moc , & l_bcoc_bf = cfg % l_bcoc_bf , & l_bcoc_bm = cfg % l_bcoc_bm , & l_bcoc_ff = cfg % l_bcoc_ff , & l_ukca_scale_biom_aer_ems = cfg % l_ukca_scale_biom_aer_ems , & l_ukca_fine_no3_prod = cfg % l_ukca_fine_no3_prod , & l_ukca_coarse_no3_prod = cfg % l_ukca_coarse_no3_prod , & l_no3_prod_in_aero_step = cfg % l_no3_prod_in_aero_step , & l_ukca_scale_sea_salt_ems = cfg % l_ukca_scale_sea_salt_ems , & l_ukca_scale_marine_pom_ems = cfg % l_ukca_scale_marine_pom_ems , & !l_ukca_mp_fragment=cfg%l_ukca_mp_fragment, & !l_ukca_mp_fibre=cfg%l_ukca_mp_fibre, & l_ukca_radaer = cfg % l_ukca_radaer , & l_ntpreq_n_activ_sum = cfg % l_ntpreq_n_activ_sum , & l_ntpreq_dryd_nuc_sol = cfg % l_ntpreq_dryd_nuc_sol , & l_ukca_sfix = cfg % l_ukca_sfix , & l_fix_neg_pvol_wat = cfg % l_fix_neg_pvol_wat , & l_fix_ukca_impscav = cfg % l_fix_ukca_impscav , & l_fix_nacl_density = cfg % l_fix_nacl_density , & l_improve_aero_drydep = cfg % l_improve_aero_drydep , & l_fix_ukca_water_content = cfg % l_fix_ukca_water_content , & l_fix_ukca_activate_pdf = cfg % l_fix_ukca_activate_pdf , & l_fix_ukca_activate_vert_rep = cfg % l_fix_ukca_activate_vert_rep , & l_bug_repro_tke_index = cfg % l_bug_repro_tke_index , & !l_dust_mp_ageing=cfg%l_dust_mp_ageing, & l_fix_ukca_hygroscopicities = cfg % l_fix_ukca_hygroscopicities , & !l_skip_const_setup=cfg%l_skip_const_setup, & error_message = error_message , error_routine = error_routine ) if ( err_code /= 0 ) then write ( err_msg , \"(2A)\" ) \"Error in ukca_setup: \" , trim ( error_message ) call ereport ( trim ( error_routine ), err_code , err_msg ) endif endsubroutine setup_internal_ukca_config subroutine read_internal_ukca_config () !! Get the ukca internal options needed by the box model. Must be called !! after ukca_setup() has been called. use ukca_api_mod , only : ukca_get_config , & ukca_errcode_ukca_uninit , ukca_maxlen_message , & ukca_photol_varname_len , & ukca_get_photol_reaction_data use ereport_mod , only : ereport !> Logical indicating whether the internal configuration is available logical :: l_config_available !> Error code for reporting internal configuration not available integer :: err_code !> Pointer to an array containing the photolytic reaction data character ( len = 10 ), pointer :: ratj_data (:, :) !> Pointer to an array containing the names of the photolytic reaction !> variables character ( len = ukca_photol_varname_len ), pointer :: ratj_varnames (:) !> Subroutine name for error reporting character ( len =* ), parameter :: routine_name = & \"read_internal_ukca_config\" !> Message for error reporting character ( len = ukca_maxlen_message ) :: err_msg err_code = 0 call ukca_get_config ( n_dust_emissions = n_dust_emissions , & l_config_available = l_config_available ) if (. not . l_config_available ) then err_code = ukca_errcode_ukca_uninit write ( err_msg , \"(A)\" ) \"UKCA internal configuration not available. \" // & \"ukca_setup() must be called first.\" call ereport ( mod_name // \":\" // routine_name , err_code , err_msg ) endif ! Get the number of photolytic reactions call ukca_get_photol_reaction_data ( ratj_data , ratj_varnames ) jppj = size ( ratj_varnames ) endsubroutine read_internal_ukca_config endmodule box_internal_ukca_config_mod","tags":"","url":"sourcefile/box_internal_ukca_config.f90.html"},{"title":"fastjx_inphot_mod.F90 – UKCA Box Model","text":"Source Code module fastjx_inphot_mod implicit none public character ( LEN =* ), parameter , private :: ModuleName = 'FASTJX_INPHOT_MOD' contains subroutine fastjx_inphot ! not implemented endsubroutine fastjx_inphot endmodule fastjx_inphot_mod","tags":"","url":"sourcefile/fastjx_inphot_mod.f90.html"},{"title":"planet_constants_mod.F90 – UKCA Box Model","text":"Source Code module planet_constants_mod implicit none public real , parameter :: planet_radius = 637122 9.0 endmodule planet_constants_mod","tags":"","url":"sourcefile/planet_constants_mod.f90.html"},{"title":"box_config_validator.F90 – UKCA Box Model","text":"Source Code module box_config_validator_mod !! Module for validating the configuration of the UKCA box model. ! TODO - big task to expand this to cover all configuration options use ukca_api_mod , only : ukca_maxlen_message use ereport_mod , only : ereport use box_err_codes_mod , only : box_errcode_config_range implicit none private public :: validate_config !> Module name for error reporting character ( len =* ), parameter :: mod_name = \"box_config_validator_mod\" contains subroutine validate_config ( cfg ) !! Validate the inputted configuration use box_config_mod , only : box_config_type !> The configuration to validate type ( box_config_type ), intent ( in ) :: cfg ! Validate i_mode_nucscav call check_int_in_range ( cfg % i_mode_nucscav , \"i_mode_nucscav\" , 1 , 3 ) endsubroutine validate_config subroutine check_int_in_range ( value , value_name , min_val , max_val ) !! Check if an integer value is within a specified range. If the value is !! out of range, an error is reported. !> The integer value to check integer , intent ( in ) :: value !> The name of the value for error reporting character ( len =* ), intent ( in ) :: value_name !> The minimum valid value integer , intent ( in ) :: min_val !> The maximum valid value integer , intent ( in ) :: max_val !> Logical indicating if the value is valid logical :: is_valid !> Error code for error reporting integer :: err_code !> Error message for error reporting character ( len = ukca_maxlen_message ) :: err_message !> Name of the routine for error reporting character ( len =* ), parameter :: routine_name = & mod_name // \":check_int_in_range\" is_valid = ( value >= min_val . and . value <= max_val ) if (. not . is_valid ) then write ( err_message , \"(3A,I0,A,I0,3A,I0)\" ) \"Value of \" , & trim ( value_name ), \" (\" , value , \") is out of range: \" , min_val , & \" <= \" , trim ( value_name ), \" <= \" , max_val err_code = box_errcode_config_range call ereport ( routine_name , err_code , err_message ) endif endsubroutine check_int_in_range endmodule box_config_validator_mod","tags":"","url":"sourcefile/box_config_validator.f90.html"},{"title":"missing_data_mod.F90 – UKCA Box Model","text":"Source Code ! Module made for replicating the missing_data_mod typically found ! within the UM for use inside the new UKCA box model. ! ! ! ! Data module containing missing data indicies ! ! Migrated from include file c_mdi.h ! ! Code Owner: Please refer to the UM file CodeOwners.txt ! This file belongs in section: top_level ! ! Code Description: !   Language: FORTRAN 90 ! module missing_data_mod implicit none public ! PP missing data indicator (-1.0E+30) real , parameter :: rmdi_pp = - 1.0e+30 ! Old real missing data indicator (-32768.0) real , parameter :: rmdi_old = - 3276 8.0 ! New real missing data indicator (-2**30) real , parameter :: rmdi = - 3276 8.0 * 3276 8.0 ! Integer missing data indicator integer , parameter :: imdi = - 32768 endmodule missing_data_mod","tags":"","url":"sourcefile/missing_data_mod.f90.html"},{"title":"box_socrates.F90 – UKCA Box Model","text":"Source Code module box_socrates_mod !! Module for storing constants for the UKCA box model that are stored in !! the socrates model for the operational runs. To reduce the number of !! dependencies on socrates, we store the constants here in the box model !! and set them to the same values as in socrates. implicit none public !> Parametrization for moist aerosols integer , parameter :: ip_aerosol_param_moist = 2 !> Aerosols for the sulphur cycle - Accumulation mode sulphate integer , parameter :: ip_accum_sulphate = 10 !> Aitken mode sulphate integer , parameter :: ip_aitken_sulphate = 11 endmodule box_socrates_mod","tags":"","url":"sourcefile/box_socrates.f90.html"},{"title":"box_environment.F90 – UKCA Box Model","text":"Source Code module box_environment_mod !! Module to handle the creation of the box model environment, stored in !! box_environment_type. This holds all environmental fields for a box model !! run. The API call ukca_set_environment is then used to pass this !! information from the box model into the main UKCA model. use umprintmgr , only : umMessage , umPrint use box_debug_mod , only : is_debug_level use box_const_mod , only : row_length , rows , model_levels , land_points , & nlev_ent_tr_mix use box_jules_mod , only : npft , ntype use box_internal_ukca_config_mod , only : jppj use ukca_missing_data_mod , only : imdi , rmdi use , intrinsic :: ieee_arithmetic , only : ieee_value , ieee_quiet_nan use ereport_mod , only : ereport use ukca_api_mod , only : ukca_maxlen_procname , ukca_maxlen_message implicit none !> Module name for logging and error reporting character ( len =* ), parameter :: mod_name = \"box_environment_mod\" interface print_field procedure print_field_real procedure print_field_int procedure print_field_logical endinterface print_field private ! subroutine for creating a fresh box_environment_type public :: create_box_environment_type ! subroutine for reading environmental namelist and creating a ! box_environment_type from the parsed fields public :: read_box_environment_nml ! subroutine to print the environmental fields stored in the input ! box_environment_type public :: print_box_environment ! subroutine to set the ukca environment information from the input ! box_environment_type public :: set_box_environment ! subroutine to derive additional environment variables from the input ! box_environment_type and set these in the ukca environment public :: derive_env_variables ! subroutine to print internal ukca environment variables public :: print_ukca_environment ! subroutine to update a box environment entry with values from the tracer ! array public :: update_env_from_tracers ! subroutine to update a tracer with values from a box environment entry public :: update_tracer_from_env !> derived type for storing all ukca environmental fields type , public :: box_environment_type ! real scalar fields !> height of model top (m) real :: z_top_of_model = rmdi !> sin of solar declination real :: sin_declination = rmdi !> equation of time, specified as an hour angle (radians) real :: equation_of_time = rmdi !> prescribed mass fraction of methane in air real :: atmospheric_ch4 = rmdi !> prescribed mass fraction of carbon dioxide in air real :: atmospheric_co2 = rmdi !> prescribed mass fraction of molecular hydrogen in air real :: atmospheric_h2 = rmdi !> prescribed mass fraction of molecular nitrogen in air real :: atmospheric_n2 = rmdi !> prescribed mass fraction of molecular oxygen in air real :: atmospheric_o2 = rmdi !> prescribed mass fraction of nitrous oxide in air real :: atmospheric_n2o = rmdi !> prescribed mass fraction of cfc11 in air real :: atmospheric_cfc11 = rmdi !> prescribed mass fraction of cfc12 in air real :: atmospheric_cfc12 = rmdi !> prescribed mass fraction of cfc113 in air real :: atmospheric_cfc113 = rmdi !> prescribed mass fraction of hcfc22 in air real :: atmospheric_hcfc22 = rmdi !> prescribed mass fraction of hfc125 in air real :: atmospheric_hfc125 = rmdi !> prescribed mass fraction of hfc134a in air real :: atmospheric_hfc134a = rmdi !> prescribed mass fraction of methyl bromide in air real :: atmospheric_mebr = rmdi !> prescribed mass fraction of methyl chloride in air real :: atmospheric_mecl = rmdi !> prescribed mass fraction of dibromomethane in air real :: atmospheric_ch2br2 = rmdi !> prescribed mass fraction of tribromomethane in air real :: atmospheric_chbr3 = rmdi !> prescribed mass fraction of cfc114 in air real :: atmospheric_cfc114 = rmdi !> prescribed mass fraction of cfc115 in air real :: atmospheric_cfc115 = rmdi !> prescribed mass fraction of carbon tetrachloride in air real :: atmospheric_ccl4 = rmdi !> prescribed mass fraction of methyl chloroform in air real :: atmospheric_meccl3 = rmdi !> prescribed mass fraction of hcfc141b in air real :: atmospheric_hcfc141b = rmdi !> prescribed mass fraction of hcfc142b in air real :: atmospheric_hcfc142b = rmdi !> prescribed mass fraction of h1211 in air real :: atmospheric_h1211 = rmdi !> prescribed mass fraction of h1202 in air real :: atmospheric_h1202 = rmdi !> prescribed mass fraction of h1301 in air real :: atmospheric_h1301 = rmdi !> prescribed mass fraction of h2402 in air real :: atmospheric_h2402 = rmdi !> prescribed mass fraction of carbonyl sulfide in air real :: atmospheric_cos = rmdi ! real 1D fields !> moisture_content_of_soil_layer at surface (kg/m&#94;2) {UM:00009} real , dimension (:), allocatable :: soil_moisture_layer1 !> land_area_fraction {UM:00505} real , dimension (:), allocatable :: fland !> Gridbox mean isoprene emission flux (kgC/m2/s) real , dimension (:), allocatable :: ibvoc_isoprene !> Gridbox mean (mono-)terpene emission flux (kgC/m2/s) real , dimension (:), allocatable :: ibvoc_terpene !> Gridbox mean methanol emission flux (kgC/m2/s) real , dimension (:), allocatable :: ibvoc_methanol !> Gridbox mean acetone emission flux (kgC/m2/s) real , dimension (:), allocatable :: ibvoc_acetone !> Gridbox mean Black Carbon emissions from fires (kg/m2/s) real , dimension (:), allocatable :: inferno_bc !> Gridbox mean Methane emissions from fires (kg/m2/s) real , dimension (:), allocatable :: inferno_ch4 !> Gridbox mean Carbon monoxide emissions from fires (kg/m2/s) real , dimension (:), allocatable :: inferno_co !> Gridbox mean Nitric oxide emissions from fires (kg/m2/s) real , dimension (:), allocatable :: inferno_nox !> Gridbox mean Organic Carbon emissions from fires (kg/m2/s) real , dimension (:), allocatable :: inferno_oc !> Gridbox mean Sulphur dioxide emissions from fires (kg/m2/s) real , dimension (:), allocatable :: inferno_so2 !> Gridbox mean ethene emissions from fires (kg/m2/s) real , dimension (:), allocatable :: inferno_c2h4 !> Gridbox mean ethane emissions from fires (kg/m2/s) real , dimension (:), allocatable :: inferno_c2h6 !> Gridbox mean propane emissions from fires (kg/m2/s) real , dimension (:), allocatable :: inferno_c3h8 !> Gridbox mean formaldehyde emissions from f