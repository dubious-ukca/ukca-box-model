ol in air {UM:00435} real, public, dimension(:, :, :), allocatable :: dust_div6 mass fraction of dust division 6 dry aerosol in air {UM:00436} real, public, dimension(:, :, :), allocatable :: sea_salt_film atmosphere number concentration of film mode sea salt particles (/m&#94;3) real, public, dimension(:, :, :), allocatable :: sea_salt_jet atmosphere number concentration of jet mode sea salt particles (/m&#94;3) real, public, dimension(:, :, :), allocatable :: co2_interactive mass_fraction_of_carbon_dioxide_in_air [CF] {UM:00252} real, public, dimension(:, :, :), allocatable :: rim_cry riming rate for ice crystals from cloud liquid, mass fraction (/s) real, public, dimension(:, :, :), allocatable :: rim_agg riming rate for ice aggregates, mass fraction (/s) {UM:04248} real, public, dimension(:, :, :), allocatable :: vertvel upward_air_velocity [CF] (m/s) {UM:00150} real, public, dimension(:, :, :), allocatable :: bl_tke turbulent kinetic energy (m&#94;2/s&#94;2) {UM:03473} real, public, dimension(:, :, :), allocatable :: interf_z altitude of grid-cell interfaces (m) real, public, dimension(:, :, :), allocatable :: grid_area_fullht grid cell area (m&#94;2), all levels real, public, dimension(:, :, :), allocatable :: grid_volume grid cell volume (m&#94;3), theta levels real, public, dimension(:, :, :), allocatable :: grid_airmass grid cell air mass (kg), theta levels real, public, dimension(:, :, :), allocatable :: rel_humid_frac relative_humidity [CF] real, public, dimension(:, :, :), allocatable :: rel_humid_frac_clr clear-sky relative humidity real, public, dimension(:, :, :), allocatable :: qsvp saturation vapour pressure of water (Pa) real, public, dimension(:, :, :), allocatable :: h2o2_offline hydrogen peroxide as offline oxidant (kg/kg-air) real, public, dimension(:, :, :), allocatable :: ho2_offline hydroperoxyl radical as offline oxidant (kg/kg-air) real, public, dimension(:, :, :), allocatable :: no3_offline nitrate radical as offline oxidant (kg/kg-air) real, public, dimension(:, :, :), allocatable :: o3_offline mass_fraction_of_ozone_in_air [CF] {UM:00060} real, public, dimension(:, :, :), allocatable :: oh_offline hydroxyl radical as offline oxidant (kg/kg-air) real, public, dimension(:, :, :), allocatable :: r_theta_levels distance from the centre of the Earth to theta levels (m) real, public, dimension(:, :, :), allocatable :: r_rho_levels distance from the centre of the Earth to rho levels (m) real, public, dimension(:, :, :), allocatable :: p_rho_levels air_pressure [CF] at rho levels (Pa) {UM:00407} real, public, dimension(:, :, :), allocatable :: aod_sulph_accum aerosol optical depth of accumulation mode sulphate, for photolysis real, public, dimension(:, :, :), allocatable :: aod_sulph_aitk aerosol optical depth of Aitken mode sulphate, for photolysis real, public, dimension(:, :, :, :), allocatable :: photol_rates photolysis rates (row_length, rows, model_levels, jppj)","tags":"","url":"type/box_environment_type.html"},{"title":"ereport – UKCA Box Model","text":"public  subroutine ereport(routine_name, error_status, message) Uses iso_fortran_env Report errors, warnings, and info messages in the UKCA box model. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: routine_name The name of the routine where the error occurred. integer, intent(inout) :: error_status The error status code. Positive for errors, negative for warnings, and\nzero for info messages. This will be reset to zero after reporting. character(len=*), intent(in) :: message The message to be reported.","tags":"","url":"proc/ereport.html"},{"title":"day_time_list_format – UKCA Box Model","text":"public  function day_time_list_format(date_time) result(day_time_list) Format a box_date_time object into a list of integers representing:\n- [year, month, day, hour, minute, second and day of year] Arguments Type Intent Optional Attributes Name type( box_date_time ), intent(in) :: date_time The input date and time object Return Value integer, (7) The output list of integers","tags":"","url":"proc/day_time_list_format.html"},{"title":"box_time_initialise – UKCA Box Model","text":"public  subroutine box_time_initialise(time_step_nml, model_duration_nml, start_year, start_month, start_day, start_hour, start_minute, start_second, l_360) Initialize the time manager with the time step, model duration and the\nmodel start date and time from the configuration namelist. Current time\nand step are set to 0. Arguments Type Intent Optional Attributes Name integer, intent(in) :: time_step_nml Time step from configuration namelist (seconds) integer, intent(in) :: model_duration_nml Model duration from configuration namelist (seconds) integer, intent(in) :: start_year Model start year integer, intent(in) :: start_month Model start month integer, intent(in) :: start_day Model start day integer, intent(in) :: start_hour Model start hour integer, intent(in) :: start_minute Model start minute integer, intent(in) :: start_second Model start second logical, intent(in) :: l_360 Logical indicating if the model is using a 360-day calendar","tags":"","url":"proc/box_time_initialise.html"},{"title":"print_date_time – UKCA Box Model","text":"public  subroutine print_date_time(date_time) Print the current model date and time in a human-readable format. Arguments Type Intent Optional Attributes Name type( box_date_time ), intent(in) :: date_time Date and time info to print","tags":"","url":"proc/print_date_time.html"},{"title":"box_time_advance – UKCA Box Model","text":"public  subroutine box_time_advance(step_num) Uses box_err_codes_mod Advance the model time by the current time step and increment the index.\nIf all time steps have been completed, an error is reported as this\nshould not occur. Arguments Type Intent Optional Attributes Name integer, intent(in) :: step_num The step number to advance to (should be current_step + 1)","tags":"","url":"proc/box_time_advance.html"},{"title":"get_time_midpoint – UKCA Box Model","text":"public  subroutine get_time_midpoint(time, timestep, midpoint) Get the midpoint between two time steps. Arguments Type Intent Optional Attributes Name type( box_date_time ), intent(in) :: time The input date and time object integer, intent(in) :: timestep The time step size (seconds) type( box_date_time ), intent(out) :: midpoint The output midpoint date and time object","tags":"","url":"proc/get_time_midpoint.html"},{"title":"setup_jules – UKCA Box Model","text":"public  subroutine setup_jules(ntype_in) Uses ukca_api_mod ereport_mod Set up the constants related to the Jules model for use by the UKCA box\nmodel. Takes number of land types (ntype) to determine constant values. Arguments Type Intent Optional Attributes Name integer, intent(in) :: ntype_in Number of land types (surface types) for the box model configuration","tags":"","url":"proc/setup_jules.html"},{"title":"get_debug_level – UKCA Box Model","text":"public  function get_debug_level() result(level) Get the current debug level of the box model. Arguments None Return Value integer The current debug level of the box model.","tags":"","url":"proc/get_debug_level.html"},{"title":"is_debug_level – UKCA Box Model","text":"public  function is_debug_level(min_level) result(is_active) Function to check if the current debug level is at least the specified\nminimum level. Arguments Type Intent Optional Attributes Name integer, intent(in) :: min_level The minimum debug level to check against. Return Value logical A logical value indicating whether the current debug level is at least\nthe minimum level.","tags":"","url":"proc/is_debug_level.html"},{"title":"set_debug_level – UKCA Box Model","text":"public  subroutine set_debug_level(level) Set the debug level for the box model. Higher levels may produce more\nverbose output. level 0 is not debug output. error code directly from ukca api Arguments Type Intent Optional Attributes Name integer, intent(in) :: level The debug level to set for the box model. Must be between 0 and\nmax_debug_level.","tags":"","url":"proc/set_debug_level.html"},{"title":"get_ntp_varnames – UKCA Box Model","text":"public  subroutine get_ntp_varnames() Retrieve the list of non-transported prognostic variable names from\nthe UKCA API and store them in the ntp_varnames pointer. Arguments None","tags":"","url":"proc/get_ntp_varnames.html"},{"title":"create_initial_ntp – UKCA Box Model","text":"public  subroutine create_initial_ntp(ntp_file) Uses box_err_codes_mod box_const_mod Create the initial values for the non-transported prognostic (ntp)\narray from a provided file. The file should contain lines of the form: Where is the name of the non-transported prognostic variable\nand is the initial value to set for that variable. If the\nvariable name is \"DEFAULT\", then will be used as the default\nvalue for any non-transported prognostic variable not explicitly set in\nthe file. If no \"DEFAULT\" line is provided, the default value will be\nset to 1.0e-14. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: ntp_file The name of the file containing the values for initial non-transported\nprognostic (ntp) array","tags":"","url":"proc/create_initial_ntp.html"},{"title":"setup_nml_type – UKCA Box Model","text":"public  subroutine setup_nml_type() Arguments None","tags":"","url":"proc/setup_nml_type.html"},{"title":"dump_is_open – UKCA Box Model","text":"public  function dump_is_open() result(is_open) True if a dump file is open, i.e. dump calls will write output. Arguments None Return Value logical Whether a dump file is open","tags":"","url":"proc/dump_is_open.html"},{"title":"dump_open – UKCA Box Model","text":"public  subroutine dump_open(filename) Open (replacing) the dump file. Dumping is active until dump_close. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Path to the dump file","tags":"","url":"proc/dump_open.html"},{"title":"dump_open_from_env – UKCA Box Model","text":"public  subroutine dump_open_from_env() Open the dump file named by the environment variable UKCA_DUMP_FILE,\nif it is set and non-empty. Only the first call has any effect, so it\nis cheap to call at the start of every wrapped API routine. Arguments None","tags":"","url":"proc/dump_open_from_env.html"},{"title":"dump_close – UKCA Box Model","text":"public  subroutine dump_close() Close the dump file, if open. Arguments None","tags":"","url":"proc/dump_close.html"},{"title":"dump_section – UKCA Box Model","text":"public  subroutine dump_section(section, step) Set the section label (e.g. \"ukca_step:in\") and timestep used to key\nsubsequent lines. Flushes the file so a crash leaves a usable dump. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: section Section label, e.g. \"ukca_step:in\" integer, intent(in) :: step Time step","tags":"","url":"proc/dump_section.html"},{"title":"dump_marker – UKCA Box Model","text":"public  subroutine dump_marker(name, marker) Write a marker in place of a value, e.g. \" \" for an optional\nargument that was not passed. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable character(len=*), intent(in) :: marker Marker to write in place of the value","tags":"","url":"proc/dump_marker.html"},{"title":"dump – UKCA Box Model","text":"public interface dump Write one variable (any supported type and rank) to the dump file Module Procedures private  subroutine dump_real_0d(name, value) Dump a real scalar. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable real, intent(in) :: value The value to dump private  subroutine dump_real_1d(name, value) Dump a 1D real array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable real, intent(in) :: value (:) The values to dump private  subroutine dump_real_2d(name, value) Dump a 2D real array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable real, intent(in) :: value (:,:) The values to dump private  subroutine dump_real_3d(name, value) Dump a 3D real array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable real, intent(in) :: value (:,:,:) The values to dump private  subroutine dump_real_4d(name, value) Dump a 4D real array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable real, intent(in) :: value (:,:,:,:) The values to dump private  subroutine dump_int_0d(name, value) Dump an integer scalar. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable integer, intent(in) :: value The value to dump private  subroutine dump_int_1d(name, value) Dump a 1D integer array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable integer, intent(in) :: value (:) The values to dump private  subroutine dump_int_2d(name, value) Dump a 2D integer array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable integer, intent(in) :: value (:,:) The values to dump private  subroutine dump_int_3d(name, value) Dump a 3D integer array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable integer, intent(in) :: value (:,:,:) The values to dump private  subroutine dump_logical_0d(name, value) Dump a logical scalar. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable logical, intent(in) :: value The value to dump private  subroutine dump_logical_1d(name, value) Dump a 1D logical array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable logical, intent(in) :: value (:) The values to dump private  subroutine dump_logical_2d(name, value) Dump a 2D logical array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable logical, intent(in) :: value (:,:) The values to dump private  subroutine dump_logical_3d(name, value) Dump a 3D logical array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable logical, intent(in) :: value (:,:,:) The values to dump private  subroutine dump_char_0d(name, value) Dump a character scalar, in double quotes. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable character(len=*), intent(in) :: value The value to dump private  subroutine dump_char_1d(name, value) Dump a 1D character array, each value in double quotes. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable character(len=*), intent(in) :: value (:) The values to dump","tags":"","url":"interface/dump.html"},{"title":"get_tracer_varnames – UKCA Box Model","text":"public  subroutine get_tracer_varnames() Retrieve the list of tracer variable names from the UKCA API and store\nthem in the tracer_varnames pointer. Arguments None","tags":"","url":"proc/get_tracer_varnames.html"},{"title":"create_initial_tracers – UKCA Box Model","text":"public  subroutine create_initial_tracers(tracer_file) Uses box_err_codes_mod box_const_mod Create the initial tracer array from a provided tracer file. The tracer file should contain lines of the form: Where is the name of the tracer variable and is the initial value to set for that tracer. If a line with the\nvariable name is \"DEFAULT\", then will be used as the default\nvalue for any tracer variable not explicitly set in the file. If no\n\"DEFAULT\" line is provided, the default value will be set to 1.0e-10. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: tracer_file The name of the tracer file to read initial values from.","tags":"","url":"proc/create_initial_tracers.html"},{"title":"print_tracer_output – UKCA Box Model","text":"public  subroutine print_tracer_output() Subroutine to print the current tracer values to the log. Arguments None","tags":"","url":"proc/print_tracer_output.html"},{"title":"find_species_index – UKCA Box Model","text":"public  subroutine find_species_index(species_name, species_index, found) Uses box_err_codes_mod Subroutine to find the index of a species in the tracer variable name\narray. Returns the index and a logical indicating if the species was\nfound. If multiple matches are found, an error is reported. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: species_name The name of the species to find. integer, intent(out) :: species_index The index of the species in the tracer variable name array, if found. If\nnot found, this will be set to -1. logical, intent(out) :: found Logical indicating if the species was found in the tracer variable name\narray.","tags":"","url":"proc/find_species_index.html"},{"title":"initialise_output_tracers – UKCA Box Model","text":"public  subroutine initialise_output_tracers(num_timesteps) Subroutine to allocate the output tracer array based on the number of\ntracers and the number of timesteps in the model run. Arguments Type Intent Optional Attributes Name integer, intent(in) :: num_timesteps The number of timesteps in the model run.","tags":"","url":"proc/initialise_output_tracers.html"},{"title":"add_tracers_to_output – UKCA Box Model","text":"public  subroutine add_tracers_to_output(timestep) Uses box_err_codes_mod Subroutine to add the current tracer values to the output array for a\ngiven timestep. Arguments Type Intent Optional Attributes Name integer, intent(in) :: timestep The timestep for which to add the tracer values to the output array.","tags":"","url":"proc/add_tracers_to_output.html"},{"title":"cleanup_tracers – UKCA Box Model","text":"public  subroutine cleanup_tracers() Subroutine to deallocate the tracer arrays and nullify var name pointer. Arguments None","tags":"","url":"proc/cleanup_tracers.html"},{"title":"return_tracer – UKCA Box Model","text":"public  subroutine return_tracer(tracer_name, tracer) Uses box_err_codes_mod Subroutine to return the value of a tracer variable given its name.\nIf not found the routine will error. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: tracer_name The name of the tracer variable to return. real, intent(out) :: tracer The value of the tracer variable.","tags":"","url":"proc/return_tracer.html"},{"title":"write_tracer_output – UKCA Box Model","text":"public  subroutine write_tracer_output(filename) Uses box_tracer_mod umprintmgr ukca_api_mod box_time_mod ereport_mod box_err_codes_mod Write the tracer output array to a csv file. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename The name of the output file to write the tracer data to.","tags":"","url":"proc/write_tracer_output.html"},{"title":"output_file_path – UKCA Box Model","text":"public  function output_file_path(cfg, filename) result(path) Return the path to write an output file to: the file name inside the\nconfigured output directory. Arguments Type Intent Optional Attributes Name type( box_config_type ), intent(in) :: cfg The box model configuration character(len=*), intent(in) :: filename Name of the output file Return Value character(len=512) Path to write the output file to","tags":"","url":"proc/output_file_path.html"},{"title":"read_box_config – UKCA Box Model","text":"public  subroutine read_box_config(filename, cfg) Uses box_debug_mod ukca_missing_data_mod box_err_codes_mod Reads the box model configuration from a user-provided namelist file and\nstores the configuration in a box_config_type type. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Name of the namelist file to read type( box_config_type ), intent(out) :: cfg The resulting box model configuration read from the namelist file Namelists Namelist general_config Variables Name Type Default Description env_log_step integer None Timestep number at which environment summary diagnostics should be\nprinted to log file i_ageair_reset_method integer None Method for controlling age reset to 0 i_error_method integer None Error handling method to use i_ukca_chem integer None Chemistry scheme to use i_ukca_chem_version integer None Chemical mechanism version identifier max_ageair_reset_level integer None Max. level for reset (Method 1) model_duration integer None model duration (seconds) start_day integer None starting day of model start_hour integer None starting hour of model start_minute integer None starting minute of model start_month integer None starting month of model start_second integer None starting second of model start_year integer None starting year of model l_blankout_invalid_diags logical None True to set all non-valid diagnostic field data to missing data value l_cal360 logical None True if UKCA is expected to use a 360-day calendar for applying a top\nboundary condition in stratospheric chemistry schemes and/or for\nvalidating external emissions. (Emissions registered with a day-of-week\nscaling requirement can't be used with a 360-day calendar). l_chem_environ_co2_fld logical None True if using an external CO2 field in chemistry l_chem_environ_gas_scalars logical None True if using external values for CO2, CH4, O2, H2 and N2 in chemistry l_ctile logical None True if using partial land points at coasts l_environ_rel_humid logical None True if using external fields for relative humidity, clear-sky relative\nhumidity and/or saturation vapour pressure l_fix_ukca_cloud_frac logical None True to fix cloud_frac offset bug l_param_conv logical None True if using precipitation diagnostics from a parameterized convection\nscheme l_timer logical None True to use a timer routine for timing sub-models l_tracer_lumping logical None True to handle lumped tracers in stratospheric chemistry schemes l_ukca_ageair logical None True for age-of-air scheme l_ukca_debug_asad logical None Include additional print output specific to ASAD l_ukca_scale_ppe logical None True to turn on perturbed parameter ensemble (PPE) scaling parameters l_use_gridbox_mass logical None True to use mass of air in grid box in prognostic and/or diagnostic\ncalculations. (Note that GLOMAP-mode prognostics will run with or\nwithout this option giving equivalent but not bit-comparable results.\nThe option is required for the stratospheric chemistry schemes and for\nUM diagnostics.) l_use_gridbox_volume logical None True to use gridbox volume in diagnostic calculations. (This is required\nfor UM diagnostics and to enable use of ASAD framework diagnostics in\nnon-UM applications.) l_zon_av_ozone logical None True if external O3, used for troposphere only schemes, is expected as a\nmean value for each domain row (i.e. zonal mean if lat const. in row) max_ageair_reset_height real None Max. height (m) for reset (Method 2) max_z_for_offline_chem real None Maximum height at which to integrate chemistry with the explicit B-E\nOffline Oxidants scheme timestep real None Model timestep in seconds (an integer no of timesteps is expected in 1\nhour) delta_lambda real None EW (x) grid spacing in radians delta_phi real None NS (y) grid spacing in radians Namelist aerosol Variables Name Type Default Description i_mode_bln_param_method integer None Parameterisation method for boundary layer nucleation 1=activation;\n2=kinetic; 3=organic mediated (as per Metzger et al, PNAS, 2010) -\nrequired when 'l_mode_bhn_on' is true. i_mode_nzts integer None No. of substeps for nucleation/sedimentation i_mode_setup integer None MODE aerosol scheme to use l_bug_repro_tke_index logical None True to reproduce effects of an old bug in the calculation of updraft\npdf spread related to TKE indexing in the Unified Model l_dust_mp_ageing logical None True for dust and microplastics being subjected to nuc scav, conden,\ncoag, ageing, and activation l_dust_mp_slinn_impc_scav logical None True for turning on the Slinn impaction scheme for dust and\nmicroplastics l_fix_nacl_density logical None True to correct sea-salt density l_fix_neg_pvol_wat logical None True to check, trap and fix for negative values in 'pvol' and 'mdwat' l_fix_ukca_activate_pdf logical None True to fix probability density fn. of updraft velocities in Activate l_fix_ukca_activate_vert_rep logical None True to fix CDNC vertical replication bug in Activate l_fix_ukca_hygroscopicities logical None True to update aerosol component hygroscopicities to kappa-Kohler values\nand fix bug in calculation of volume-weighted hygroscopicity value l_fix_ukca_impscav logical None True to fix impaction scavenging bugs l_fix_ukca_water_content logical None True to fix bugs in the calculation of aerosol water content values. l_improve_aero_drydep logical None if True the surface type used by the aerosol dry deposition is provided\nby the parent, rather than being inferred from roughness length in\nGLOMAP. l_mode_bhn_on logical None True for binary homogeneous sulphate nucleation l_mode_bln_on logical None True for boundary layer sulphate nucleation l_ntpreq_dryd_nuc_sol logical None True to include to include the dry diameter for nucleation soluble mode l_ntpreq_n_activ_sum logical None True to include total number concentration of active aerosol in\nnon-transported prognostics (e.g. for combination with an external cloud\nmask for calculating CDNC in the UM hybrid resolution model) l_ukca_mode logical None True for GLOMAP-mode aerosol scheme l_ukca_sfix logical None True for diagnosing UKCA CCN at fixed supersaturation mode_activation_dryr real None Activation dry radius (nm) mode_incld_so2_rfrac real None Fraction of in-cloud oxidised SO2 removed by precipitation sigwmin real None Lower limit for std. dev. of updraft velocity pdf used in Activate\n(default: 0.01 m/s). Namelist chemistry Variables Name Type Default Description dts0 integer None Backward Euler timestep (seconds) i_ukca_hetconfig integer None 0 = default (5 reactions); 1 = JPL-15 recommended coeff. 2 = JPL-15 +\nbromine reactions i_ukca_quasinewton_end integer None Iteration to stop quasi-Newton step (2-50, 3 recommended) i_ukca_quasinewton_start integer None Iteration to start quasi-Newton step (2-50, 2 recommended) i_ukca_topboundary integer None Method of treating top boundary for certain species in stratospheric\nschemes nit integer None Number of iterations for B-E Solver nrsteps integer None No. of N-R solver iterations before time step is halved l_fix_ukca_h2so4_ystore logical None True to fix storage of H2SO4 in ASAD N-R schemes for updating in GLOMAP l_fix_ukca_offox_h2o_fac logical None True to fix water vapour units in B-E Offline Oxidants scheme l_ukca_chem_aero logical None True for aerosol precursor chemistry l_ukca_classic_hetchem logical None Allows the use of heterogeneous chemistry on aerosol surfaces from\nCLASSIC within UKCA. l_ukca_het_psc logical None True for heterogeneous polar stratospheric cloud chemistry l_ukca_intph logical None True for calculating interactive cloud pH values (F for global value of\n5) l_ukca_limit_nat logical None True to limit the formation of NAT in polar stratospheric clouds\n(type 1) to heights above 1 km l_ukca_prescribech4 logical None True if prescribing surface CH4 l_ukca_quasinewton logical None True to use quasi-Newton (Broyden) method to reduce no. of iterations in\nN-R solver step l_ukca_ro2_ntp logical None True to stop transport of peroxy radicals in StratTrop/CRI scheme l_ukca_ro2_perm logical None True for RO2-permutation chemistry in StratTrop/CRI scheme l_ukca_sa_clim logical None True to use surface area density climatology for heterogeneous PSC chem. l_ukca_trophet logical None True for tropospheric het. chemistry l_use_classic_biogenic logical None True to use CLASSIC biogenic secondary organic aerosol for het. chem.\n(RAQ only) l_use_classic_ocff logical None True to use CLASSIC organic carbon from fossil fuels for het. chem.\n(RAQ only) l_use_classic_seasalt logical None True to use CLASSIC sea salt for het. chem. (RAQ only) l_use_classic_so4 logical None True to use CLASSIC SO4 for het. chem. l_use_classic_soot logical None True to use CLASSIC black carbon for het. chem. (RAQ scheme only) ph_fit_coeff_a real None value for fitting coefficient a of the interactive cloud pH code ph_fit_coeff_b real None value for fitting coefficient b of the interactive cloud pH code ph_fit_intercept real None y-intercept value of the relationship for the interactive cloud pH code Namelist constants Variables Name Type Default Description l_skip_const_setup logical None Control argument for skipping set up of constants if already done const_avogadro real None Configurable number of molecules in 1 mole (Avogadro constant) const_boltzmann real None Configurable Boltzmann constant (J K-1) const_lc real None Configurable latent heat of condensation of water at 0 degC (J/kg) const_rho_so4 real None Configurable density of SO4 particle (kg/m3) const_rho_water real None Configurable density of pure water (kg/m3) const_rhosea real None Configurable density of sea water (kg/m3) const_rmol real None Configurable universal gas constant R (J/mol/K) const_tfs real None Configurable temperature at which sea water freezes (K) Namelist deposition Variables Name Type Default Description i_mode_nucscav integer None Choice of nucl. scavenging coefficients: 1=original, 2=ECHAM5-HAM,\n3=as(1) but no scav of modes 6&7 l_aero_rainout logical None True for turning on nucleation scavenging (rainout) l_cv_rainout logical None True for convective rainout in UKCA l_ddepaer logical None True for aerosol dry deposition l_deposition_jules logical None True when using JULES-based interactive dry deposition routines l_fix_drydep_so2_water logical None True to use correct surface resistance of water when calculating dry\ndeposition of SO2 l_fix_improve_drydep logical None True to fix dry deposition velocities l_fix_ukca_h2dd_x logical None True to fix H2 deposition to shrub/soil l_impc_scav logical None True for turning on impaction scavenging l_ukca_ddep_lev1 logical None True to apply dry deposition losses only in level 1 l_ukca_ddepo3_ocean logical None True to use Luhar et al. (2018) oceanic O3 dry-deposition scheme l_ukca_dry_dep_so2wet logical None True if considering the impact of surface wetness on dry deposition l_ukca_drydep_off logical None True to turn off dry deposition l_ukca_intdd logical None True for interactive dry deposition l_ukca_wetdep_off logical None True to turn off wet deposition acc_cor_scav_scaling real None Scaling factor for scavenging parameters for the accumulation and coarse\nmodes dry_depvel_acc_scaling real None Scaling factor for the dry deposition velocity for the accumulation mode dry_depvel_so2_scaling real None SO2 dry deposition velocity scaling factor Namelist emissions Variables Name Type Default Description i_inferno_emi integer None maximum INFERNO emission level i_primss_method integer None Sea-salt emission options i_ukca_dms_flux integer None Sea-air DMS exchange scheme to use i_ukca_light_param integer None Choice for flash-freq parameterisation (1 = Price & Rind, 2 = Luhar et\nal., 3 = external lightning scheme) l_bcoc_bf logical None True for primary biofuel BC/OC emissions l_bcoc_bm logical None True for primary biomass BC/OC emissions l_bcoc_ff logical None True for primary fossil fuel BC/OC emissions l_no3_prod_in_aero_step logical None True for nitrate emissions in MODE l_support_ems_gridbox_units logical None True to support the provision of offline emissions in grid-box units l_support_ems_vertprof logical None True to support full range of vertical scaling options for 2D emission\nfields. l_suppress_ems logical None True to suppress all tracer updates from emissions and boundary layer\nmixing (Emissions diagnostics are unaffected) l_ukca_coarse_no3_prod logical None True for coarse mode NO3 emissions l_ukca_emsdrvn_ch4 logical None True when running UKCA in CH4 emissions-driven mode l_ukca_fine_no3_prod logical None True for fine mode NO3/NH4 emissions l_ukca_ibvoc logical None True for interactive bVOC emissions l_ukca_inferno logical None True for INFERNO fire emissions l_ukca_inferno_ch4 logical None True for INFERNO CH4 fire emissions l_ukca_linox_scaling logical None True to use LOG(p) to distribute lightning NOx in the vertical l_ukca_mp_fibre logical None True for microplastic fibre emissions l_ukca_mp_fragment logical None True for microplastic fragment emissions l_ukca_prim_moc logical None True for primary marine OC aerosol emissions l_ukca_primbcoc logical None True for primary BC/OC emissions l_ukca_primdu logical None True for primary dust emissions l_ukca_primss logical None True for primary sea-salt emissions l_ukca_primsu logical None True for primary sulphate emissions l_ukca_qch4inter logical None True for interactive wetland CH4 emissions l_ukca_scale_biom_aer_ems logical None True to apply scaling factor to biomass burning BC/OC aerosol emissions l_ukca_scale_marine_pom_ems logical None True to apply scaling factor to marine particulate organic matter l_ukca_scale_sea_salt_ems logical None True to apply scaling factor to sea salt emissions l_ukca_scale_seadms_ems logical None Apply scaling to marine DMS emissions. l_ukca_scale_soa_yield_isop logical None Apply scaling factor to SOA production from isoprene l_ukca_scale_soa_yield_mt logical None Apply scaling factor to SOA production from monoterpene l_ukca_so2ems_expvolc logical None True for interactive expvolc emissions l_ukca_so2ems_plumeria logical None True for expvolc emissions with plumeria anth_so2_ems_scaling real None Anthropogenic SO2 emissions scaling factor biom_aer_ems_scaling real None Biomass-burning emissions scaling hno3_uptake_coeff real None HNO3 uptake coefficient for nitrate lightnox_scale_fac real None Lightning NOx emissions scaling factor marine_pom_ems_scaling real None Marine POM emission scaling factor mode_parfrac real None Fraction of SO2 emissions as aerosol(%) sea_salt_ems_scaling real None Sea salt emission scaling factor seadms_ems_scaling real None Marine DMS emission scaling factor soa_yield_scaling_isop real None Scaling factor for production of SOA from isoprene soa_yield_scaling_mt real None Scaling factor for production of SOA from monoterpene Namelist feedbacks Variables Name Type Default Description i_ukca_activation_scheme integer None Activation scheme to use i_ukca_nwbins integer None Value of nwbins in Activate (1-20) See Rosalind West paper for details\ndoi:10.5194/acp-14-6369-2014 i_ukca_tune_bc integer None Options for tuning BC absorption via adjusting BC mass density and\nrefractive index mixing approximations l_ukca_conserve_h logical None True to include hydrogen conservation when 'l_ukca_h2o_feedback' is true l_ukca_h2o_feedback logical None True for H2O feedback from chemistry l_ukca_radaer logical None Provide output for calculating direct radiative effects of aerosols\nusing RADAER sigma_updraught_scaling real None Scaling factor for standard deviation of updraught velocities Namelist landsurface Variables Name Type Default Description ntype integer None Number of surface types considered in interactive dry deposition dzsoil_layer1 real None Thickness of surface soil layer (m) Namelist IO Variables Name Type Default Description environment_data_file character(len=256) None path to environment namelist file initial_tracer_file character(len=256) None path to initial tracer file initial_ntp_file character(len=256) None path to initial non-transported prognostics (NTP) file offline_photol_rates_file character(len=256) None path to offline photolysis rates file output_dir character(len=256) None directory for output files, relative to the working directory (empty\nmeans the working directory) Namelist photolysis Variables Name Type Default Description fastjx_mode integer None fast-jx photolysis mode above cutoff (1=lookup tables, 2=fast-jx +\nlookup tables, 3=fast-jx) fastjx_numwl integer None number of wavelengths to use in fast-jx. Options are 8, 12 or 18 i_photol_scheme integer None Photolysis scheme: 0 = off, 1 = stratospheric only, 2 = offline/2-D,\n3 = Fast-JX i_solcylc_type integer None apply solar variability to photolysis (fast-jx only). 0 = no solar\ncycle, 1 = observed cycle, 2 = average cycle. solcylc_start_year integer None 1st year for the solar cycle (used when i_solcylc_type = 1) l_cloud_pc2 logical None True if the atmosphere model is using the PC2 cloud scheme l_strat_chem logical None True if UKCA is using a scheme that involves stratospheric chemistry\ni.e. Std Strat, Strattrop or CRI-strat l_use_photolysis logical None True if UKCA is expecting to apply Photolysis rates in the solver and\nhence needs the rates from the parent fastjx_prescutoff real None Cut-off Pressure for tabulated photolysis l_offline_photol logical None True to read photolysis rates from offline_photol_rates_file, rather\nthan calculating them online","tags":"","url":"proc/read_box_config.html"},{"title":"print_box_config – UKCA Box Model","text":"public  subroutine print_box_config(cfg) Print the box model configuration to the log, grouped by namelist\nsection. Arguments Type Intent Optional Attributes Name type( box_config_type ), intent(in) :: cfg The box model configuration to print","tags":"","url":"proc/print_box_config.html"},{"title":"box_shell – UKCA Box Model","text":"public  subroutine box_shell(namelist_path) Uses box_config_mod box_tracer_mod box_config_validator_mod box_photol_mod ukca_internal_dump_mod ukca_api_mod box_environment_mod box_jules_mod box_ntp_mod box_debug_mod box_time_mod box_io_mod box_internal_ukca_config_mod Run the box model: read the box config namelist and the input files it\nnames, set up UKCA and photolysis, then step UKCA through the model\nduration and write the tracer output. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: namelist_path Path to the box config namelist, which names the other input files","tags":"","url":"proc/box_shell.html"},{"title":"setup_internal_ukca_config – UKCA Box Model","text":"public  subroutine setup_internal_ukca_config(cfg) Uses box_config_mod box_const_mod ukca_api_mod box_jules_mod photol_api_mod ereport_mod Set up UKCA's internal configuration by calling ukca_setup with the box\nconfig, the box model's fixed settings (box_const_mod) and the JULES\nsurface type indices. setup_jules must be called first. Arguments Type Intent Optional Attributes Name type( box_config_type ), intent(in) :: cfg The box model configuration","tags":"","url":"proc/setup_internal_ukca_config.html"},{"title":"read_internal_ukca_config – UKCA Box Model","text":"public  subroutine read_internal_ukca_config() Uses ukca_api_mod ereport_mod Get the ukca internal options needed by the box model. Must be called\nafter ukca_setup() has been called. Arguments None","tags":"","url":"proc/read_internal_ukca_config.html"},{"title":"fastjx_inphot – UKCA Box Model","text":"public  subroutine fastjx_inphot() Arguments None","tags":"","url":"proc/fastjx_inphot.html"},{"title":"validate_config – UKCA Box Model","text":"public  subroutine validate_config(cfg) Uses box_config_mod Validate the inputted configuration Arguments Type Intent Optional Attributes Name type( box_config_type ), intent(in) :: cfg The configuration to validate","tags":"","url":"proc/validate_config.html"},{"title":"create_box_environment_type – UKCA Box Model","text":"public  subroutine create_box_environment_type(env) Allocate the arrays in a box environment and set every field to its\nmissing data value. The environment is passed in so that its\ndeferred-shape arrays can be allocated. Arguments Type Intent Optional Attributes Name type( box_environment_type ), intent(out) :: env The box environment to allocate and initialise","tags":"","url":"proc/create_box_environment_type.html"},{"title":"read_box_environment_nml – UKCA Box Model","text":"public  subroutine read_box_environment_nml(filename, env) Uses box_debug_mod box_err_codes_mod Read in the box environment namelist and store the values in the box\nenvironment type. This is used to read in the environmental fields for\nthe box model. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Path to the environment namelist file type( box_environment_type ), intent(inout) :: env environment type to store the environment Namelists Namelist core_environment Variables Name Type Default Description z_top_of_model real None real scalar environment fields latitude real None real 2D environment fields longitude real None real 2D environment fields tstar real None real 2D environment fields zbl real None real 2D environment fields rough_length real None real 2D environment fields seaice_frac real None real 2D environment fields pstar real None real 2D environment fields u_s real None real 2D environment fields conv_cloud_base integer None integer 2D environment fields conv_cloud_top integer None integer 2D environment fields land_sea_mask logical None logical 2D environment fields q real None real 3D environment fields qcf real None real 3D environment fields rho_r2 real None real 3D environment fields qcl real None real 3D environment fields cloud_frac real None real 3D environment fields p_layer_boundaries real None real 3D environment fields p_theta_levels real None real 3D environment fields t_theta_levels real None real 3D environment fields ls_rain3d real None real 3D environment fields ls_snow3d real None real 3D environment fields pv_on_theta_mlevs real None real 3D environment fields conv_rain3d real None real 3D environment fields conv_snow3d real None real 3D environment fields co2_interactive real None real 3D environment fields grid_volume real None real 3D environment fields grid_airmass real None real 3D environment fields rel_humid_frac real None real 3D environment fields rel_humid_frac_clr real None real 3D environment fields qsvp real None real 3D environment fields Namelist photolysis_environment Variables Name Type Default Description sin_declination real None real scalar environment fields equation_of_time real None real scalar environment fields conv_cloud_lwp real None real 2D environment fields surf_albedo real None real 2D environment fields conv_cloud_amount real None real 3D environment fields area_cloud_fraction real None real 3D environment fields aod_sulph_accum real None real 3D environment fields aod_sulph_aitk real None real 3D environment fields Namelist prescribed_conc_environment Variables Name Type Default Description atmospheric_ch4 real None real scalar environment fields atmospheric_co2 real None real scalar environment fields atmospheric_h2 real None real scalar environment fields atmospheric_n2 real None real scalar environment fields atmospheric_o2 real None real scalar environment fields atmospheric_n2o real None real scalar environment fields atmospheric_cfc11 real None real scalar environment fields atmospheric_cfc12 real None real scalar environment fields atmospheric_cfc113 real None real scalar environment fields atmospheric_hcfc22 real None real scalar environment fields atmospheric_hfc125 real None real scalar environment fields atmospheric_hfc134a real None real scalar environment fields atmospheric_mebr real None real scalar environment fields atmospheric_mecl real None real scalar environment fields atmospheric_ch2br2 real None real scalar environment fields atmospheric_chbr3 real None real scalar environment fields atmospheric_cfc114 real None real scalar environment fields atmospheric_cfc115 real None real scalar environment fields atmospheric_ccl4 real None real scalar environment fields atmospheric_meccl3 real None real scalar environment fields atmospheric_hcfc141b real None real scalar environment fields atmospheric_hcfc142b real None real scalar environment fields atmospheric_h1211 real None real scalar environment fields atmospheric_h1202 real None real scalar environment fields atmospheric_h1301 real None real scalar environment fields atmospheric_h2402 real None real scalar environment fields atmospheric_cos real None real scalar environment fields Namelist deposition_environment Variables Name Type Default Description soil_moisture_layer1 real None real 1D environment fields fland real None real 1D environment fields frac_types real None real 2D environment fields laift_lp real None real 2D environment fields canhtft_lp real None real 2D environment fields tstar_tile real None real 2D environment fields z0tile_lp real None real 2D environment fields surf_hf real None real 2D environment fields surf_wetness real None real 2D environment fields l_tile_active logical None logical 2D environment fields stcon real None real 3D environment fields Namelist emissions_environment Variables Name Type Default Description ibvoc_isoprene real None real 1D environment fields ibvoc_terpene real None real 1D environment fields ibvoc_methanol real None real 1D environment fields ibvoc_acetone real None real 1D environment fields inferno_bc real None real 1D environment fields inferno_ch4 real None real 1D environment fields inferno_co real None real 1D environment fields inferno_nox real None real 1D environment fields inferno_oc real None real 1D environment fields inferno_so2 real None real 1D environment fields inferno_c2h4 real None real 1D environment fields inferno_c2h6 real None real 1D environment fields inferno_c3h8 real None real 1D environment fields inferno_hcho real None real 1D environment fields inferno_mecho real None real 1D environment fields inferno_nh3 real None real 1D environment fields inferno_dms real None real 1D environment fields zhsc real None real 2D environment fields u_scalar_10m real None real 2D environment fields ch4_wetl_emiss real None real 2D environment fields dms_sea_conc real None real 2D environment fields chloro_sea real None real 2D environment fields dust_flux_div1 real None real 2D environment fields dust_flux_div2 real None real 2D environment fields dust_flux_div3 real None real 2D environment fields dust_flux_div4 real None real 2D environment fields dust_flux_div5 real None real 2D environment fields dust_flux_div6 real None real 2D environment fields grid_surf_area real None real 2D environment fields ext_cg_flash real None real 2D environment fields ext_ic_flash real None real 2D environment fields kent integer None integer 2D environment fields kent_dsc integer None integer 2D environment fields u_rho_levels real None real 3D environment fields v_rho_levels real None real 3D environment fields geopH_on_theta_mlevs real None real 3D environment fields rhokh_rdz real None real 3D environment fields dtrdz real None real 3D environment fields we_lim real None real 3D environment fields t_frac real None real 3D environment fields zrzi real None real 3D environment fields we_lim_dsc real None real 3D environment fields t_frac_dsc real None real 3D environment fields zrzi_dsc real None real 3D environment fields dust_div1 real None real 3D environment fields dust_div2 real None real 3D environment fields dust_div3 real None real 3D environment fields dust_div4 real None real 3D environment fields dust_div5 real None real 3D environment fields dust_div6 real None real 3D environment fields interf_z real None real 3D environment fields grid_area_fullht real None real 3D environment fields Namelist aerosol_environment Variables Name Type Default Description lscat_zhang integer None integer 2D environment fields cloud_liq_frac real None real 3D environment fields autoconv real None real 3D environment fields accretion real None real 3D environment fields so4_sa_clim real None real 3D environment fields so4_aitken real None real 3D environment fields so4_accum real None real 3D environment fields soot_fresh real None real 3D environment fields soot_aged real None real 3D environment fields ocff_fresh real None real 3D environment fields ocff_aged real None real 3D environment fields biogenic real None real 3D environment fields sea_salt_film real None real 3D environment fields sea_salt_jet real None real 3D environment fields rim_cry real None real 3D environment fields rim_agg real None real 3D environment fields vertvel real None real 3D environment fields bl_tke real None real 3D environment fields Namelist offlinechem_environment Variables Name Type Default Description h2o2_offline real None real 3D environment fields ho2_offline real None real 3D environment fields no3_offline real None real 3D environment fields o3_offline real None real 3D environment fields oh_offline real None real 3D environment fields","tags":"","url":"proc/read_box_environment_nml.html"},{"title":"print_box_environment – UKCA Box Model","text":"public  subroutine print_box_environment(env) Uses box_debug_mod Print the box environment to the console. This is used for logging and\ndebugging purposes. Fields are categorised by where they are used in the\ncode, e.g. photolysis environment section will be fields used primarily\nby the photolysis code. Arguments Type Intent Optional Attributes Name type( box_environment_type ), intent(in) :: env The box environment to print","tags":"","url":"proc/print_box_environment.html"},{"title":"print_ukca_environment – UKCA Box Model","text":"public  subroutine print_ukca_environment() Uses ukca_api_mod box_err_codes_mod ukca_environment_fields_mod Print the environment fields UKCA requires, as held inside UKCA, and\nwarn about any required field that has not been set. Arguments None","tags":"","url":"proc/print_ukca_environment.html"},{"title":"set_box_environment – UKCA Box Model","text":"public  subroutine set_box_environment(env) Uses ukca_api_mod box_debug_mod Set the internal ukca environment using the box environment data\nstructure. The internal ukca environment will be what the ukca model\nuses when solving chemistry. Arguments Type Intent Optional Attributes Name type( box_environment_type ), intent(in) :: env the box environment, containing both fields from the input namelist\nand derived fields.","tags":"","url":"proc/set_box_environment.html"},{"title":"derive_env_variables – UKCA Box Model","text":"public  subroutine derive_env_variables(env) Uses box_err_codes_mod box_const_mod box_debug_mod Derive environment variables from the input box environment fields, and\nstore the results in the same environment type. Example derived field: altitude is derived from the surface pressure and\na theta level pressure, using the hypsometric equation. Arguments Type Intent Optional Attributes Name type( box_environment_type ), intent(inout) :: env the box model environment from which fields will be derived and set in","tags":"","url":"proc/derive_env_variables.html"},{"title":"update_env_from_tracers – UKCA Box Model","text":"public  subroutine update_env_from_tracers(env_entry, tracer_ukca, tracer_name) Uses box_tracer_mod box_err_codes_mod Subroutine for updating a box environment entry with the\na current value from the tracer array. Arguments Type Intent Optional Attributes Name real, intent(inout) :: env_entry (:,:,:) The box environment field to update real, intent(in) :: tracer_ukca (:,:,:,:) The UKCA tracer array character(len=*), intent(in) :: tracer_name Name of the tracer to copy into the environment field","tags":"","url":"proc/update_env_from_tracers.html"},{"title":"update_tracer_from_env – UKCA Box Model","text":"public  subroutine update_tracer_from_env(tracer_ukca, env_entry, tracer_name) Uses box_tracer_mod Copy a box environment entry into the matching tracer, so that the\nenvironment stays the master copy of that field (e.g. q into H2O, as\nthe UM does). Does nothing if the species is not a tracer in this\nchemistry scheme. Arguments Type Intent Optional Attributes Name real, intent(inout) :: tracer_ukca (:,:,:,:) The UKCA tracer array real, intent(in) :: env_entry (:,:,:) The box environment entry to copy into the tracer character(len=*), intent(in) :: tracer_name Name of the tracer to update","tags":"","url":"proc/update_tracer_from_env.html"},{"title":"print_field – UKCA Box Model","text":"public interface print_field Module Procedures private  subroutine print_field_real(label, value, fmt) Print a labelled real value, with missing data shown as NaN Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: label The label to print before the value real, intent(in) :: value The value to print character(len=*), intent(in) :: fmt The format to print the label and value with private  subroutine print_field_int(label, value, fmt) Print a labelled integer value, with missing data shown as NaN Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: label The label to print before the value integer, intent(in) :: value The value to print character(len=*), intent(in) :: fmt The format to print the label and value with private  subroutine print_field_logical(label, value, fmt) Print a labelled logical value Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: label The label to print before the value logical, intent(in) :: value The value to print character(len=*), intent(in) :: fmt The format to print the label and value with","tags":"","url":"interface/print_field~2.html"},{"title":"next_argument – UKCA Box Model","text":"subroutine next_argument(i, value) Advance past an option and read its value, stopping with an error if\nthe option is the last argument. Arguments Type Intent Optional Attributes Name integer, intent(inout) :: i Index of the option; on return, the index of its value character(len=256), intent(out) :: value The option's value","tags":"","url":"proc/next_argument.html"},{"title":"report_usage_error – UKCA Box Model","text":"subroutine report_usage_error(message) Print the command line usage, then stop with an error. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: message The error message","tags":"","url":"proc/report_usage_error.html"},{"title":"print_usage – UKCA Box Model","text":"subroutine print_usage() Print the command line usage. Arguments None","tags":"","url":"proc/print_usage.html"},{"title":"box_photol_setup – UKCA Box Model","text":"public  subroutine box_photol_setup(cfg) Uses box_socrates_mod ukca_constants box_const_mod photol_setup_mod Setup up the photolysis module for the box model. This includes setting\nup the photolysis rates array, reading in the photolysis reaction data\nand setting up the photolysis scheme. Arguments Type Intent Optional Attributes Name type( box_config_type ), intent(in) :: cfg Box model configuration","tags":"","url":"proc/box_photol_setup.html"},{"title":"get_photol_reaction_data – UKCA Box Model","text":"public  subroutine get_photol_reaction_data() Uses ukca_api_mod Get the photolysis reaction data by calling the UKCA API to retrieve\nthe photolysis reaction data and variable names. Print the output if\ndebug level is on. Arguments None","tags":"","url":"proc/get_photol_reaction_data.html"},{"title":"update_solar_pos – UKCA Box Model","text":"public  subroutine update_solar_pos(env) Uses box_environment_mod box_time_mod Update the solar position in the box model environment based upon the\ncurrent time and date. Arguments Type Intent Optional Attributes Name type( box_environment_type ), intent(inout) :: env The box model environment to update with the new solar position","tags":"","url":"proc/update_solar_pos.html"},{"title":"photol_get_rates – UKCA Box Model","text":"public  subroutine photol_get_rates(cfg, env) Uses box_config_mod box_environment_mod Process the photolysis rates, beginning with setup and moving onto\neither calculate the rates in an offline or online manner depending on\ncfg%l_offline_photol Arguments Type Intent Optional Attributes Name type( box_config_type ), intent(in) :: cfg the input box model configuration type( box_environment_type ), intent(inout) :: env the input box model environment, photolysis rates are stored in","tags":"","url":"proc/photol_get_rates.html"},{"title":"ukca_dump_on – UKCA Box Model","text":"public  function ukca_dump_on() result(is_on) True if dumping is switched on, i.e. UKCA_DUMP_FILE is set. The dump\nfile is opened on the first call. Arguments None Return Value logical","tags":"","url":"proc/ukca_dump_on.html"},{"title":"dump_ukca_internal_config – UKCA Box Model","text":"public  subroutine dump_ukca_internal_config() Dump the internal UKCA config. Call once, after ukca_setup and\nphotol_setup. Labelled step 0. Arguments None","tags":"","url":"proc/dump_ukca_internal_config.html"},{"title":"dump_ukca_step_in – UKCA Box Model","text":"public interface dump_ukca_step_in Module Procedures private  subroutine dump_ukca_step_in_1d_domain(timestep_number, current_time, tracer_data, ntp_data, r_theta_levels, r_rho_levels, previous_time, eta_theta_levels) Dump the UKCA environment and every input to a ukca_step call (1D\ndomain). Call immediately before ukca_step, with the same arguments\n(excluding the error and diagnostic arguments). Arguments Type Intent Optional Attributes Name integer, intent(in) :: timestep_number integer, intent(in) :: current_time (7) real, intent(in), allocatable :: tracer_data (:,:) real, intent(in), allocatable :: ntp_data (:,:) real, intent(in) :: r_theta_levels (:,:,0:) real, intent(in) :: r_rho_levels (:,:,:) integer, intent(in), optional :: previous_time (7) real, intent(in), optional, allocatable :: eta_theta_levels (:) private  subroutine dump_ukca_step_in_3d_domain(timestep_number, current_time, tracer_data, ntp_data, r_theta_levels, r_rho_levels, previous_time, eta_theta_levels) Dump the UKCA environment and every input to a ukca_step call (3D\ndomain). Call immediately before ukca_step, with the same arguments\n(excluding the error and diagnostic arguments). Arguments Type Intent Optional Attributes Name integer, intent(in) :: timestep_number integer, intent(in) :: current_time (7) real, intent(in), allocatable :: tracer_data (:,:,:,:) real, intent(in), allocatable :: ntp_data (:,:,:,:) real, intent(in) :: r_theta_levels (:,:,0:) real, intent(in) :: r_rho_levels (:,:,:) integer, intent(in), optional :: previous_time (7) real, intent(in), optional, allocatable :: eta_theta_levels (:)","tags":"","url":"interface/dump_ukca_step_in.html"},{"title":"dump_ukca_step_out – UKCA Box Model","text":"public interface dump_ukca_step_out Module Procedures private  subroutine dump_ukca_step_out_1d_domain(tracer_data, ntp_data) Dump the tracers returned by a ukca_step call (1D domain). Call\nimmediately after ukca_step. Arguments Type Intent Optional Attributes Name real, intent(in), allocatable :: tracer_data (:,:) real, intent(in), allocatable :: ntp_data (:,:) private  subroutine dump_ukca_step_out_3d_domain(tracer_data, ntp_data) Dump the tracers returned by a ukca_step call (3D domain). Call\nimmediately after ukca_step. Arguments Type Intent Optional Attributes Name real, intent(in), allocatable :: tracer_data (:,:,:,:) real, intent(in), allocatable :: ntp_data (:,:,:,:)","tags":"","url":"interface/dump_ukca_step_out.html"},{"title":"ereport_mod – UKCA Box Model","text":"Module for error reporting in the UKCA box model. Used preferentially\nover the legacy ereport_mod.F90 module, so that it stops the model with\na non-zero exit code if an error has occurred. Public subroutine for error reporting. Subroutines public  subroutine ereport (routine_name, error_status, message) Report errors, warnings, and info messages in the UKCA box model. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: routine_name The name of the routine where the error occurred. integer, intent(inout) :: error_status The error status code. Positive for errors, negative for warnings, and\nzero for info messages. This will be reset to zero after reporting. character(len=*), intent(in) :: message The message to be reported.","tags":"","url":"module/ereport_mod.html"},{"title":"box_time_mod – UKCA Box Model","text":"Module for managing the time in the UKCA box model. Uses ukca_api_mod box_err_codes_mod umprintmgr ereport_mod Variables Type Visibility Attributes Name Initial integer, protected :: model_duration Model duration (seconds) integer, protected :: n_steps Total number of time steps integer, protected :: time_step The duration of a time step in seconds of the model integer, protected :: current_step Index of the current time step (starts at 1) integer, protected :: current_time Elapsed model time (seconds) logical, protected :: l_cal360 Logical to determine if the model is using a 360-day calendar type( box_date_time ), protected :: initial_date_time Model initial date and time type( box_date_time ), protected :: current_date_time Model current date and time type( box_date_time ), protected :: previous_date_time Previous date and time Derived Types type, public :: box_date_time Type for storing date and time information Components Type Visibility Attributes Name Initial integer, public :: year Year integer, public :: month Month integer, public :: day Day integer, public :: hour Hour integer, public :: minute Minute integer, public :: second Seconds Functions public  function day_time_list_format (date_time) result(day_time_list) Format a box_date_time object into a list of integers representing:\n- [year, month, day, hour, minute, second and day of year] Arguments Type Intent Optional Attributes Name type( box_date_time ), intent(in) :: date_time The input date and time object Return Value integer, (7) The output list of integers Subroutines public  subroutine box_time_initialise (time_step_nml, model_duration_nml, start_year, start_month, start_day, start_hour, start_minute, start_second, l_360) Initialize the time manager with the time step, model duration and the\nmodel start date and time from the configuration namelist. Current time\nand step are set to 0. Arguments Type Intent Optional Attributes Name integer, intent(in) :: time_step_nml Time step from configuration namelist (seconds) integer, intent(in) :: model_duration_nml Model duration from configuration namelist (seconds) integer, intent(in) :: start_year Model start year integer, intent(in) :: start_month Model start month integer, intent(in) :: start_day Model start day integer, intent(in) :: start_hour Model start hour integer, intent(in) :: start_minute Model start minute integer, intent(in) :: start_second Model start second logical, intent(in) :: l_360 Logical indicating if the model is using a 360-day calendar public  subroutine print_date_time (date_time) Print the current model date and time in a human-readable format. Arguments Type Intent Optional Attributes Name type( box_date_time ), intent(in) :: date_time Date and time info to print public  subroutine box_time_advance (step_num) Advance the model time by the current time step and increment the index.\nIf all time steps have been completed, an error is reported as this\nshould not occur. Arguments Type Intent Optional Attributes Name integer, intent(in) :: step_num The step number to advance to (should be current_step + 1) public  subroutine get_time_midpoint (time, timestep, midpoint) Get the midpoint between two time steps. Arguments Type Intent Optional Attributes Name type( box_date_time ), intent(in) :: time The input date and time object integer, intent(in) :: timestep The time step size (seconds) type( box_date_time ), intent(out) :: midpoint The output midpoint date and time object","tags":"","url":"module/box_time_mod.html"},{"title":"box_jules_mod – UKCA Box Model","text":"Module for storing constants for the UKCA box model that are stored in\nthe Jules model for the operational runs. To reduce the number of\ndependencies on Jules, we store the constants here in the box model\nand set them to the same values as in Jules. Note the values of each constant are dependent on the number of land types\n(ntype), which is a configuration option set by the user. setup_jules()\nmust therefore be called. Uses ukca_missing_data_mod Variables Type Visibility Attributes Name Initial integer, protected :: ntype = imdi number of land types integer, public, parameter :: n_elev_ice = 10 No. of elevated ice types in the 27 surface type configuration integer, protected, dimension(:), allocatable :: i_elev_ice Array of indices for the elevated ice types in the 27 surface type\nconfiguration integer, protected :: npft = imdi Number of plant functional types considered in interactive dry deposition integer, protected :: nnvg = imdi Number of non-vegetation surface types integer, protected :: i_brd_leaf = imdi Index of surface type 'broad-leaf tree' integer, protected :: i_brd_leaf_dec = imdi Index of surface type 'broad-leaf dec tree' integer, protected :: i_brd_leaf_eg_trop = imdi Index of surface type 'broad-leaf eg trop tree' integer, protected :: i_brd_leaf_eg_temp = imdi Index of surface type 'broad-leaf eg temp tree' integer, protected :: i_ndl_leaf = imdi Index of surface type 'needle-leaf tree' integer, protected :: i_ndl_leaf_dec = imdi Index of surface type 'needle-leaf dec tree' integer, protected :: i_ndl_leaf_eg = imdi Index of surface type 'needle-leaf eg tree' integer, protected :: i_c3_grass = imdi Index of surface type 'c3 grass' integer, protected :: i_c3_crop = imdi Index of surface type 'c3 crop' integer, protected :: i_c3_pasture = imdi Index of surface type 'c3 pasture' integer, protected :: i_c4_grass = imdi Index of surface type 'c4 grass' integer, protected :: i_c4_crop = imdi Index of surface type 'c4 crop' integer, protected :: i_c4_pasture = imdi Index of surface type 'c4 pasture' integer, protected :: i_shrub = imdi Index of surface type 'shrub' integer, protected :: i_shrub_dec = imdi Index of surface type 'shrub dec' integer, protected :: i_shrub_eg = imdi Index of surface type 'shrub eg' integer, protected :: i_urban = imdi Index of surface type 'urban' integer, protected :: i_lake = imdi Index of surface type 'lake' integer, protected :: i_soil = imdi Index of surface type 'soil' integer, protected :: i_ice = imdi Index of surface type 'ice' Subroutines public  subroutine setup_jules (ntype_in) Set up the constants related to the Jules model for use by the UKCA box\nmodel. Takes number of land types (ntype) to determine constant values. Arguments Type Intent Optional Attributes Name integer, intent(in) :: ntype_in Number of land types (surface types) for the box model configuration","tags":"","url":"module/box_jules_mod.html"},{"title":"box_err_codes_mod – UKCA Box Model","text":"Module for storing error codes for the UKCA box model. These are used\nfor error reporting and handling within the box model. Variables Type Visibility Attributes Name Initial integer, public, parameter :: box_errcode_io_tracer = 101 Error code for IO issues with writing tracer file integer, public, parameter :: box_errcode_io_ntp = 102 Error code for IO issues with reading NTP file integer, public, parameter :: box_errcode_io_photol_offline = 103 Error code for IO issues with the offline photolysis rates file. integer, public, parameter :: box_errcode_env_namelist = 104 Error code for issues related to the environment namelist integer, public, parameter :: box_errcode_config_namelist = 105 Error code for issues related to the box config namelist integer, public, parameter :: box_errcode_ntp = 201 Error code for generic issues with the NTP array integer, public, parameter :: box_errcode_duplicate_species = 202 Error code for duplicate species in the tracers array integer, public, parameter :: box_errcode_tracer_allocation = 203 Error code for tracer output not allocated integer, public, parameter :: box_errcode_tracer_not_found = 204 Error code for tracer not found in array integer, public, parameter :: box_errcode_duplicate_ntp = 205 Error code for duplicate ntp variable name in ntp array integer, public, parameter :: box_errcode_config_range = 301 Error code for configuration values out of range integer, public, parameter :: box_errcode_not_implemented = 302 Error code for not implemented integer, public, parameter :: box_errcode_command_line = 303 Error code for invalid command line arguments integer, public, parameter :: box_errcode_internal = 401 Error code for generic internal box model issues integer, public, parameter :: box_errcode_invalid_time = 402 Error code for invalid time integer, public, parameter :: box_errcode_env_count = 403 Error code for environment field number mismatch integer, public, parameter :: box_errcode_env_type = 404 Error code for environment field type integer, public, parameter :: box_errcode_env_not_assoc = 405 Error code for environment field not associated integer, public, parameter :: box_errcode_non_phys_calc = 406 Error code for non-physical calculation","tags":"","url":"module/box_err_codes_mod.html"},{"title":"box_debug_mod – UKCA Box Model","text":"A module for managing the debug level of the box model, allowing the user\nto set and query the debug level. The debug level is an integer value that controls the verbosity of the\noutput. Current debug levels: 0 = gives no debug output, 1 = basic debug output, 2 = detailed debug output, 3 = maximum verbosity. Uses ukca_api_mod ereport_mod Functions public  function get_debug_level () result(level) Get the current debug level of the box model. Arguments None Return Value integer The current debug level of the box model. public  function is_debug_level (min_level) result(is_active) Function to check if the current debug level is at least the specified\nminimum level. Arguments Type Intent Optional Attributes Name integer, intent(in) :: min_level The minimum debug level to check against. Return Value logical A logical value indicating whether the current debug level is at least\nthe minimum level. Subroutines public  subroutine set_debug_level (level) Set the debug level for the box model. Higher levels may produce more\nverbose output. level 0 is not debug output. Read more… Arguments Type Intent Optional Attributes Name integer, intent(in) :: level The debug level to set for the box model. Must be between 0 and\nmax_debug_level.","tags":"","url":"module/box_debug_mod.html"},{"title":"box_ntp_mod – UKCA Box Model","text":"Module for handling non-transported prognostic variables (NTPs) in the\nUKCA box model. Uses ukca_api_mod box_debug_mod ereport_mod umprintmgr Variables Type Visibility Attributes Name Initial character(len=ukca_maxlen_fieldname), public, pointer :: ntp_varnames (:) Pointer to an array containing the names of the NTP variable names real, public, allocatable :: ntp_ukca (:,:,:,:) Allocatable array to hold the values of the NTP variables. The dimensions\nare (row_length, rows, model_levels, num_ntps). character(len=*), public, parameter :: mod_name = \"box_ntp_mod\" The module name for error reporting. integer, public :: num_ntps The number of non-transported prognostic variables. Subroutines public  subroutine get_ntp_varnames () Retrieve the list of non-transported prognostic variable names from\nthe UKCA API and store them in the ntp_varnames pointer. Arguments None public  subroutine create_initial_ntp (ntp_file) Create the initial values for the non-transported prognostic (ntp)\narray from a provided file. Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: ntp_file The name of the file containing the values for initial non-transported\nprognostic (ntp) array","tags":"","url":"module/box_ntp_mod.html"},{"title":"setup_namelist – UKCA Box Model","text":"Subroutines public  subroutine setup_nml_type () Arguments None","tags":"","url":"module/setup_namelist.html"},{"title":"box_dump_mod – UKCA Box Model","text":"Write every value passed into, or returned from, the UKCA library to a\nplain-text dump file, one value per line, so that two box models can be\ncompared with diff . Each line is fully keyed and self-contained: <step> <section> <name> <index> <value> e.g. 0 ukca_setup : in i_ukca_chem - 51 3 ukca_step : out tracers ( 1 , 1 , 1 , 2 ) 9.90333269774813254E-008 3 E7A9C ... so dumps can also be compared after sort if the two models make calls\nin a different order. A real value is written twice: with 17 significant\ndigits, which round-trips a double exactly, and as the 16 hex digits of\nits bits. The hex makes the comparison bit-for-bit without relying on how\nthe compiler converts reals to decimal, and shows how many bits differ. This module only depends on Fortran intrinsics and ereport_mod (which\nboth the old and new box models have), so the same file can be compiled\ninto the old (UM/FCM) box model unchanged. Usage: call dump_open(\"ukca_dump.txt\")\ncall dump_section(\"ukca_setup:in\", 0)\ncall dump(\"i_ukca_chem\", i_ukca_chem)\ncall dump(\"tracers\", tracer_ukca)\ncall dump_close() All dump calls are no-ops while no dump file is open. Instead of calling\ndump_open directly, a driver (or wrapper) can call dump_open_from_env,\nwhich opens the file named by the environment variable UKCA_DUMP_FILE,\nif set, so dumping can be switched on without changing driver code. Optional arguments that are not present, and allocatable arguments that\nare not allocated, are recorded with dump_marker as \" \" and\n\" \" so that differences in what is passed are also visible. Uses iso_fortran_env ereport_mod Interfaces public        interface dump Write one variable (any supported type and rank) to the dump file private  subroutine dump_real_0d(name, value) Dump a real scalar. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable real, intent(in) :: value The value to dump private  subroutine dump_real_1d(name, value) Dump a 1D real array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable real, intent(in) :: value (:) The values to dump private  subroutine dump_real_2d(name, value) Dump a 2D real array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable real, intent(in) :: value (:,:) The values to dump private  subroutine dump_real_3d(name, value) Dump a 3D real array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable real, intent(in) :: value (:,:,:) The values to dump private  subroutine dump_real_4d(name, value) Dump a 4D real array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable real, intent(in) :: value (:,:,:,:) The values to dump private  subroutine dump_int_0d(name, value) Dump an integer scalar. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable integer, intent(in) :: value The value to dump private  subroutine dump_int_1d(name, value) Dump a 1D integer array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable integer, intent(in) :: value (:) The values to dump private  subroutine dump_int_2d(name, value) Dump a 2D integer array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable integer, intent(in) :: value (:,:) The values to dump private  subroutine dump_int_3d(name, value) Dump a 3D integer array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable integer, intent(in) :: value (:,:,:) The values to dump private  subroutine dump_logical_0d(name, value) Dump a logical scalar. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable logical, intent(in) :: value The value to dump private  subroutine dump_logical_1d(name, value) Dump a 1D logical array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable logical, intent(in) :: value (:) The values to dump private  subroutine dump_logical_2d(name, value) Dump a 2D logical array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable logical, intent(in) :: value (:,:) The values to dump private  subroutine dump_logical_3d(name, value) Dump a 3D logical array. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable logical, intent(in) :: value (:,:,:) The values to dump private  subroutine dump_char_0d(name, value) Dump a character scalar, in double quotes. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable character(len=*), intent(in) :: value The value to dump private  subroutine dump_char_1d(name, value) Dump a 1D character array, each value in double quotes. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable character(len=*), intent(in) :: value (:) The values to dump Functions public  function dump_is_open () result(is_open) True if a dump file is open, i.e. dump calls will write output. Arguments None Return Value logical Whether a dump file is open Subroutines public  subroutine dump_open (filename) Open (replacing) the dump file. Dumping is active until dump_close. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename Path to the dump file public  subroutine dump_open_from_env () Open the dump file named by the environment variable UKCA_DUMP_FILE,\nif it is set and non-empty. Only the first call has any effect, so it\nis cheap to call at the start of every wrapped API routine. Arguments None public  subroutine dump_close () Close the dump file, if open. Arguments None public  subroutine dump_section (section, step) Set the section label (e.g. \"ukca_step:in\") and timestep used to key\nsubsequent lines. Flushes the file so a crash leaves a usable dump. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: section Section label, e.g. \"ukca_step:in\" integer, intent(in) :: step Time step public  subroutine dump_marker (name, marker) Write a marker in place of a value, e.g. \" \" for an optional\nargument that was not passed. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: name Name of the variable character(len=*), intent(in) :: marker Marker to write in place of the value","tags":"","url":"module/box_dump_mod.html"},{"title":"box_tracer_mod – UKCA Box Model","text":"Module for handling tracer variables in the UKCA box model. Uses ukca_api_mod box_debug_mod ereport_mod umprintmgr Variables Type Visibility Attributes Name Initial character(len=ukca_maxlen_fieldname), protected, pointer :: tracer_varnames (:) Pointer to an array containing the names of the tracer variables. real, public, allocatable :: tracer_ukca (:,:,:,:) Allocatable array to hold the values of the tracer variables. The\ndimensions are (row_length, rows, model_levels, num_tracers). real, protected, allocatable :: output_tracers (:,:) Allocatable array to hold the output values of the tracer variables. The\ndimensions are (num_tracers, num_timesteps). integer, protected :: num_tracers The number of tracer variables. Subroutines public  subroutine get_tracer_varnames () Retrieve the list of tracer variable names from the UKCA API and store\nthem in the tracer_varnames pointer. Arguments None public  subroutine create_initial_tracers (tracer_file) Create the initial tracer array from a provided tracer file. Read more… Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: tracer_file The name of the tracer file to read initial values from. public  subroutine print_tracer_output () Subroutine to print the current tracer values to the log. Arguments None public  subroutine find_species_index (species_name, species_index, found) Subroutine to find the index of a species in the tracer variable name\narray. Returns the index and a logical indicating if the species was\nfound. If multiple matches are found, an error is reported. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: species_name The name of the species to find. integer, intent(out) :: species_index The index of the species in the tracer variable name array, if found. If\nnot found, this will be set to -1. logical, intent(out) :: found Logical indicating if the species was found in the tracer variable name\narray. public  subroutine initialise_output_tracers (num_timesteps) Subroutine to allocate the output tracer array based on the number of\ntracers and the number of timesteps in the model run. Arguments Type Intent Optional Attributes Name integer, intent(in) :: num_timesteps The number of timesteps in the model run. public  subroutine add_tracers_to_output (timestep) Subroutine to add the current tracer values to the output array for a\ngiven timestep. Arguments Type Intent Optional Attributes Name integer, intent(in) :: timestep The timestep for which to add the tracer values to the output array. public  subroutine cleanup_tracers () Subroutine to deallocate the tracer arrays and nullify var name pointer. Arguments None public  subroutine return_tracer (tracer_name, tracer) Subroutine to return the value of a tracer variable given its name.\nIf not found the routine will error. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: tracer_name The name of the tracer variable to return. real, intent(out) :: tracer The value of the tracer variable.","tags":"","url":"module/box_tracer_mod.html"},{"title":"box_const_mod – UKCA Box Model","text":"Module containing constants for the UKCA box model. Uses ukca_api_mod iso_c_binding Variables Type Visibility Attributes Name Initial integer, public, parameter :: row_length = 1 dimension 1 - x integer, public, parameter :: rows = 1 dimension 2 - y integer, public, parameter :: model_levels = 1 dimension 3 - z integer, public, parameter :: bl_levels = 1 No of boundary layer levels integer, public, parameter :: nlev_ent_tr_mix = 3 Number of grid levels for entrainment-related fields used by tr_mix integer, public, parameter :: land_points = 1 Number of land points integer, public, parameter :: n_cca_lev = 0 use in photolysis - Number of CCA levels integer, public, parameter :: fixed_tropopause_level = 1 The level at which to fix the tropopause height in the box model. integer, public, parameter :: ukca_chem_seg_size = 1 Grid points per segment for the column-based chemical solver integer, public, parameter :: ukca_mode_seg_size = 1 Columns per segment for aerosol integer, public, parameter :: nlev_above_trop_o3_env = 2 Number of levels above tropopause at which to start overwriting O3 and\nHNO3 with values derived from O3 data in troposphere only schemes integer, public, parameter :: nlev_ch4_stratloss = 1 Number of top levels at which to apply stratospheric CH4 loss rate in\ntroposphere only schemes logical, public, parameter :: l_fix_tropopause_level = .true. Logical to fix the tropopause level in the box model. logical, public, parameter :: l_enable_diag_um = .false. STASH diagnostics always off in box model logical, public, parameter :: l_ukca_persist_off = .false. If True no saving of horizontal arrays between timesteps logical, public, parameter :: l_ukca_emissions_off = .true. No emissions currently in box model - True to turn off emissions logical, public, parameter :: l_ukca_asad_columns = .true. Box model doesn't pass to um but we set this to true anyway logical, public, parameter :: l_ukca_asad_full = .false. Box model doesn't pass to um but we set this to true anyway logical, public, parameter :: l_ukca_enable_seadms_ems = .true. True to explicitly enable marine DMS emissions - (deprecated redundant\nsetting; if omitted from 'ukca_setup' call DMS emissions are enabled or\ndisabled according to the value of 'i_ukca_dms_flux') real, public, parameter :: const_pi = 3.14159265358979323846 mathematical pi real, public, parameter :: const_pi_over_180 = const_pi/180.0 mathematical pi divided by 180.0 degrees real, public, parameter :: const_recip_pi_over_180 = 180.0/const_pi the reciprocal of mathematical pi divided by 180.0 degrees logical, public, parameter :: l_3d_cca = .false. True if Convective Cloud Amount is calculated as a 3-D field, i.e. loop\nover n_cca_lev, else use only first level from cca array. logical, public, parameter :: l_environ_jo2 = .false. Use O2 + hv -> O(3P) + O(3P) photolysis rate from Socrates logical, public, parameter :: l_environ_jo2b = .false. Use O2 + hv -> O(1D) + O(3P) photolysis rate from Socrates logical, public, parameter :: l_environ_z_top = .false. True if z_top_of_model is being supplied by parent model real, public, parameter :: sclht = 6.8e+03 Mean scale height for pressure real, public, parameter :: earth_r = 287.05 Gas constant for dry air real, public, parameter :: earth_radius = 6371229.0 Earth radius in metres real, public, parameter :: earth_cp = 1005.0 Specific heat of dry air at constant pressure real, public, parameter :: kappa = earth_r/earth_cp Ratio of gas constant to specific heat real, public, parameter :: earth_pref = 100000.0 Reference surface pressure real, public, parameter :: earth_repsilon = 0.62198 repsilon, ratio of molecular weights of water and dry air real, public, parameter :: c_virtual = 1.0/earth_repsilon-1.0 1.0/repsilon-1.0 integer, public, parameter :: i_strat_lbc_source = ukca_strat_lbc_env only ever use strat lbc from env (um scenario) real, public, parameter :: rad_ctl_jo2 (row_length,rows,model_levels) = 0.0 placeholder for JO2 rates from Radiation real, public, parameter :: rad_ctl_jo2b (row_length,rows,model_levels) = 0.0 placeholder for JO2B rates from Radiation real(kind=real64), public, parameter :: rhour_per_day_const = 24.0_real64 hours in a day","tags":"","url":"module/box_const_mod.html"},{"title":"box_io_mod – UKCA Box Model","text":"Module for input/output operations in the UKCA box model. Variables Type Visibility Attributes Name Initial character(len=*), public, parameter :: mod_name = \"box_io_mod\" Module name for error reporting Subroutines public  subroutine write_tracer_output (filename) Write the tracer output array to a csv file. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename The name of the output file to write the tracer data to.","tags":"","url":"module/box_io_mod.html"},{"title":"box_config_mod – UKCA Box Model","text":"Module for reading, validating and printing the box model configuration.\nBox model configurations are read from a user-provided namelist file and\nare stored in a box_config_type type, which is used to control the\nbehaviour of the box model and UKCA. Uses ukca_api_mod umprintmgr ereport_mod Derived Types type, public :: box_config_type All the box model configuration options, read from the box config\nnamelist Components Type Visibility Attributes Name Initial integer, public :: model_duration model duration (seconds) integer, public :: start_year starting year of model integer, public :: start_month starting month of model integer, public :: start_day starting day of model integer, public :: start_hour starting hour of model integer, public :: start_minute starting minute of model integer, public :: start_second starting second of model integer, public :: i_ukca_chem Chemistry scheme to use integer, public :: i_ukca_chem_version Chemical mechanism version identifier integer, public :: nrsteps No. of N-R solver iterations before time step is halved integer, public :: chem_timestep Chemical timestep in seconds for N-R and offline oxidant schemes integer, public :: dts0 Backward Euler timestep (seconds) integer, public :: i_ageair_reset_method Method for controlling age reset to 0 integer, public :: max_ageair_reset_level Max. level for reset (Method 1) integer, public :: i_error_method Error handling method to use integer, public :: nit Number of iterations for B-E Solver integer, public :: i_ukca_quasinewton_start Iteration to start quasi-Newton step (2-50, 2 recommended) integer, public :: i_ukca_quasinewton_end Iteration to stop quasi-Newton step (2-50, 3 recommended) integer, public :: i_ukca_topboundary Method of treating top boundary for certain species in stratospheric\nschemes integer, public :: i_ukca_hetconfig 0 = default (5 reactions); 1 = JPL-15 recommended coeff. 2 = JPL-15 +\nbromine reactions integer, public :: i_inferno_emi maximum INFERNO emission level integer, public :: i_ukca_dms_flux Sea-air DMS exchange scheme to use integer, public :: i_ukca_light_param Choice for flash-freq parameterisation (1 = Price & Rind, 2 = Luhar et\nal., 3 = external lightning scheme) integer, public :: i_photol_scheme Photolysis scheme: 0 = off, 1 = stratospheric only, 2 = offline/2-D,\n3 = Fast-JX integer, public :: env_log_step Timestep number at which environment summary diagnostics should be\nprinted to log file integer, public :: i_ukca_tune_bc Options for tuning BC absorption via adjusting BC mass density and\nrefractive index mixing approximations integer, public :: i_primss_method Sea-salt emission options integer, public :: i_mode_nzts No. of substeps for nucleation/sedimentation integer, public :: i_mode_setup MODE aerosol scheme to use integer, public :: i_mode_bln_param_method Parameterisation method for boundary layer nucleation 1=activation;\n2=kinetic; 3=organic mediated (as per Metzger et al, PNAS, 2010) -\nrequired when 'l_mode_bhn_on' is true. integer, public :: i_mode_nucscav Choice of nucl. scavenging coefficients: 1=original, 2=ECHAM5-HAM,\n3=as(1) but no scav of modes 6&7 integer, public :: i_ukca_activation_scheme Activation scheme to use integer, public :: i_ukca_nwbins Value of nwbins in Activate (1-20) See Rosalind West paper for details\ndoi:10.5194/acp-14-6369-2014 integer, public :: ntype Number of surface types considered in interactive dry deposition integer, public :: fastjx_mode fast-jx photolysis mode above cutoff (1=lookup tables, 2=fast-jx +\nlookup tables, 3=fast-jx) integer, public :: fastjx_numwl number of wavelengths to use in fast-jx. Options are 8, 12 or 18 integer, public :: i_solcylc_type apply solar variability to photolysis (fast-jx only). 0 = no solar\ncycle, 1 = observed cycle, 2 = average cycle. integer, public :: solcylc_start_year 1st year for the solar cycle (used when i_solcylc_type = 1) real, public :: dzsoil_layer1 Thickness of surface soil layer (m) real, public :: timestep Model timestep in seconds (an integer no of timesteps is expected in 1\nhour) real, public :: max_ageair_reset_height Max. height (m) for reset (Method 2) real, public :: max_z_for_offline_chem Maximum height at which to integrate chemistry with the explicit B-E\nOffline Oxidants scheme real, public :: fastjx_prescutoff Cut-off Pressure for tabulated photolysis real, public :: mode_parfrac Fraction of SO2 emissions as aerosol(%) real, public :: seadms_ems_scaling Marine DMS emission scaling factor real, public :: sea_salt_ems_scaling Sea salt emission scaling factor real, public :: marine_pom_ems_scaling Marine POM emission scaling factor real, public :: lightnox_scale_fac Lightning NOx emissions scaling factor real, public :: anth_so2_ems_scaling Anthropogenic SO2 emissions scaling factor real, public :: soa_yield_scaling_mt Scaling factor for production of SOA from monoterpene real, public :: soa_yield_scaling_isop Scaling factor for production of SOA from isoprene real, public :: dry_depvel_so2_scaling SO2 dry deposition velocity scaling factor real, public :: mode_activation_dryr Activation dry radius (nm) real, public :: dry_depvel_acc_scaling Scaling factor for the dry deposition velocity for the accumulation mode real, public :: acc_cor_scav_scaling Scaling factor for scavenging parameters for the accumulation and coarse\nmodes real, public :: mode_incld_so2_rfrac Fraction of in-cloud oxidised SO2 removed by precipitation real, public :: biom_aer_ems_scaling Biomass-burning emissions scaling real, public :: ph_fit_coeff_a value for fitting coefficient a of the interactive cloud pH code real, public :: ph_fit_coeff_b value for fitting coefficient b of the interactive cloud pH code real, public :: ph_fit_intercept y-intercept value of the relationship for the interactive cloud pH code real, public :: sigwmin Lower limit for std. dev. of updraft velocity pdf used in Activate\n(default: 0.01 m/s). real, public :: hno3_uptake_coeff HNO3 uptake coefficient for nitrate real, public :: sigma_updraught_scaling Scaling factor for standard deviation of updraught velocities real, public :: const_rmol Configurable universal gas constant R (J/mol/K) real, public :: const_tfs Configurable temperature at which sea water freezes (K) real, public :: const_rho_water Configurable density of pure water (kg/m3) real, public :: const_rhosea Configurable density of sea water (kg/m3) real, public :: const_lc Configurable latent heat of condensation of water at 0 degC (J/kg) real, public :: const_avogadro Configurable number of molecules in 1 mole (Avogadro constant) real, public :: const_boltzmann Configurable Boltzmann constant (J K-1) real, public :: const_rho_so4 Configurable density of SO4 particle (kg/m3) real, public :: delta_lambda EW (x) grid spacing in radians real, public :: delta_phi NS (y) grid spacing in radians logical, public :: l_cal360 True if UKCA is expected to use a 360-day calendar for applying a top\nboundary condition in stratospheric chemistry schemes and/or for\nvalidating external emissions. (Emissions registered with a day-of-week\nscaling requirement can't be used with a 360-day calendar). logical, public :: l_ukca_chem_aero True for aerosol precursor chemistry logical, public :: l_ukca_mode True for GLOMAP-mode aerosol scheme logical, public :: l_ukca_ageair True for age-of-air scheme logical, public :: l_blankout_invalid_diags True to set all non-valid diagnostic field data to missing data value logical, public :: l_timer True to use a timer routine for timing sub-models logical, public :: l_ukca_scale_ppe True to turn on perturbed parameter ensemble (PPE) scaling parameters logical, public :: l_ukca_drydep_off True to turn off dry deposition logical, public :: l_ukca_wetdep_off True to turn off wet deposition logical, public :: l_ukca_debug_asad Include additional print output specific to ASAD logical, public :: l_ukca_intdd True for interactive dry deposition logical, public :: l_ukca_ddepo3_ocean True to use Luhar et al. (2018) oceanic O3 dry-deposition scheme logical, public :: l_ukca_ddep_lev1 True to apply dry deposition losses only in level 1 logical, public :: l_ukca_dry_dep_so2wet True if considering the impact of surface wetness on dry deposition logical, public :: l_deposition_jules True when using JULES-based interactive dry deposition routines logical, public :: l_ukca_quasinewton True to use quasi-Newton (Broyden) method to reduce no. of iterations in\nN-R solver step logical, public :: l_tracer_lumping True to handle lumped tracers in stratospheric chemistry schemes logical, public :: l_ukca_ro2_ntp True to stop transport of peroxy radicals in StratTrop/CRI scheme logical, public :: l_ukca_ro2_perm True for RO2-permutation chemistry in StratTrop/CRI scheme logical, public :: l_ukca_intph True for calculating interactive cloud pH values (F for global value of\n5) logical, public :: l_ukca_het_psc True for heterogeneous polar stratospheric cloud chemistry logical, public :: l_ukca_limit_nat True to limit the formation of NAT in polar stratospheric clouds\n(type 1) to heights above 1 km logical, public :: l_ukca_sa_clim True to use surface area density climatology for heterogeneous PSC chem. logical, public :: l_ukca_trophet True for tropospheric het. chemistry logical, public :: l_ukca_classic_hetchem Allows the use of heterogeneous chemistry on aerosol surfaces from\nCLASSIC within UKCA. logical, public :: l_use_photolysis True if UKCA is expecting to apply Photolysis rates in the solver and\nhence needs the rates from the parent logical, public :: l_ukca_ibvoc True for interactive bVOC emissions logical, public :: l_ukca_inferno True for INFERNO fire emissions logical, public :: l_ukca_inferno_ch4 True for INFERNO CH4 fire emissions logical, public :: l_ukca_so2ems_expvolc True for interactive expvolc emissions logical, public :: l_ukca_so2ems_plumeria True for expvolc emissions with plumeria logical, public :: l_ukca_qch4inter True for interactive wetland CH4 emissions logical, public :: l_ukca_emsdrvn_ch4 True when running UKCA in CH4 emissions-driven mode logical, public :: l_ukca_scale_seadms_ems Apply scaling to marine DMS emissions. logical, public :: l_ukca_linox_scaling True to use LOG(p) to distribute lightning NOx in the vertical logical, public :: l_ukca_scale_soa_yield_mt Apply scaling factor to SOA production from monoterpene logical, public :: l_ukca_scale_soa_yield_isop Apply scaling factor to SOA production from isoprene logical, public :: l_support_ems_vertprof True to support full range of vertical scaling options for 2D emission\nfields. logical, public :: l_support_ems_gridbox_units True to support the provision of offline emissions in grid-box units logical, public :: l_suppress_ems True to suppress all tracer updates from emissions and boundary layer\nmixing (Emissions diagnostics are unaffected) logical, public :: l_ukca_h2o_feedback True for H2O feedback from chemistry logical, public :: l_param_conv True if using precipitation diagnostics from a parameterized convection\nscheme logical, public :: l_ctile True if using partial land points at coasts logical, public :: l_zon_av_ozone True if external O3, used for troposphere only schemes, is expected as a\nmean value for each domain row (i.e. zonal mean if lat const. in row) logical, public :: l_ukca_conserve_h True to include hydrogen conservation when 'l_ukca_h2o_feedback' is true logical, public :: l_chem_environ_gas_scalars True if using external values for CO2, CH4, O2, H2 and N2 in chemistry logical, public :: l_chem_environ_co2_fld True if using an external CO2 field in chemistry logical, public :: l_ukca_prescribech4 True if prescribing surface CH4 logical, public :: l_use_classic_so4 True to use CLASSIC SO4 for het. chem. logical, public :: l_use_classic_soot True to use CLASSIC black carbon for het. chem. (RAQ scheme only) logical, public :: l_use_classic_ocff True to use CLASSIC organic carbon from fossil fuels for het. chem.\n(RAQ only) logical, public :: l_use_classic_biogenic True to use CLASSIC biogenic secondary organic aerosol for het. chem.\n(RAQ only) logical, public :: l_use_classic_seasalt True to use CLASSIC sea salt for het. chem. (RAQ only) logical, public :: l_use_gridbox_volume True to use gridbox volume in diagnostic calculations. (This is required\nfor UM diagnostics and to enable use of ASAD framework diagnostics in\nnon-UM applications.) logical, public :: l_use_gridbox_mass True to use mass of air in grid box in prognostic and/or diagnostic\ncalculations. (Note that GLOMAP-mode prognostics will run with or\nwithout this option giving equivalent but not bit-comparable results.\nThe option is required for the stratospheric chemistry schemes and for\nUM diagnostics.) logical, public :: l_environ_rel_humid True if using external fields for relative humidity, clear-sky relative\nhumidity and/or saturation vapour pressure logical, public :: l_fix_ukca_cloud_frac True to fix cloud_frac offset bug logical, public :: l_fix_improve_drydep True to fix dry deposition velocities logical, public :: l_fix_drydep_so2_water True to use correct surface resistance of water when calculating dry\ndeposition of SO2 logical, public :: l_fix_ukca_h2dd_x True to fix H2 deposition to shrub/soil logical, public :: l_fix_ukca_offox_h2o_fac True to fix water vapour units in B-E Offline Oxidants scheme logical, public :: l_fix_ukca_h2so4_ystore 