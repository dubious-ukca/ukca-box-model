 ) case ( \"emissions\" ) read ( unit , nml = emissions , iostat = iostat_read , iomsg = iomsg ) case ( \"aerosol\" ) read ( unit , nml = aerosol , iostat = iostat_read , iomsg = iomsg ) case ( \"landsurface\" ) read ( unit , nml = landsurface , iostat = iostat_read , iomsg = iomsg ) case ( \"deposition\" ) read ( unit , nml = deposition , iostat = iostat_read , iomsg = iomsg ) case ( \"constants\" ) read ( unit , nml = constants , iostat = iostat_read , iomsg = iomsg ) case ( \"feedbacks\" ) read ( unit , nml = feedbacks , iostat = iostat_read , iomsg = iomsg ) case ( \"IO\" ) read ( unit , nml = IO , iostat = iostat_read , iomsg = iomsg ) case default err_code = box_errcode_config_namelist write ( err_msg , \"(2A)\" ) \"Unexpected namelist section called: \" , & trim ( nml_names ( i )) call ereport ( routine_name , err_code , err_msg ) endselect ! check if the section was missing and warn or if there was an actual ! read error if ( is_iostat_end ( iostat_read )) then err_code = - box_errcode_config_namelist write ( err_msg , \"(3A)\" ) \"Unable to find a namelist section for \" , & trim ( nml_names ( i )), & \" in the config file. Using default values for its options.\" call ereport ( routine_name , err_code , err_msg ) else if ( iostat_read /= 0 ) then err_code = box_errcode_config_namelist write ( err_msg , \"(4A)\" ) \"Error recorded reading namelist section: \" , & trim ( nml_names ( i )), '. Original error msg: ' , trim ( iomsg ) call ereport ( routine_name , err_code , err_msg ) else if ( is_debug_level ( min_debug_level )) then write ( umMessage , \"(3A)\" ) \"Read namelist '\" , trim ( nml_names ( i )), \"'\" call umPrint ( umMessage , src = routine_name ) endif enddo close ( unit ) ! integer general config parameters cfg % env_log_step = env_log_step cfg % i_ageair_reset_method = i_ageair_reset_method cfg % i_error_method = i_error_method cfg % i_ukca_chem = i_ukca_chem cfg % i_ukca_chem_version = i_ukca_chem_version cfg % max_ageair_reset_level = max_age