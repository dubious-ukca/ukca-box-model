ameters cfg % const_avogadro = const_avogadro cfg % const_boltzmann = const_boltzmann cfg % const_lc = const_lc cfg % const_rho_so4 = const_rho_so4 cfg % const_rho_water = const_rho_water cfg % const_rhosea = const_rhosea cfg % const_rmol = const_rmol cfg % const_tfs = const_tfs ! real deposition config parameters cfg % acc_cor_scav_scaling = acc_cor_scav_scaling cfg % dry_depvel_acc_scaling = dry_depvel_acc_scaling cfg % dry_depvel_so2_scaling = dry_depvel_so2_scaling ! real emissions config parameters cfg % anth_so2_ems_scaling = anth_so2_ems_scaling cfg % biom_aer_ems_scaling = biom_aer_ems_scaling cfg % hno3_uptake_coeff = hno3_uptake_coeff cfg % lightnox_scale_fac = lightnox_scale_fac cfg % marine_pom_ems_scaling = marine_pom_ems_scaling cfg % mode_parfrac = mode_parfrac cfg % sea_salt_ems_scaling = sea_salt_ems_scaling cfg % seadms_ems_scaling = seadms_ems_scaling cfg % soa_yield_scaling_isop = soa_yield_scaling_isop cfg % soa_yield_scaling_mt = soa_yield_scaling_mt ! real feedbacks config parameters cfg % sigma_updraught_scaling = sigma_updraught_scaling ! real landsurface config parameters cfg % dzsoil_layer1 = dzsoil_layer1 ! real photolysis config parameters cfg % fastjx_prescutoff = fastjx_prescutoff ! logical general config parameters cfg % l_blankout_invalid_diags = l_blankout_invalid_diags cfg % l_cal360 = l_cal360 cfg % l_chem_environ_co2_fld = l_chem_environ_co2_fld cfg % l_chem_environ_gas_scalars = l_chem_environ_gas_scalars cfg % l_ctile = l_ctile cfg % l_environ_rel_humid = l_environ_rel_humid cfg % l_fix_ukca_cloud_frac = l_fix_ukca_cloud_frac cfg % l_param_conv = l_param_conv cfg % l_timer = l_timer cfg % l_tracer_lumping = l_tracer_lumping cfg % l_ukca_ageair = l_ukca_ageair cfg % l_ukca_debug_asad = l_ukca_debug_asad cfg % l_ukca_scale_ppe = l_ukca_scale_ppe cfg % l_use_gridbox_mass = l_use_gridbox_mass cfg % l_use_gridbox_volume = l_use_gridbox_volume cfg % l_zon_av_ozone = l_zon_av_ozone ! logical aerosol config parameters cfg % l_bug_repro_tke_index = l_bug_repro_tke_index cfg % l_dust_mp_ageing = l_dust_mp_ageing cfg % l_dust_mp_slinn_impc_scav = l_dust_mp_slinn_impc_scav cfg % l_fix_nacl_density = l_fix_nacl_density cfg % l_fix_neg_pvol_wat = l_fix_neg_pvol_wat cfg % l_fix_ukca_activate_pdf = l_fix_ukca_activate_pdf cfg % l_fix_ukca_activate_vert_rep = l_fix_ukca_activate_vert_rep cfg % l_fix_ukca_hygroscopicities = l_fix_ukca_hygroscopicities cfg % l_fix_ukca_impscav = l_fix_ukca_impscav cfg % l_fix_ukca_water_content = l_fix_ukca_water_content cfg % l_improve_aero_drydep = l_improve_aero_drydep cfg % l_mode_bhn_on = l_mode_bhn_on cfg % l_mode_bln_on = l_mode_bln_on cfg % l_ntpreq_dryd_nuc_sol = l_ntpreq_dryd_nuc_sol cfg % l_ntpreq_n_activ_sum = l_ntpreq_n_activ_sum cfg % l_ukca_mode = l_ukca_mode cfg % l_ukca_sfix = l_ukca_sfix ! logical chemistry config parameters cfg % l_fix_ukca_h2so4_ystore = l_fix_ukca_h2so4_ystore cfg % l_fix_ukca_offox_h2o_fac = l_fix_ukca_offox_h2o_fac cfg % l_ukca_chem_aero = l_ukca_chem_aero cfg % l_ukca_classic_hetchem = l_ukca_classic_hetchem cfg % l_ukca_het_psc = l_ukca_het_psc cfg % l_ukca_intph = l_ukca_intph cfg % l_ukca_limit_nat = l_ukca_limit_nat cfg % l_ukca_prescribech4 = l_ukca_prescribech4 cfg % l_ukca_quasinewton = l_ukca_quasinewton cfg % l_ukca_ro2_ntp = l_ukca_ro2_ntp cfg % l_ukca_ro2_perm = l_ukca_ro2_perm cfg % l_ukca_sa_clim = l_ukca_sa_clim cfg % l_ukca_trophet = l_ukca_trophet cfg % l_use_classic_biogenic = l_use_classic_biogenic cfg % l_use_classic_ocff = l_use_classic_ocff cfg % l_use_classic_seasalt = l_use_classic_seasalt cfg % l_use_classic_so4 = l_use_classic_so4 cfg % l_use_classic_soot = l_use_classic_soot ! logical constants config parameters cfg % l_skip_const_setup = l_skip_const_setup ! logical deposition config parameters cfg % l_aero_rainout = l_aero_rainout cfg % l_cv_rainout = l_cv_rainout cfg % l_ddepaer = l_ddepaer cfg % l_deposition_jules = l_deposition_jules cfg % l_fix_drydep_so2_water = l_fix_drydep_so2_water cfg % l_fix_improve_drydep = l_fix_improve_drydep cfg % l_fix_ukca_h2dd_x = l_fix_ukca_h2dd_x cfg % l_impc_scav = l_impc_scav cfg % l_ukca_ddep_lev1 = l_ukca_ddep_lev1 cfg % l_ukca_ddepo3_ocean = l_ukca_ddepo3_ocean cfg % l_ukca_dry_dep_so2wet = l_ukca_dry_dep_so2wet cfg % l_ukca_drydep_off = l_ukca_drydep_off cfg % l_ukca_intdd = l_ukca_intdd cfg % l_ukca_wetdep_off = l_ukca_wetdep_off ! logical emissions config parameters cfg % l_bcoc_bf = l_bcoc_bf cfg % l_bcoc_bm = l_bcoc_bm cfg % l_bcoc_ff = l_bcoc_ff cfg % l_no3_prod_in_aero_step = l_no3_prod_in_aero_step cfg % l_support_ems_gridbox_units = l_support_ems_gridbox_units cfg % l_support_ems_vertprof = l_support_ems_vertprof cfg % l_suppress_ems = l_suppress_ems cfg % l_ukca_coarse_no3_prod = l_ukca_coarse_no3_prod cfg % l_ukca_emsdrvn_ch4 = l_ukca_emsdrvn_ch4 cfg % l_ukca_fine_no3_prod = l_ukca_fine_no3_prod cfg % l_ukca_ibvoc = l_ukca_ibvoc cfg % l_ukca_inferno = l_ukca_inferno cfg % l_ukca_inferno_ch4 = l_ukca_inferno_ch4 cfg % l_ukca_linox_scaling = l_ukca_linox_scaling cfg % l_ukca_mp_fibre = l_ukca_mp_fibre cfg % l_ukca_mp_fragment = l_ukca_mp_fragment cfg % l_ukca_prim_moc = l_ukca_prim_moc cfg % l_ukca_primbcoc = l_ukca_primbcoc cfg % l_ukca_primdu = l_ukca_primdu cfg % l_ukca_primss = l_ukca_primss cfg % l_ukca_primsu = l_ukca_primsu cfg % l_ukca_qch4inter = l_ukca_qch4inter cfg % l_ukca_scale_biom_aer_ems = l_ukca_scale_biom_aer_ems cfg % l_ukca_scale_marine_pom_ems = l_ukca_scale_marine_pom_ems cfg % l_ukca_scale_sea_salt_ems = l_ukca_scale_sea_salt_ems cfg % l_ukca_scale_seadms_ems = l_ukca_scale_seadms_ems cfg % l_ukca_scale_soa_yield_isop = l_ukca_scale_soa_yield_isop cfg % l_ukca_scale_soa_yield_mt = l_ukca_scale_soa_yield_mt cfg % l_ukca_so2ems_expvolc = l_ukca_so2ems_expvolc cfg % l_ukca_so2ems_plumeria = l_ukca_so2ems_plumeria ! feedbacks logical config parameters cfg % l_ukca_conserve_h = l_ukca_conserve_h cfg % l_ukca_h2o_feedback = l_ukca_h2o_feedback cfg % l_ukca_radaer = l_ukca_radaer ! photolysis logical config parameters cfg % l_cloud_pc2 = l_cloud_pc2 cfg % l_strat_chem = l_strat_chem cfg % l_use_photolysis = l_use_photolysis cfg % l_offline_photol = l_offline_photol ! character IO config parameters ! relative input file paths are relative to the namelist's directory cfg % environment_data_file = resolve_path ( environment_data_file , filename ) cfg % initial_tracer_file = resolve_path ( initial_tracer_file , filename ) cfg % initial_ntp_file = resolve_path ( initial_ntp_file , filename ) cfg % offline_photol_rates_file = & resolve_path ( offline_photol_rates_file , filename ) cfg % output_dir = output_dir ! stop now, rather than part way through setup, if an input is missing call check_input_file ( cfg % environment_data_file , \"environment_data_file\" ) call check_input_file ( cfg % initial_tracer_file , \"initial_tracer_file\" ) call check_input_file ( cfg % initial_ntp_file , \"initial_ntp_file\" ) call check_output_dir ( cfg % output_dir ) ! set the options that are derived from the ones read above call infer_config_options ( cfg ) endsubroutine read_box_config function resolve_path ( path , namelist_file ) result ( resolved ) !! Resolve a file path given in the box config namelist. A relative path !! is taken to be relative to the namelist file's directory, so a config !! folder can be run from any working directory. use box_err_codes_mod , only : box_errcode_config_namelist !> The path as given in the namelist character ( len =* ), intent ( in ) :: path !> Path to the namelist file the path was read from character ( len =* ), intent ( in ) :: namelist_file !> The resolved path character ( len = 256 ) :: resolved !> Position of the last '/' in the namelist file path integer :: i_slash !> Error code for error reporting integer :: err_code !> Message for error reporting character ( len = ukca_maxlen_message ) :: err_msg ! an empty or absolute path, or a namelist in the working directory, needs ! no change resolved = path i_slash = index ( namelist_file , '/' , back = . true .) if ( len_trim ( path ) == 0 . or . i_slash == 0 . or . path ( 1 : 1 ) == '/' ) return if ( i_slash + len_trim ( path ) > len ( resolved )) then write ( err_msg , \"(4A)\" ) \"Path too long after adding the namelist's \" , & \"directory: '\" , namelist_file ( 1 : i_slash ) // trim ( path ), \"'\" err_code = box_errcode_config_namelist call ereport ( mod_name // \":resolve_path\" , err_code , err_msg ) endif resolved = namelist_file ( 1 : i_slash ) // trim ( path ) endfunction resolve_path subroutine check_input_file ( path , option_name ) !! Stop with an error if an input file named in the IO namelist does not !! exist. use box_err_codes_mod , only : box_errcode_config_namelist !> The resolved path to the input file character ( len =* ), intent ( in ) :: path !> Name of the IO namelist option that set the path character ( len =* ), intent ( in ) :: option_name !> Whether the file exists logical :: exists !> Error code for error reporting integer :: err_code !> Message for error reporting character ( len = ukca_maxlen_message ) :: err_msg inquire ( file = trim ( path ), exist = exists ) if (. not . exists ) then write ( err_msg , \"(5A)\" ) \"Input file not found: '\" , trim ( path ), & \"' (set by \" , option_name , \" in the IO namelist)\" err_code = box_errcode_config_namelist call ereport ( mod_name // \":check_input_file\" , err_code , err_msg ) endif endsubroutine check_input_file subroutine check_output_dir ( output_dir ) !! Stop with an error if the output directory set in the IO namelist does !! not exist. An empty output directory means the working directory. use box_err_codes_mod , only : box_errcode_config_namelist !> The output directory character ( len =* ), intent ( in ) :: output_dir !> Whether the directory exists logical :: exists !> Error code for error reporting integer :: err_code !> Message for error reporting character ( len = ukca_maxlen_message ) :: err_msg if ( len_trim ( output_dir ) == 0 ) return ! the trailing '/' makes inquire only match a directory, not a file inquire ( file = trim ( output_dir ) // '/' , exist = exists ) if (. not . exists ) then write ( err_msg , \"(3A)\" ) \"Output directory not found: '\" , & trim ( output_dir ), \"' (set by output_dir in the IO namelist)\" err_code = box_errcode_config_namelist call ereport ( mod_name // \":check_output_dir\" , err_code , err_msg ) endif endsubroutine check_output_dir function output_file_path ( cfg , filename ) result ( path ) !! Return the path to write an output file to: the file name inside the !! configured output directory. !> The box model configuration type ( box_config_type ), intent ( in ) :: cfg !> Name of the output file character ( len =* ), intent ( in ) :: filename !> Path to write the output file to character ( len = 512 ) :: path !> Length of the output directory path integer :: n n = len_trim ( cfg % output_dir ) if ( n == 0 ) then path = filename else if ( cfg % output_dir ( n : n ) == '/' ) then path = cfg % output_dir ( 1 : n ) // filename else path = cfg % output_dir ( 1 : n ) // '/' // filename endif endfunction output_file_path subroutine infer_config_options ( cfg ) !! Infers any configuration options that can be derived from the explicitly !! set parameters - help to reduce the number of config options in the !! namelist !> The box model configuration to add the inferred options to type ( box_config_type ), intent ( inout ) :: cfg ! chem_timestep always equals timestep in box model cfg % chem_timestep = int ( cfg % timestep ) endsubroutine infer_config_options subroutine print_box_config ( cfg ) !! Print the box model configuration to the log, grouped by namelist !! section. !> The box model configuration to print type ( box_config_type ), intent ( in ) :: cfg !> Routine name for logging character ( len =* ), parameter :: routine_name = mod_name // \":print_box_config\" !> Column at which values start, after the option name integer , parameter :: label_width = 45 !> Formats for integer, real, scientific, logical and character values character ( len = 80 ) :: fmt_int , fmt_real , fmt_sci , fmt_log , fmt_char ! Create format strings that start the value at column label_width write ( fmt_int , \"(A, I0, A)\" ) \"(A, T\" , label_width , \", I0)\" write ( fmt_real , \"(A, I0, A)\" ) \"(A, T\" , label_width , \", G0.5)\" write ( fmt_sci , \"(A, I0, A)\" ) \"(A, T\" , label_width , \", ES11.4)\" write ( fmt_log , \"(A, I0, A)\" ) \"(A, T\" , label_width , \", L1)\" write ( fmt_char , \"(A, I0, A)\" ) \"(A, T\" , label_width , \", A)\" call umPrint ( '' , src = routine_name ) call umPrint ( '=' // repeat ( '=' , 78 ) // '=' , src = routine_name ) call umPrint ( '  BOX MODEL CONFIGURATION' , src = routine_name ) call umPrint ( '=' // repeat ( '=' , 78 ) // '=' , src = routine_name ) call umPrint ( '' , src = routine_name ) ! General Configuration call umPrint ( 'General Configuration:' , src = routine_name ) call print_field ( '  chem_timestep (s)' , cfg % chem_timestep , fmt_int ) call print_field ( '  env_log_step' , cfg % env_log_step , fmt_int ) call print_field ( '  i_ageair_reset_method' , & cfg % i_ageair_reset_method , fmt_int ) call print_field ( '  i_error_method' , cfg % i_error_method , fmt_int ) call print_field ( '  i_ukca_chem' , cfg % i_ukca_chem , fmt_int ) call print_field ( '  i_ukca_chem_version' , cfg % i_ukca_chem_version , fmt_int ) call print_field ( '  max_ageair_reset_level' , & cfg % max_ageair_reset_level , fmt_int ) call print_field ( '  model_duration (s)' , cfg % model_duration , fmt_int ) call print_field ( '  start_day' , cfg % start_day , fmt_int ) call print_field ( '  start_hour' , cfg % start_hour , fmt_int ) call print_field ( '  start_minute' , cfg % start_minute , fmt_int ) call print_field ( '  start_month' , cfg % start_month , fmt_int ) call print_field ( '  start_second' , cfg % start_second , fmt_int ) call print_field ( '  start_year' , cfg % start_year , fmt_int ) call print_field ( '  max_ageair_reset_height (m)' , & cfg %