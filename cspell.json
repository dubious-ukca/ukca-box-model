{
  "version": "0.2",
  "language": "en-GB",
  "minWordLength": 4,
  "enableFiletypes": [
    "fortran",
    "FortranFreeForm",
    "FortranFixedForm"
  ],
  "ignorePaths": [
    "ukca/**",
    "build/**",
    "runs/**",
    "doc/**",
    "doc_local/**",
    ".cspell/**",
    "*.csv",
    "src/ukca_internal_dump_mod.F90"
  ],
  "languageSettings": [
    {
      "languageId": "fortran,FortranFreeForm,FortranFixedForm",
      "includeRegExpList": [
        "/!.*/g"
      ],
      "ignoreRegExpList": [
        "/`[^`]*`/g"
      ]
    }
  ],
  "dictionaryDefinitions": [
    {
      "name": "code-words",
      "path": "./.cspell/code-words.txt",
      "description": "Words in Fortran identifiers; generated by tools/gen_cspell_words.py"
    }
  ],
  "dictionaries": [
    "code-words"
  ],
  "words": [
    "autoconversion",
    "Broyden",
    "cylc",
    "dibromomethane",
    "docstrings",
    "ECHAM",
    "Ertel",
    "geopotential",
    "gfortran",
    "hcfc",
    "hydroperoxyl",
    "hygroscopicity",
    "hypsometric",
    "intracloud",
    "Iseconds",
    "Metzer",
    "namelists",
    "nullval",
    "paleo",
    "parameterisation",
    "peroxy",
    "PNAS",
    "riming",
    "Stier",
    "stratiform",
    "substeps",
    "sulfide",
    "sulfur",
    "tribromomethane",
    "UMDP"
  ],
  "ignoreRegExpList": [
    "/(?<![\\w])-[WfIJ][\\w=,.-]*/g"
  ],
  "overrides": [
    {
      "filename": [
        "**/*.F90",
        "**/*.f90"
      ],
      "languageId": "fortran"
    }
  ]
}
